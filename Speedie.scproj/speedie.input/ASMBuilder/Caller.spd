


extend Assembler {


function IsASMConst (|message| exp, |bool|)
	|| fn = exp.func
	if fn == @num
		return true
	if fn == @thg
		return ASMType.ThgSub(self, exp, ASMReg.ConstRequest)


function PrmCollectSpd (|&asmreg| prms,  |SCFunction| fn,  |uint64|)		// paramcollect, paramscollect
	opt norefcounts
	|int64| sh
	|| i = 0
	|| n = fn.args.Length
	while i < n
		|uint64| v = prms[i++].reg
		sh += 5
		rz |= v << sh
	rz |= i


function EncodeParams (|message| prms,  |SCFunction| fn, |bool| Cpp, |&asmreg| Regs,  |uint64|)
	opt norefcounts
	if !Cpp
		rz = .PrmCollectSpd(regs, fn)
		if !prms.AsFunc
			rz |= 16 // mark this as being a function callback
		return rz
	
	|int64| sh = 64
	|| fc = 0
	|| ic = 0
	|| args = fn.args
	|| n = args.Length

	for Floats in 2
		|| i = 0
		for p.fast in prms
			|| ty = p.ASMDecl
			if ty.SpecialReg|int| == floats
				|uint64| v = regs[i].reg
				sh -= 5
				rz  |=  v << sh
				ic += !floats
				fc += floats
			i++
	
	rz >>= 64-((n*5)+12)
	if fc
		rz |= (8-fc) << 6
		rz |= (8-ic) << 0
	  else
		rz |= (17-ic) << 6

	|| kReturnFloat = 1|uint64| << ((n*5)+12)			// uint64 cos C++ sucks
	if rz & ~(kReturnFloat-1) // oof?
	if fn.ASMReturn.SpecialReg
		rz |= kReturnFloat
											// I'd need to update my compiler to add ull to this...
											// do later.


function message.RegCheck (|int| Bad)
	if bad
		error (self, "Too many registers in use. No space for result.")


function FunctionDestination (|message| exp,  |asmreg| dest,  |scfunction| fn,  |asmreg|)
	opt norefcounts
	.CurrFuncGrab++
	.ASMReach(fn)
	|uint| v = 0
	
	|| ret = .state.return
	if ret and (dest is ExitAtAll) // inlined return
		v = ret.reg
		v ?= .state.parentvars|uint|.log2 + 1
		dest = dest.Tempness(ret)

		// this could trash a valid reg!!!
		// x = inl(y) --> return y + func() // func trashes! 

	  else
		|| vd = .VDecls
		v = vd.log2					// we can't use .declareme, .log2 is used to protect the vars. 
		if v == 0 or dest.reg != v
			v++
		vd |= 1<<v
		.Vdecls = vd
		dest &=~ asmreg.tempflags
		exp.RegCheck(vd & .vtemps)
	
	exp.RegCheck((v >= 32)|int|)
	dest.reg = v
	
	|| ty = fn.ASMReturn(dest)
	return ty.Simplify


function fatasm.CurrGrabID (|byte|)
	return ._const

function fatasm.CurrGrabID (assigns:|byte|)
	.const = value


function GrabAddr (|message| exp, |AsmReg| Dest, |scdecl| d, |asmreg| T, |asmreg|)
	opt norefcounts
	dest = .TempTyped(exp, dest, d)
	
	|| fat = exp.GRAB(dest, t)
	fat.CurrGrabID = .CurrFuncGrab
	return fat * dest.HaveAddr



function GrabbedRegisters (|message| AllPrms, |&fatasm| Start, |!&fatasm| Fn)
	opt norefcounts
	if 0: AllPrms.FNC3, AllPrms.FNCX3			// MARK USED

	.CurrFuncGrab--
	|| c = .Lastreal - 1
	while C >= Start
		if c isa asm.GRAB
			if c.CurrGrabID == .CurrFuncGrab
				.SetRegister(c.regonly(1), nil, fn, 0)
		c--
		
}




function SCFunction.HasCVersion (|bool|)
	if .IsCppInBuilt == 2						// cpp_nothing: For JB_Decr, JB_Ternary, etc
		return false

	if .IsLibrary
		return true

	return self is cpp



function assembler.FailInline
	.EntireInlineFailed = .EntireInlineFailed|int| max 1


function assembler.MustInlineFailed (|message| exp, |bool| DepthOK, |scfunction| fn,  |asmreg|)	     // dofunction function
	opt norefcounts
	if !.InlineDepth
		|| unable = (.EntireInlineFailed<2)
		debugger
		|| reason =  (unable)("Unable to inline function: ", "Inlined too deep on function: ")
		error (exp, reason + fn)
	.EntireInlineFailed = 1 + !DepthOK
	return asmreg()


function string.operatorplus (|scfunction| fn, |string|)
	opt norefcounts
	|| fs = FastString.shared
	fs <~ self
	|| pname = fn.parentname
		fs <~ pname
		fs <~ '.'
	fs <~ fn.Name
	return fs


function assembler.DepthOK (|scfunction| fn, |bool|)
	opt inline
	|| ExpectInline = (fn is linkinline)|uint|
	if !ExpectInline and (fn isnt OptInline) and !Options.AllowMassInlines
		return false
	return .InlineDepth < .InlineDepthLimit + ExpectInline


function assembler.ASMTableID (|message| Exp, |scfunction| fn, |int|)
	rz = fn.FPackID + 31
	if rz <= 31											// failed!
		if !Compiler.InPerry							// shut the compiler up
			if !fn.islibrary or !.state.fn.islibrary
				error (exp, "Missing PackID[1]")
		rz = 0xFFFF	


function scfunction.SingleASMCall (|bool|)
	return !.ProtoType or (.ASMAndCpp != 3)


function @ASMType.ASMFunction (fn_asm)					// dofunction
	opt norefcounts
	|| prms = exp.last!
	|| TableID = 0
	|asmreg| PointerCall
	
	.ParentSanity
	|| fn = prms.AsFunc
		|| intrin = fn.Intrinsic
			return .DoIntrinsic(exp, dest, fn, intrin)
		
		if  fn isnt AnyNoInline
			|| DepthOK = .DepthOK(fn)
				|| MiniDest = .AskForInline(prms, dest, fn)
					return MiniDest
			
			if fn is LinkInline
				return .MustInlineFailed(exp, depthok, fn)
		
		TableID = .ASMTableID(exp, fn)
		
	  else // function pointers
		|| f = exp.first!
		PointerCall = .µ(f)
		TableID = PointerCall.reg
		fn = f.ASMDecl.Type.FuncProto						#expect (exp)
	
	fn.ASMReached = (fn.ASMReached + 1) min 255
	dest = .FunctionDestination(exp, dest &~ asmreg.ExitAtAll, fn)
	|| Start = .curr
	|asmreg[8]| Regs

	{
		|| Closer = .OpenVars
		|| i = 0
		|| args = fn.args
		|| RefAdd = 2 - fn.SingleASMCall
		for	p.fast in prms
			// todo: The last call to µFuncPrms doesn't need µFuncPrms. Needs total ASM-dump compare.
			regs[i] = .µFuncPrms(p, args[i]!, RefAdd)
			i++
		.CloseVars(Closer)
	}

	|| C = fn.HasCVersion
	if fn.SingleASMCall
		|| fat = .ASMCall(exp, dest, fn, tableid, regs, C)
		.GrabbedRegisters(exp, Start, fat)
		return fat.info // already set in asmcall

//	|| HighBit = .TempMe(exp, datatypecode.uint64|asmreg|)
	|| branch = exp.JTST(PointerCall, 63)
//	branch.OperatorMul(highbit)							// this returns nothing? so no need to add.
	.ASMCall(exp, dest, fn, tableid, regs, false)
	|| J = exp.jump
	
	|| fn2 = .ASMCall(exp, dest, fn, tableid, regs, true)
	j.Jumpto(.curr, self)
	branch.JumpTo(fn2, self)
	
	.GrabbedRegisters(exp, Start,  fn2)
	return fn2.info


function int.FuncFill (|&asmreg| regs, |&uint16| func_inputs)
	for i in self
		|| r = regs[i]
			|| fati = r.FatIndex
			|| input = fati.fat
				func_inputs++[] = fati


function assembler.ASMCall (|message| exp, |asmreg| dest, |scfunction| fn, |int| TableID, |&asmreg| Regs, |bool| Cpp, |&fatasm|)
	opt norefcounts
	|| P = .EncodeParams(exp.last!, fn, Cpp, regs)
	|| PExt = P >> 32
	(dest is statelessfunc) = (fn|scobject| is Stateless)
	
	|| func = exp.FNC(dest, TableID, P, PExt)
	|| NArgs = fn.args.Length
	func.TotalFuncInputs = nargs
	nargs.funcfill(regs, &func.Inputs[0])
	
	if Cpp
		func._op = asm.FNCX
		if PExt > 0
			func._op = asm.fncx3
	  elseif PExt > 0
		func._op = asm.fnc3
	
	.Trash(dest.reg)

	if fn|scobject| isnt stateless
		func.incr					// NOICE!
	
	if fn is Killer
		(dest is exit)
		func.incr
	dest = (func * dest)
	return func


function assembler.ASMReach (|SCFunction| fn)
	opt norefcounts
	|| orig = .Root_Fn
	if Orig.MyReacher and !orig.IsLibrary
		(fn is usedbyasm)
		if fn is Constructor // gotta reach the destructor also
			fn = fn.cls!.DestructorFunc
			if fn
				(fn is UsedByASM)


