


struct RegFile
	|uint16[32]|				Setters
	|uint|						KnownMap
	|uint|						Altered
	|uint|						Phi



extend assembler
	function BackupFAT (|&fatasm| Curr)
		|| Start = .FuncStart
		|| Amount = Curr - Start
			|| T = .BackupTotal
			if (T+Amount < 64K)
				.BackupTotal = T + Amount
				target debug
					|| dest = Backupspace! + T
					Memory.Copy(dest, Start, Amount*–sizeof fatasm)			// Save the old stuff here.
			  else
				error ""
				amount = 0
		.state.BackupAmount = Amount
	
	
	function RevertFAT (|bool| Check, |int| TrapCount)
		|| st = .state
		|| Amount = st.BackupAmount|int|
		st.BackupAmount = 0

		require amount

		|| T = .BackupTotal
		|| T0 = T - Amount
		.BackupTotal = T0
		(check)
		(trapcount)
		target debug
			require check
			
			|| Live = .FuncStart
			|| Backup = BackupSpace! + T0
			|| after = live+amount
			while live < after
				if !memory.equals(live, backup, –sizeof fatasm)
					target debug
						ASMDebug()
						live.debugprint
						backup.debugprint
					debugger 
					live[0] = backup[0]
				Backup++
				live++

		
	
	function ParentBlock (|&fatasm| f, |uint16|)	
		return .ParentBlock(f.basicblock)


	function ParentBlock (|uint16| B, |uint16|)
		if B >= 16K // argh
		return BlockParents[B&(16K-1)]

	
	function IsWithin (|&fatasm| f, |bool|)
		// Loops could still fail...
		// we need to mark vars as set in loops... in the asm, right?
		// we'd have to not mark as fat as CONST even if it came from a const...
		// I guess... the y=2 thing would have to clear the const bits...
		// perhaps we shouldn't "pre-lookup" the var its going into...
		// but instead just GET IT... then... clear bits or whatever
		// in SetRel or whatever it is.
		
		/*
			y = 1
			while x
				z = y+1
				y++
		*/
		
		|| ToFind = .ParentBlock(f)
		|| Us = .BasicParent
		while
			if Us == ToFind
				return true
			if !Us
				return false
			Us = .ParentBlock(Us)
	

/*
	PHI makes this unnececessary. Or does it? Blocks can get broken up.
	We can still test the parentblock instead?
	function WouldReplace (|&fatasm| f, |bool|)
		/*
			while y < 2
				y += 10
			y = 1						// this would replace y += 10
		*/
		|| OurParent = .BasicParent
		|| B = F.BasicBlock
		// the parent of b is equal to OUR parent
		while B
			|| PB = .ParentBlock(B)
			if PB == OurParent
				return true
			B = PB
*/
	
	function EnterBranch (|uint16|)
		if "IsSelfCon".trap
		|| s = .state
		s.BranchDepth++
		s.RealBranchDepth++
		return .BasicParent
	
	
	function ExitBranch (|uint16| Old)
		|| s = .state
		s.BranchDepth--
		s.RealBranchDepth--
	
		if old != .BasicParent
			.NextBasicBlock
		
	
	function IsCurrBranch (|&fatasm| f, |bool|)
		return .BasicParent == .ParentBlock(f.basicblock)


	function ParentSanity 
		target debug
			|| PP = .BasicParent
			|| BB = .basicblock
			|| BP = .parentblock(BB)
			if BP != PP 


	function IsCurrBlock (|?&fatasm| f, |asm| Type,  |bool|)
		if (f isa type)
			return (.basicblock == f.basicblock)


	function IsCurrBlock (|&fatasm| f, |bool|)
		// can these use .within?
		return .basicblock == f.basicblock
	
	
	function AskNopTemp (|asmreg| R)
		if R is temp
			|| f = r.fat
				return .AskNop(f)
	

	function AskNopTemp (|?&Fatasm| Fat)
		if fat is temp
			return .AskNop(fat)
	

	function NopReg (|asmreg| R)
		|| f = r.fat
			return .Nop(f)
		target debug
			if r.reg and r isnt param
				debugat							// We don't know what made it, but we should!!
	
	
	function Nop2TempConsts (|asmreg| A, |asmreg| B)
		|| Further = a.FatIndex > b.FatIndex
			.NopTempConst(A)
		.NopTempConst(B)
		if !Further
			.NopTempConst(A)					// In case of swapped order
	
	
	function Const (|asmreg| R, |int| bits, |bool| signed, |ind|)
		if r.reg == 0
			return 0							// Sigh. I DIE.
		
		require R is Const

		|| RF = R.fat
//		if rf and .IsWithin(RF)					// The .iswithin is already used by CanConstLocalThg
			|| k = RF.const
			if k.fits(bits, signed)
				.NopTempConst(R)
				return k|uint64|.trim(bits)
	
	
	function NopTempConst (|asmreg| R, |int64| K, |bool|)
		if r.Const == K
			.NopTempConst(R)
			return true
	
	
	function NopTempConst (|asmreg| R)
		require r.reg
		target debug: if r isnt Const		// hah

		if  R is temp  and  r isnt blocknop	// don't think we can do better. not easily. 
			.AskNop(r.NeedFAT)				// for example .iscurr(f) gets params used by future stuff
	
	
	function Nop (|FATASM| ToNop)
		return .nop_sub(ToNop, fatnopmode.hard, 0)
	
	
	function SoftNop (|FATASM| ToNop, |fatnopmode| mode = 0)
		// means we still want to use the inputs of tonop, later, even if they get derecremented down to 0
		mode |= fatnopmode.KeepInputs
		return .nop_sub(ToNop, mode, 0)
	
	
	function nop_sub_keep (|FATASM| Fat, |fatnopmode| NopMode, |bool|)
		require NopMode isnt Rewind
		|| Break = fat.breakinfo$
		if .IsCurrBranch(fat)
			.BreakRequest |= Break
		if break & BreakPoint
			.BreakRequest = 0
			return true
		
		
	function nop_sub (|FATASM| Fat, |FatNopMode| NopMode, |int| Depth=0)
		if NopMode isnt Rewind
			if !fat.IsStateless						// Can't nop something that does something.
				target debug						// but also, it shouldn't even happen
					ASMDebug()
					fat.DebugPrint()
					debugger
				return

		if !.IsWithinCurrInline(fat)
			|| C = .DelayedNopCount++
			if C < –count .DelayedNops
				.DelayedNops[C] = fat.Index
			return

		|| HasBreak = .nop_sub_keep(fat, NopMode)
		if (nopmode is rewind)
		// the problem is jumps, if something jumped to a point, and then we nop the jump-dest
		// it goes wrong. It happens during returnopt. But could it happen elsewhere? who knows
		// might as well play safe.
			|| C = .Last
			if fat == C
				.curr_ = C							// Do it before both kinds of nop...

		depth++
		if depth > 7
		
		for f.FatInputs in fat
			if f
				if (NopMode isnt KeepInputs)
					NopMode = FatNopMode.NopTemp
				  else
					NopMode = FatNopMode.KeepInputs
				.Decr(f, NopMode, depth)

		for v.RegOutputs in fat
			v &= 31
			if .Register(v) == fat
				.SetRegister(v, nil, fat.FindOlder)
		
		fat.setop = asm.noop
		if HasBreak
			fat.BreakInfo = breakpoint ||| Breakable
							
		
	function Register (|int| i, |?&FATASM|)
// If a var is altered in a loop, and we're in a loop, its not a known value.
		|| r = .Regs.Setters[i]
			return .funcstart_ + r

	
	function KnownValues (|int| changed, assigns:|bool|)
		|| M = .regs.KnownMap
		changed = 1 << changed
		m &=~ changed
		if Value
			m |= changed
		.regs.KnownMap = M
			
			
	function Trash (|uint| Reg)
		|uint| A = .regs.altered &~ ((1<<(Reg+1))-1)
		while A
			|| r = a.log2
			a &= ~(1<<r)
			.SetRegister(R, nil, nil)
	
	
	function CanNop (|fatasm| F, |int| Changed, |bool|)
		// what about... using .IsCurrBranch
		
		require (f.RefCount <= 0) and .IsCurrBranch(f)
		|| m = f.OutputMap

		m &= ~(1<<changed)
		if !m
			return true

		// Alters two registers. But might be replaced already.
		// I can't get this case to occur, but it could in theory.
		// I guess this is just me being "extra safe".
/		|| i = m.Log2
		if .regs.Setters[i] == F.index
			return false
		return true
	
	
	function SetRegister (|int| Changed, |asmreg| NopDest, |?&FATASM| Alterer, |asmreg|)
		|| A = .regs.Altered &~ (1<<Changed)
		|| P = .regs.Phi &~ (1<<Changed)
		|| N = 0
		if Alterer
			A |= 1 << Changed
			P |= 1 << Changed
			N = Alterer - .FuncStart_							// Set value

		|| oldi = .regs.Setters[changed]
		.regs.Altered = A // works really well with PHI nodes!
		.regs.Phi = P
		.regs.Setters[changed] = n
		.KnownValues(changed) = Alterer is Const
		
		target debug
			if .Register(changed) != alterer					// huh?
				
		if oldi and (NopDest is AllowNopDest)
			target debug: if !alterer							// can't happen,  .Dest sets this.
			|| old = .FuncStart_ + oldi
			if .CanNop(old, changed)
				if alterer and old is DebugVarOpen
					(alterer is DebugVarOpen)					// like: || a = 1, a = 2

				.nop_sub(old, fatnopmode.hard)
		
		(NopDest isnt AllowNopDest)
		return NopDest
	
	
	function RegIsConst (|asmreg| R, |int64| K, |bool|)
		|| f = .register(r.reg)
		if f is Const
			return f.const == k
		if r.reg == 0
			return !K
	
	
	function Decr (|&fatasm| f, |fatnopmode| Mode, |int| Depth=0)
		|| R = f.refcount - 1
		if r < 0
			return

		f.µRefCount = R
		require (R <= 0) and (mode isnt KeepInputs)
		if (mode is NopTemp)
			require (f is temp)
		.nop_sub(f, mode, depth)
	
	
	function AskNop (|fatasm| ToNop, |&fatasm| Replace)
		if ToNop.RefCount <= 0
			|| br = ToNop.BreakInfo
			.nop(ToNop)
			replace.BreakInfo = br

	
	function AskNop (|fatasm| ToNop)
		if ToNop.RefCount <= 0
			.nop(ToNop)
	
	
	function Rewind (|fatasm| Start, |fatasm| After)
		|| Mode = fatnopmode.KeepInputs|||fatnopmode.rewind
		while start < After
			.nop_sub(--After, mode, 0)
	

