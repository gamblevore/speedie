

function fatasm.Nop_Encoder (Asm_encoder)
	if .BreakInfo & assembler.breakpoint
		return ASM_u0.Encode(self, curr, after)
	return curr


function fatasm.DoNotEncode (Asm_encoder)
	return curr


function fatasm.Halt_Encoder (Asm_encoder)
	curr++[] = .prms[0]&0xFFFfff // a shame to waste this opcode.
	curr++[] = 0				 // we'd have to move the 2/3 codes out of 0. Or up by 1.
	return curr


function fatasm.KNST_Encoder (Asm_encoder)
	visible true
	|| op = .op|asm|
	|| mu = op << 24
	mu.r1 = .prms[0]
	|| V = ._const
	if v>>63
		v = ~v
	mu.IntConst_Cond = .prms[1]
	mu.IntConst_Inv = .prms[2]
	mu.IntConst_Value = v & 17~bits
	if curr < after
		curr++[] = mu
		if op != asm.knst and curr < after
			curr++[] = V>>17
			if op == asm.knst3 and curr < after
				curr++[] = V >> 49
	return curr
