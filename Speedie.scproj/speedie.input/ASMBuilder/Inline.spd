
function assembler.StartInlineState (|message| prms, |asmreg| dest, |SCFunction| fn, |&inlinestate|)
	|int| ID = .inlinedepth + 1
	|| st = &.inlinestate[ID]
	st[0] = st[-1]					// copy old state to new
	st.ParentVars = .openvars
	st.fn = fn
	st.BranchDepth = 0
	st.FuncStart = .curr - .FuncStart
	st.Return = .SetInlineDest(prms, dest, fn)
	st.ID = ID
	
	.InlineDepth = ID
	.DeepestInline = ID max .DeepestInline
	return st		


function assembler.CloseInline (|&inlinestate| st)
	|| ID = st.ID
	.InlineState[ID] = nil // could we just do st = nil?
	.InlineDepth = --ID
	if !ID
		.InlineEnd = nil
	


// I prefer this, BUT it seems to change the behaviour. Why? Its meant to do the same?
function assembler.TryInline2 (|message| prms, |asmreg| dest, |SCFunction| fn, |int| AllowedGain, |asmreg|)
	opt norefcounts
	|| OV = .OpenVars
	|| st = .StartInlineState(prms, dest, fn)
	if dest isnt ExitFunction
		.state.TailInlineable = false

	|fatrange| LL
	|| r = .TryInlineSub(prms, fn, AllowedGain, LL)
		if fn is constructor
			|| des = fn.cls!.DestructorFunc
				.ASMReach(des)
	
	.CloseInline(st)
	return .CloseVars(OV, nil, r)				// Should closevars come before restore?





struct InlineInfo
	|asmreg[10]|	Items
	|uint|			Altered
	|uint|			References
	|uint|			Normal
	|uint|			CantNop
	
	function DoImmediates (|?message| p, |[scdecl]| args, |&assembler| sh)
		opt norefcounts
		for (a in args) (i)
			.Items[i] = .PreInlineOneParam(p!, a, sh, i)
			p++

		.CleanupClash(args)


	function NopParams (|int| n, |asmreg| Ret, |assembler| sh)
		opt norefcounts
		while  --n >= 0
			|| r = .Items[n]
			|| v = r.reg
			if !v
				0
			  elseif r is Const
				sh.Decr(r.needfat, fatnopmode.hard)
			  elseif r iz Ret
				0
			  else
				|| f = r.fat
				if f  and  !f.µrefcount  and  f.guesssize
					if .CantNop & 1<<n
						0 // it was passed in from a parent inline?
					  elseif sh.IsWithinCurrInline(f)
						sh.nop(f)

	
	function PreInlineOneParam (|message| p, |scdecl| arg, |assembler| sh, |int| i, |asmreg|)
		opt norefcounts
		p = p.ASMUnbra
		require (p.func == @thg)
		|| passed = p.ASMDecl
		require passed is local
		|| v = sh.LocalThg(passed)
		|| vr = 1<<v.reg
		.CantNop |= 1<<i
		if arg is Reference
			.References |= vr
		  elseif arg is Altered
			if .Altered & vr
				.Normal |= vr // passed a reg twice, both alter it.
							  // but why do I mark it as normal??
			.Altered |= vr
			
		  else
			.Normal |= vr

		(arg is reference) = (passed is reference)
		arg.mu.Info |= (passed.mu.info & scdeclinfo.alteredcopy)
		if arg is TypeImprove // oof? typeimprove param?
		return v	
	
	
	function CleanupClash (|[scdecl]| args)
		// this should handle altered params like in vecmix31
		// its altering the param...
		// this is only allowed if we always RETURN that param
		// or it is unused after... but we don't know that, 
		// so basically only if its returned!
		|| AR = .References & .Altered
		|| AN = .Normal & .Altered
		if AR ||| AN
			.ClearInlineParamClash(args, AR, AN)


	function ClearInlineParamClash (|[scdecl]| args, |int| AlteredRefs, |int| AlteredNormal)
		opt norefcounts
		|| n = args.Length
		while n-- > 0
			|| V = .items[n]
				|| a = args[n]!
				|| r = 1<<v.reg
				if (AlteredRefs & r) and (a isnt reference)
					.items[n] = asmreg.ParamNeedsCopy				// needs copy to save other regs
				  elseif (AlteredNormal & r) and (a is altered)
					.Items[n] = asmreg.ParamNeedsCopy
	


extend assembler {
function SetInlineDest (|message| prms, |asmreg| dest, |scfunction| fn, |asmreg|)
	opt norefcounts
	require .TempCheck(dest)
	|| dest2 = dest
	if (dest isnt discard) and (!dest.reg or dest is temp)
		dest2 = .CallFunc(prms, dest, fn)			// better to put this in the right place...
		require .TempCheck(dest)
	
	dest2 = dest2.simplify
	dest2.µtype = fn.ASMReturn.ASMRegType
	if !dest2.reg
		(dest2 is discard)
		
	return dest2
				
	
	
function TryInline (|message| prms, |asmreg| dest, |SCFunction| fn, |int| AllowedGain, |asmreg|)
	opt norefcounts
	|| OV = .OpenVars
	|int| ID = .inlinedepth
	|| st = .inlinestate[ID+1]
	st[0] = .inlinestate[ID]
	st.ParentVars = .openvars
	st.fn = fn
	st.BranchDepth = 0
	st.FuncStart = .FuncIndex	
	st.Return = .SetInlineDest(prms, dest, fn)

	.InlineDepth = ++ID
	.DeepestInline = ID max .DeepestInline

	target debug: || TrapInline = ++asmtrapper, if  TrapInline == -1
	if dest isnt ExitFunction
		.state.TailInlineable = false

	
	|fatrange| LL
	|| r = .TryInlineSub(prms, fn, AllowedGain, LL)
		if fn is constructor
			|| des = fn.cls!.DestructorFunc
				.ASMReach(des)
	
	.InlineState[ID] = nil
	.InlineDepth = --ID
	if !ID
		.InlineEnd = nil
	
	return .CloseVars(OV, nil, r)				// Should closevars come before restore?



function TryInlineSub (|Message| prms, |SCFunction| fn, |int| AllowedGain, |fatrange| LL, |asmreg|)
	opt norefcounts
	LL.Start = .curr
	
	|SavedRegisters| svregs
	|InlineInfo| Info
	svregs.Collect(fn.args, self)
	.InlineParams(prms, info, fn)
	|| RealStart = .curr							// Params need to be done anyhow... so don't count them.
	target debug
		|| InlineTrap = ++asmtrapper
		if InlineTrap == 25978
	asmtype.ArgumentSub(self, fn.SourceArg!)
	info.NopParams(fn.args.length, .state.return, self)
	svregs.Restore(fn.args)
	
	ll.after = .curr
	rz = .InlineFinish(ll, svregs)
	|| Grown = .CurrGain(RealStart)
	if (Grown > AllowedGain) or .EntireInlineFailed
		if .EntireInlineFailed  and  (fn isnt linkinline)
			.EntireInlineFailed = 0
		svregs.Rewind(self)
		.Rewind(ll.start, .curr)					// rewind
		return nil
	
	if svregs.ReturnCount > 1
		.NextBasicBlock
	if !rz
		(rz is Const)								// no longer zero

	if (.curr > RealStart)							// useful, to stop jumping all over in IDE
		if RealStart isnt DebugVars					// dont break the type
			realstart.Fatmap = prms.parent!			// cleanup


	
function InlineParams (|message| prms, |InlineInfo| Info, |scfunction| fn)
	opt norefcounts
	|| p = prms.first$

	// OK so this has a design flaw.
	// around temp regs. tempregs should be considered "will disappear"
	// i think its always considered an "input" to an instruction. So if the instruction
	// does not need it, it can nop the thing. However... its NOT a temp here.
	// So we should not be getting temps, right? I mean... the thing COULD just...
	// call another func. It shouldn't be so hard, just give it a good dest?
	
	|| args = fn.args
	if fn == "vecmix"
	info.DoImmediates(p, args, self)
	
	for (a in args) (i)
		|| V = info.Items[i]
		target debug: || trap = ++asmtrapper, if trap == -1
		if !(V asnt ASMReg.ParamNeedsCopy) // its nil or ParamNeedsCopy
			info.items[i] = .µInlineOneParam(p, a, V)
		
		a.AsmReg = info.Items[i] // A stores the output of P
		p = p.next!


	
function CurrGain (|&fatasm| Start, |int|)
	|| C = .curr
	while Start < C
		rz += start.GuessSize
		start++



function AskForInline (|Message| prms, |ASMReg| dest, |SCFunction| fn, |ASMReg|)
	opt norefcounts
	|| N = fn.µSmallerLength
	if fn isnt LinkInline
		require N and (N < 64)
		|| MaxEnd = .InlineEnd
			|| SubInline = .curr + (N / 3)
			require SubInline < MaxEnd
	
	|| AllowedGain = 5 + (fn is OptInline) * 18		// Assume that functions have 5 instruction overhead.
	|| Grace = 2 + (fn isnt constructor)*3			// 2 grace for constructors, 5 for others.
	if fn is LinkInline
		allowedgain += 2
	  elseif fn.IsLibrary
		AllowedGain -= 1 + (fn is OptInline)<<2

	AllowedGain -= .inlinedepth
	
	for p.fast in prms
		Grace += .IsASMConst(p)<<1

	if N >= (AllowedGain + Grace)|uint|
		require fn is linkinline
		problem (prms, "Inline function oversized")

	if !.InlineDepth
		.InlineDepthLimit = 3
		.DeepestInline = 0
		.InlineEnd = .curr + AllowedGain

	|| I = .TryInline(prms, dest, fn, AllowedGain)
		return I

	// try weaker inline
	require !.InlineDepth and (.DeepestInline > 1)

	.InlineDepthLimit = 1
	return .TryInline(prms, dest, fn, AllowedGain)



function InlineFinish (|FatRange| R, |savedregisters| sv, |ASMReg|)
	target debug: || inlinetrap = ++asmtrapper,  if inlinetrap == -1
	for s in R
		|| op = s.op
		if op == asm.RFRT
			sv.ReturnCount++
		  elseif op == asm.ret
			sv.ReturnCount++
			if rz
				rz = rz.simplify
			  else
				|| dest = s.inputfat(0)
					rz = dest.info
				  else
					rz.reg = s.asmreg(0) // what about the temp?
					rz.µType = .state.return.µType
			s.SetOp = asm.jump
			s.JumpPrm = 1
			s.JumpFix(.curr)

		  elseif op == asm.knst
			|| reg = s.RegOnly
			|| Info = sv.decls[reg-1].info
			if info is reference
				s.µRefCount++			// what about refcounting ALL references, not just knst?
			
			.AskNop(s)					// nopping ALL ops... has issues
			
		if s.GuessSize
			(s.info as= asmreg.FromInline)
	
	rz &= ~ASMReg.Exit
	|| dest = .state.return
	(rz as= dest&asmreg.exit)
	rz = rz.ExpectSameType(dest)
	if !rz.reg
		(rz is const) // make compiler happy


}

