


function assembler.StartInlineState (|message| prms, |asmreg| dest, |SCFunction| fn, |&inlinestate|)
	|int| ID = .inlinedepth
	|| st = .inlinestate[ID+1]
	st[0] = .inlinestate[ID]
	st.ParentVars = .openvars
	st.fn = fn
	st.BranchDepth = 0
	st.FuncStart = .FuncIndex	
	if dest isnt ExitFunction
		st.TailInlineable = false
	dest = .SetInlineDest(prms, dest, fn)
	st.Return = dest

	.InlineDepth = ++ID
	.DeepestInline = ID max .DeepestInline
	st.ID = ID
	return st


function assembler.CloseInline (|&inlinestate| st)
	|| ID = st.ID
	.InlineState[ID] = nil
	.InlineDepth = --ID
	if !ID
		.InlineEnd = nil	


function assembler.TryInline (|message| Prms, |asmreg| Dest, |SCFunction| Fn, |int| AllowedGain, |asmreg|)
	opt norefcounts
	|| OV = .OpenVars

	|| st = .StartInlineState(prms, dest, fn)
	target debug
		|| TrapInline = ++asmtrapper
			if  TrapInline == 172701
				printprogress()
				refcounttrap = .curr - 1
				refcounttrap.debugprint
				printline 
	  else
		|| trapinline = 0
		
	.backupfat(.curr)
	|fatrange| LL
	|| r = .TryInlineSub(prms, fn, AllowedGain, LL)
		if fn is constructor
			|| des = fn.cls!.DestructorFunc
				.ASMReach(des)
	.RevertFAT(r==nil, TrapInline)
	
	.CloseInline(st)
	return .CloseVars(OV, nil, r)				// Should closevars come before restore?





struct InlineInfo
	|asmreg[8]|		Items
	|uint|			Altered
	|uint|			References
	|uint|			Normal
	|uint|			CantNop
	
	function DoImmediates (|?message| p, |[scdecl]| args, |&assembler| sh)
		opt norefcounts
		for (a in args) (i)
			.Items[i] = .PreInlineOneParam(p!, a, sh, i)
			p++

		|| dest = sh.state.Return
		.CleanupClash(dest, args, sh)


	function NopParams (|int| n, |asmreg| Ret, |assembler| sh)
		opt norefcounts
		while  --n >= 0
			|| r = .Items[n]
			|| v = r.reg
			|| f = r.fat
			if (!v) or (.CantNop & 1<<n)
				if v  and  (r is const)
					sh.safedecr(f!)
					
			  elseif r is Const
				if r iz ret // allowed? shouldn't be?
				sh.Decr(f!, fatnopmode.hard)
			  elseif !(r iz Ret)
				if f  and  !f.refcount  and  f.GuessSize
					if sh.IsWithinCurrInline(f)
						sh.nop(f)


	function assembler.SafeDecr (|&fatasm| f)
		f.µrefcount = f.refcount - 1

	function scdecl.IsUsedAfter (|message| thg, |bool|)
		return true // remove later
		// its a good opt, but can make debugging harder

		opt norefcounts
		|| After = .Source.Parent
		if self is Param
			After = After.next
		After = After.flatafter
		while
			thg = thg.FlatNext
			if !thg or thg == after
				return false
			if thg.obj == self
				return true

	
	function PreInlineOneParam (|message| msg, |scdecl| param, |assembler| sh, |int| i, |asmreg|)
		opt norefcounts
		msg = msg.ASMUnbra
		require (msg.func == @thg)
		|| passed = msg.ASMDecl
		require passed is local
		|| v = sh.LocalThg(passed)
		|| vr = 1<<v.reg
		.CantNop |= 1<<i
		if param is Reference
			.References |= vr
		  elseif (param is Altered)	and passed.isUsedAfter(msg)
			if .Altered & vr
				.Normal |= vr		// passed a reg twice, both alter it.
									// but why do I mark it as normal??
			.Altered |= vr
			
		  else
			.Normal |= vr

		(param is reference) = (passed is reference)
		param.mu.Info |= (passed.mu.info & scdeclinfo.alteredcopy)
		if param is TypeImprove // oof? typeimprove param?
		return v	
	
	
	function CleanupClash (|asmreg| Dest, |[scdecl]| Args, |assembler| sh)
		// this should handle altered params like in vecmix31
		
		|| A = .Altered$
		/*
			Easy: Could return param that we are altering
			OMG:  Could return new local, despite altering param, AND despite that we expected to receive the altered param!
		*/

		|| Ret = 1<<Dest.reg
		|| AR = .References & A
		|| AN = .Normal & A
		|| MustReturnInto = (Ret&A)!=A
		if MustReturnInto or (AR ||| AN)
			sh.state.MustReturnInto = MustReturnInto
			.ClearInlineParamClash(args, AR, AN, ~ret&A)


	function ClearInlineParamClash (|[scdecl]| args, |int| AlteredRefs, |int| AlteredNormal, |int| AlteredNoReturn)
		opt norefcounts
		|| n = args.Length
		while n-- > 0
			|| V = .items[n]
				|| a = args[n]!
				|| r = 1<<v.reg
				if AlteredNoReturn & r
					.items[n] = asmreg.ParamNeedsCopy				// needs copy to save other regs
				  elseif (AlteredRefs & r) and (a isnt reference)
					.items[n] = asmreg.ParamNeedsCopy
				  elseif (AlteredNormal & r) and (a is altered)
					.Items[n] = asmreg.ParamNeedsCopy
	


extend assembler {
function SetInlineDest (|message| prms, |asmreg| dest, |scfunction| fn, |asmreg|)
	opt norefcounts
	require .TempCheck(dest)
	|| dest2 = dest
	if (dest isnt discard) and (!dest.reg or dest is temp)
		dest2 = .FunctionDestination(prms, dest, fn)			// better to put this in the right place...
		require .TempCheck(dest)
	
	dest2 = dest2.simplify
	dest2.µtype = fn.ASMReturn.ASMRegType
	if !dest2.reg
		(dest2 is discard)
		
	return dest2


function TryInlineSub (|Message| prms, |SCFunction| fn, |int| AllowedGain, |fatrange| LL, |asmreg|)
	opt norefcounts
	LL.Start = .curr
	
	|SavedRegisters| svregs
	svregs.Collect(fn.args, self)

	|InlineInfo| Info
	.InlineParams(prms, info, fn)					// Params need to be done anyhow... so don't count them.
	
	|| RealStart = .curr
	target debug
		|| InlineTrap = ++asmtrapper
		if InlineTrap == -1
	asmtype.ArgumentSub(self, fn.SourceArg!)
	info.NopParams(fn.args.length, .state.return, self)
	svregs.Restore(fn.args)
	
	ll.after = .curr
	if !.EntireInlineFailed
		rz = .InlineFinish(ll, svregs)
	
	|| Grown = .CurrGain(RealStart)
	if (Grown > AllowedGain) or .EntireInlineFailed
		if .EntireInlineFailed  and  (fn isnt linkinline)
			.EntireInlineFailed = 0
		svregs.Rewind(self)
		.Rewind(ll.start, .curr)					// rewind
		return nil
	
	if svregs.ReturnCount > 1
		.NextBasicBlock
	if !rz
		(rz is Const)								// no longer zero

	if (.curr > RealStart)							// useful, to stop jumping all over in IDE
		if RealStart isnt DebugVars					// dont break the type
			realstart.msg = prms.parent!			// cleanup


	
function InlineParams (|message| prms, |InlineInfo| Info, |scfunction| fn)
	opt norefcounts
	|| p = prms.first$

	// OK so this has a design flaw.
	// around temp regs. tempregs should be considered "will disappear"
	// i think its always considered an "input" to an instruction. So if the instruction
	// does not need it, it can nop the thing. However... its NOT a temp here.
	// So we should not be getting temps, right? I mean... the thing COULD just...
	// call another func. It shouldn't be so hard, just give it a good dest?
	
	|| args = fn.args
	info.DoImmediates(p, args, self)
	
	for (a in args) (i)
		|| V = info.Items[i]
		target debug: || trap = ++asmtrapper, if trap == -1
		if !(V asnt ASMReg.ParamNeedsCopy) // its nil or ParamNeedsCopy
			info.items[i] = .µInlineOneParam(p, a, V)
		
		a.AsmReg = info.Items[i] // A stores the output of P
		p = p.next!



function SCDecl.ASMReg (assigns:|asmreg|)
	target debug
		if !value.reg and self is alteredorref
	
	isnt const
	.ExportPosition = 0		// this is for a local. locals store their consts in fats...
	if value is Const
		value.incrfat
		value.ConstCheck
		if self isnt Altered
			is const
	
	(value isnt temp)		// i don't think a decl can be temp?
	(value isnt okastemp)
	value.µType = .mu.DataType
	.WholeType = value


	
function CurrGain (|&fatasm| Start, |int|)
	|| C = .curr
	while Start < C
		rz += start.GuessSize
		start++



function AskForInline (|Message| prms, |ASMReg| dest, |SCFunction| fn, |ASMReg|)
	opt norefcounts
	|| N = fn.µSmallerLength
	if fn isnt LinkInline
		require N and (N < 64)
		|| MaxEnd = .InlineEnd
			|| SubInline = .curr + (N / 3)
			require SubInline < MaxEnd
	
	|| AllowedGain = 5 + (fn is OptInline) * 18		// Assume that functions have 5 instruction overhead.
	|| Grace = 2 + (fn isnt constructor)*3			// 2 grace for constructors, 5 for others.
	if fn is LinkInline
		allowedgain += 2
	  elseif fn.IsLibrary
		AllowedGain -= (fn is OptInline)<<2

	AllowedGain -= .inlinedepth
	
	for p.fast in prms
		Grace += .IsASMConst(p)<<1

	if N >= (AllowedGain + Grace)|uint|
		require fn is linkinline
		problem (prms, "Inline function oversized")

	if !.InlineDepth
		.InlineDepthLimit = 3
		.DeepestInline = 0
		.InlineEnd = .curr + AllowedGain

	|| I = .TryInline(prms, dest, fn, AllowedGain)
		return I

	// try weaker inline
	require !.InlineDepth and (.DeepestInline > 1)

	.InlineDepthLimit = 1
	return .TryInline(prms, dest, fn, AllowedGain)



function InlineFinish (|FatRange| R, |SavedRegisters| sv, |ASMReg|)
	target debug: || InlineTrap = ++ASMTrapper,  if InlineTrap == -1
	for s in R
		|| op = s.op
		if op == asm.RFRT
			sv.ReturnCount++
		  elseif op == asm.ret
			sv.ReturnCount++
			|| dest = s.inputfat(0)
			if rz
				rz = rz.simplify
			  elseif dest
				rz = dest.info
			  else
				rz.reg = s.asmreg(0) // what about the temp?
				rz.µType = .state.return.µType

			
			if dest
				.SafeDecr(dest)
			// this is an issue. we need to decr the input reg... but without destroying it
			s.SetOp = asm.jump
			s.JumpPrm = 1
			s.JumpFix(.curr)


		if s.GuessSize
			(s is FromInline) // whyy???? this blocks consts, but why?
	
	rz &= ~ASMReg.Exit
	|| dest = .state.return
	(rz as= dest&asmreg.exit)
	rz = rz.ExpectSameType(dest)
	if !rz.reg
		(rz is const) // make compiler happy


}

