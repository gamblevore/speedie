

function SCDecl.MiniName (|faststring| fs)
	|| Bra = self is ClassObj
	.name.MiniName(fs, Bra)



function string.MiniName (|faststring| fs, |bool| IsClass)
	opt norefcounts
	|| n = .name
	|| after = int.max
	if IsClass and  n.EndsWith("data", true)
		after = n.Length - 4							// ErrorData
	
	|| i = n[0, "JB_", true]
	fs.AppendRange(n, i * 3, after)



function SCDecl.DumpFlags (|byte|)
	opt norefcounts
	rz = (self is Param)|byte|
	rz |= .IsBareStruct << 1
	
	if self is Local
		rz |= .TypeSuffers << 2
	  else
		rz |= (.NilDeclared is Nilish) << 2
	
	if .IsNormal
		|| t = .Type
		rz |= (t.BaseType is ProtoType) << 3
		rz |= (t == TypeCString) << 4


function SCDecl.DumpDeclOpen (|faststring!| dd, |int| Pos, |int| Reg, |bool| IsLocal=true)	// decldump, debugdump
	opt norefcounts
	|| Mark = dd.Length
	dd <~ '\0'											// range-length
	dd.AppendHInt(pos)
	reg *= IsLocal
	dd.AppendHInt(Reg)
	dd <~ .DumpFlags
	
	|| s = .source
	|| SrcMap = (s!=nil)(s.SrcMap, 0)
	dd.AppendHInt(SrcMap)
	.MiniName(dd)
	dd <~ '\0'
	dd.AppendHInt(.DumpCls)
	
	|| PB = DataTypeCode.PossibleBits
	|| T = .Type.TypeInfo  &  PB
	dd.AppendHInt(T)
	.DumpWierdness(dd)
	
	dd[mark] = dd.length - (mark + 1)



function faststring.DumpDeclClose (|int| Pos, |int| Reg)
	|| Mark = .Length
	self <~ '\0'					// range-length states that theres no name/type. So it must be a close!
	.AppendHInt(pos)
	.AppendHInt(Reg)
	self[mark] = .length - (mark + 1)



function FATASM.OutputDebugVars (|int| Next)
	opt norefcounts
	|| dd = Assembler.DebugDecls!
	|| Index = .ASMIndex
	if self is DebugVarClose
		if self isa asm.mark
			index = (self-1).ASMIndex
		
		for i.bits in ._Const
			dd.DumpDeclClose(index, i.log2)

	  else
		ifn self isa asm.mark
			index = Next
		|| ty = .const|scdecl|
			ifn ty isa scdecl // oof
			|| reg = .regonly(0)
				ty.DumpDeclOpen(dd, index, reg)



function scdecl.DumpCls (|int|)
	opt norefcounts
	|| t = .type.RealClass
	if t.isobject or t.isstruct
		return (t.tableid<<1) + t.isobject



function SCDecl.Wierdness (|int|)
	rz = (.IsBareStruct or (self is reference)) << 1
	// bare structs are still pointerlike...
	rz |= .pointercount > 0
	rz |= .C_Array<<2



function SCDecl.DumpWierdness (|faststring| j)
	opt norefcounts
	|| Count = 0
	while (|| W = .Wierdness)
		expect (++Count < 5) (.source, "Too much wierdness")
		j.AppendHInt(W)
		self = .Internal$


	
function Assembler.MarkVarClosed (|int| RegBits)
	.RegDebugInfo &= ~RegBits
	|| Mark = .last
	mark = mark.source.MARK()
	mark.refcount = 1
	(mark is DebugVarClose)
	mark._Const |= RegBits


function assembler.MarkVarOpen (|message| Exp, |ASMReg| Declared, |scdecl| Ty, |!&FatASM| Start, |ASMReg|)
	|| Last = .Last
	if Start > Last	and start > .FuncStart		// It could have nopped a .gtab if its an inlined param 
		start -= .IsCurrBlock(start-1)|int|		// and it gets replaced into a .gobj

	last = exp.mark(),   last.refcount = 1
	last.prms[0] = Declared.reg
	last.Const = ty|uint64|
	(Last is DebugVarOpen)	
	return Declared



target debug
	function scdecl.ASMSanity 
		ifn  .IsCarray  or  .PointerCount  or  .IsObject  or  .IsBareStruct
			|| size = .type.ClsSize
			|| T = .TypeOnly
			if T == DataTypeCode.Vec3 or DataTypeCode.ivec3
				size = 12
			if size != T.bytecount // sigh. what?
				#!"Should we have set the dtype when the decl was created? or at least verified in the nil-checker?"
				#!"We could change it if it is only 112."
				debugger
				t.DebugPrint


