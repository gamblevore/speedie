datatype ASM_Func (ASM) {
	module {
		function Encode (ASM_Encoder, ) {
			visible true
			|asm| mu = .op|asm| << 24
			mu.r1 = .prms[0]
			mu.Func_JUMP = .prms[1]
			if curr < after + 2 {
				curr++[] = mu
				curr++[] = .prms[2]
				|| p2 = .prms[2 + 1]
				if p2 {
