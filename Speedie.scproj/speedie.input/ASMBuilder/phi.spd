
	// Need to capture alterations using PHI nodes here
	// how to deal with already captured changes?
	

struct BranchPHITracker
	|RegFile|					Start
	|RegFile|					Middle



function assembler.BranchInit (|BranchPhiTracker|)
	rz.Start = .regs
	.regs.Alterations = 0



function assembler.BranchA (|BranchPhiTracker| T)
	t.Middle = .regs
	.regs = T.Start				// restore
	.regs.Alterations = 0


function assembler.BranchMergeSub (|message| Exp, |&RegFile| A, |&RegFile| B, |uint| Both)
	for (Bit.bits in both) (i)
		|| F1 = A.Setters[i]
		|| F2 = B.Setters[i]
		expect (F1 and F2) and (F1 != F2) // should always exist, and not be the same!
		exp.phi(asmreg(i), asmreg(i,f1), asmreg(i, f2))
	
	
	
function assembler.BranchMerge (|message| Exp, |BranchPhiTracker| T, |asmreg| dest, |asmreg|)
	|| XS = T.Start.Alterations
	|| XM = T.Middle.Alterations
	|| XC = .regs.Alterations
	|uint| Avoid = 1<<dest.reg
	.regs.Alterations = XC|||XM|||XS

	|| B = (XM & XC) &~ Avoid
		Avoid |= B
		.BranchMergeSub(exp, T.Middle,	.regs,		B)

	B = (XS & XM) &~ Avoid
	if B
		.BranchMergeSub(exp, T.Start,	T.Middle,	B)

	B = (XS & XC) &~ Avoid
	if B
		.BranchMergeSub(exp, T.Start,	.regs,		B)
	
	return dest

/*
	|| x = 1
	if y
		x = 2
