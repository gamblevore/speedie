


struct BranchPHITracker
	|RegFile|					Start
	|RegFile|					Middle
	|uint16|					StartIndex
	|uint16|					MiddleIndex


function regfile.ActualPhi (|uint16| From, |uint|)
	|| P = .phi
	while P
		|| i = p.log2
		|| Actual = .setters[i]
		i = 1 << i
		P &=~ i
		if Actual >= From
			rz |= i


function assembler.PhiInit (|BranchPhiTracker|)
	rz.Start = .regs
	|| i = .curr.index
	rz.StartIndex = i
	rz.MiddleIndex = i


function assembler.PhiFix (|&fatasm| Start)
	|| phi = .curr
	while --phi >= Start
		loop phi isa asm.phi
		if phi.prms[3]
			phi.BasicBlock = .BasicBlock
			phi.prms[3] = 0


function assembler.PhiMiddle (|BranchPhiTracker| T)
	t.Middle = .regs
	T.MiddleIndex = .curr.index
	.regs = T.Start


function assembler.PhiMerge (|message| Exp, |BranchPhiTracker| T, |asmreg| Dest, |int| Liftup, |asmreg|)
	|| XS = T.Start.phi
	|| XM = T.Middle.ActualPhi(T.StartIndex)
	|| XC = .regs.ActualPhi(T.MiddleIndex)
	|uint| Avoid = 1<<dest.reg
	.regs.phi = XC|||XM|||XS

	|| B = (XM & XC) &~ Avoid
		Avoid |= B
		.PhiMergeSub(exp, T.Middle,	.regs,		B, liftup)

	B = (XS & XM) &~ Avoid
	if B
		.PhiMergeSub(exp, T.Start,	T.Middle,	B, liftup)

	B = (XS & XC) &~ Avoid
	if B
		.PhiMergeSub(exp, T.Start,	.regs,		B, liftup)
	
	|| S = &.regs.Setters[0]
	|| M = &(t.middle.Setters[0])

	// maybe just go over XM bits?
	for i in 32
		S[i] = S[i]|uint| max M[i]
	return dest


function assembler.PhiMergeDeeper (|message| Exp, |BranchPhiTracker| T, |asmreg| Dest=nil, |asmreg|)
	return .PhiMerge(exp, t, dest, 1)


function assembler.PhiMergeNormal  (|message| Exp, |BranchPhiTracker| T, |asmreg| Dest=nil, |asmreg|)
	return .PhiMerge(exp, t, dest, 0)


function assembler.PhiMergeSub (|message| Exp, |&RegFile| A, |&RegFile| B, |uint| Both, |uint| Liftup)
	for (Bit.bits in both) (i)
		|| F1 = A.Setters[i]
			|| F2 = B.Setters[i]
				expect (F1 != F2) // can't be the same!
				|| phi = exp.phi(asmreg(i), asmreg(i,f1), asmreg(i, f2))
				phi.prms[3] = Liftup
	


