/*


function Assembler.RefCountSet (|message| exp, |message| prms, |&FatASM|)
	opt	NoRefCounts
	|| DestMsg = prms.first!
	|| SrcMsg = prms.second!
	|| A = .µGetPrms(DestMsg, ASMReg.AddrRequest as SrcMsg.ASMAllowsTemp)
	|| B = .µ(SrcMsg, ASMReg.AddrRequest)
	if A iz B
		return nil // wat?
	
	(A isnt const)	// shouldn't be necessary...
					// I understand that it might be const at the time
					// but is it really a const... if it got set but could change?
					// const just means "we definitely know that it IS a certain value, at this time"
					// but it won't be that value... after we change it.
					// so it seems it should always be cleared... unless its set by a const instruction
					// wheres the best place to clear it, though.
					// in fatasm.dest? what about div? it sets two registers... (But doesnt really)
					
	if A isnt ContainsAddr
		if B is ContainsAddr
			|| offset = 0
			B = .InlineOffsetOpt(B, 3, offset, 13, SrcMsg.ASMDecl, SrcMsg)
			return exp.RFRD(A, B, .RefSave, offset)					// mem to reg
		return exp.RFST(A, B, .RefSave)								// reg to reg
	
	|| glob = DestMsg.ASMDecl
	if  B is ContainsAddr
		|| where = .TempMe
		where.µtype = datatypecode._voidptr
		B = .Read(where, SrcMsg, B, nil, SrcMsg.ASMDecl) * where	// (mem to reg)?
	
	|| offset = 0
	A = .InlineOffsetOpt(A, 3, offset, 13, glob, SrcMsg)
	return exp.RFWR(A, B, .RefSave, offset)							// reg to mem


function assembler.RefSave (|asmreg| reg, |int|)
	|| s = .RefSave()
	return s - (s == reg.reg)
	
function assembler.RefSave (|int|)
	return .VDecls.log2 max 1
	

function Assembler.RefCountClear (|message| exp, |message| prms, |&FatASM|)
	opt	NoRefCounts
	|| A = .µ(prms.first!, ASMReg.AddrRequest)
	|| offset = 0
	A = .InlineOffsetOpt(A, 3, offset, 13, nil, prms.first!)
	return exp.RFWR(A, nil, .RefSave, offset)					// reg to mem


function Assembler.RefCountIncrMemory (|message| exp, |message| prms, |&FatASM|)
	opt	NoRefCounts
	|| A = .µ(prms.first!, asmreg.AddrRequest)
	target debug: if a isnt ContainsAddr						// always memory
	|| offset = 0
	A = .InlineOffsetOpt(A, 3, offset, 13, nil, prms.first!)
	|| B = .µ(prms.second!)
	target debug: if b is ContainsAddr							// always reg
	return exp.RFWR(A, B, 0, offset)


function Assembler.RefCountIncr (|message| exp, |ASMReg| Obj,  |&FatASM|)
	opt	NoRefCounts
	|| Last = .lastreal(asm.GOBJ)
		if (Last.p0 iz Obj) and !Last.p1
			Last.p2 = 1										// incring a gobj. Lets do it internally!
			return Last
	|| fat = exp.rfun(asmreg(), asmreg(), 0, Obj)
	Fat.OutputPrms = 0
	return fat


function Assembler.RefCountDecr (|message| exp, |ASMReg| Obj, |&FatASM|)
	opt	NoRefCounts
	|| Last = .last
	if .IsCurrBlock(last)
		if (last isa asm.gobj) and (Last.p0 iz Obj)  and  (Last.p1 != 0)
			last.p2 = 0							// decring a global mem obj. Lets just NOT incr!
			return nil		
		if last isa asm.rfun
			|| Ret = .CanOptRFUN(exp, obj, last) // what if this returns last+1?
				if ret != last
					return nil
				return ret
	
	return exp.RFUN(Obj, Obj, .RefSave(Obj), asmreg())



function Assembler.RefCountSub (|message| exp, |message| prms, |scfunction| fn, |&FatASM|)
	opt	NoRefCounts

	if fn == compiler.RefClear
		return .RefCountClear(exp, prms)

	if fn == Compiler.RefSetRef
		return .RefCountSet(exp, prms)

	if fn == Compiler.RefIncr2
		return .RefCountIncrMemory(exp, prms)

	|| Obj = .µ(prms.first!)
	require !.RegIsConst(Obj, 0)

	target debug: if Obj is ContainsAddr						// always a reg!

	if fn == Compiler.RefFreeIfDead
		#! Disallow: if obj.X(),   when obj.X() is a disowner
		#! Then we will never freeifdead within if-branch or other tests.
		#! needs understanding of disowners!
		return exp.rfun(Obj, asmreg(), .RefSave(Obj), asmreg())

	if fn == Compiler.RefIncr
		return .RefCountIncr(exp, Obj)

	if fn == Compiler.RefEarlyDecr
		return exp.RFST(Obj, asmreg(), .RefSave)				// reg to 0

	if fn == Compiler.RefDecr
		|| fat = .RefCountDecr(exp, obj)
		.CloseOneVar(nil, 1<<Obj.reg)
		return fat

	if fn == Compiler.RefSafeDecr
		return exp.rfun(ASMReg(), Obj)

	debugger


// dead-code stripping means this is better in ASM, than at c-level phase.
function assembler.CanOptRFUN (|message| exp, |asmreg| Obj, |&fatasm| last, |&fatasm|)
	require  !last.RegOnly(0)  and  !last.RegOnly(1)

	|| incred = last.p2
	require (incred iz Obj)

	// 0 = freeifdead,   1 = safedecr,   2 = incr
	// So by now its incr only.
	
	|| UponFat = last.InputFat(2)
		// this branch doesn't seem to occur?
		if uponfat.IsRead and (uponfat.basicblock == .basicblock)
			// incr + decr = nothing... assuming it wasn't needed
			.SoftNop(Last)
/			return last + 1 // hmmm but our caller will return nil here?
	
	if .IsWithinCurrInline(last)
		last.p0 = Incred				// freeifdead
		last.p2 = 0						// no longer an incr!
		last.msg = exp					// makes more sense to show we did both...
		return last


function Assembler.RefCount (fn_asm)						// JB_SetRef(a, b)
	opt norefcounts
	|| prms = exp.last!
	|| fn = prms.obj|SCFunction|!
	|| pf = prms.first
	if fn == compiler.RefNew
		|| A = .µ(pf!) // merge gtab into ralo?
		return exp.RALO(dest, A) * Dest

	|| fat = .RefCountSub(exp, prms, fn)
		|| saved = fat.RegOnly(2)
			.Trash(saved)
		fat.incr
		return fat.info as asmreg() // fat * asmreg() // unneeded???



function fatasm.IsDecr (|asmreg|)
	|| upon = (self)(0)
		if ((self)(1) == upon) and !(self)(2)
			return upon
	

function Assembler.DecrObj (|asmreg|)
	|| fat = .lastreal(asm.RFUN)
		|| upon = fat.isdecr
			.nop(fat)
			return upon


function Assembler.SafeObjDecr (|asmreg| Match=nil, |asmreg|)
	|| fat = .lastreal(asm.RFUN)$
	|| upon = (fat)(1)$

	require !match  or  upon iz match

	if !(fat)(0) and !(fat)(2)
		.softnop(fat)
		return upon


function FinalDecrements (fn_asm)
	if "JB_Rec_SyntaxUsing".trap
	|| D0 = .SafeObjDecr(dest)$
	|| D1 = .DecrObj
//  i think this is overkill. its possible, but decrementing 3 objects in 1 instruction is madness.
	return exp.RFRT(d0, d1) * asmreg.Exit

// */



