

// MiniOptimisations, miniopts, optimize, finishmost 

function Assembler.AddMissingReturn (|&fatasm|)
	|| Last = .LastReal
	|| S = .FuncStart
	if (last < S) or !Last.IsFinisher or .ExpectOneMore
		.MissingReturn
		last = .LastReal

	if last < S // huh?

	return Last

	
function Assembler.FinishASM
	.AddMissingReturn
	|| Length = 0
	
	target debug
		|ASM[4]| TestSpace

	|| S = .FuncStart
	while S < .curr
		|| op = s.op
		if op == asm.knst
			S.FinishConst
//			.AskNop(s)							// Could this work now that we have phi?
		  elseif S.JumpPrm
			.FinishJump(S)
		  elseif (op == asm.noop)
			s.FinishNoop
		  elseif (op == asm.FNC3 or asm.FNC) and (s < .last)
			.TryTail(s)

		|| Predicted = s.GuessSize
		length += Predicted
		
		target debug
			|| Start = &TestSpace[0]
			|| After = s.µBakeInto(Start, start+4)
			|| Actual = After - Start
			if Actual != Predicted				// Uugh		
		S++
		
	.Root_Fn.µASMLength = Length


function assembler.FinishJump (|fatasm| Jump, |bool|)
	|| D = jump.JumpTo!						// Extend the destination, in case of multiple jumps
	|| n = 0
	
	while
		if d.GuessSize == 0
			d++								// Need to check for where the func ends
		  elseif d isa asm.jump
			d = d.JumpTo!
			expect (++n < 30) (jump.msg)
		  else
			exit

	|message--| Nothing
	if d.msg == Nothing
		expect (d == .curr)					// Yikes. well we can still fix this.
		.MissingReturn
		

	|asm| m = jump.op
	if  m == asm.jump
		if  d.IsFinisher
			return jump.CopyJump(d)			// Jumping to a function-exit.
	
	  elseif (d == jump + 2) and m.JumpNegatable
		|| mid = jump + 1
		if mid isa asm.JUMP
			return jump.JumpNegate(self, mid)
	
	if n > 0
		jump.JumpTo(D)
		return true


function fatasm.FinishNoop
	require (.breakinfo&assembler.breakpoint)
	._op = asm.addb
	for i in (–count .prms)
		.prms[i] = 0


function assembler.TryTail (|fatasm| FNC)
	opt norefcounts
	require !fnc.p3
	|| Ret = Fnc.next
	require  ret isa asm.ret								// no pext, won't fit in tail.
	
	require .Root_Fn != compiler.MainFunc					// tail in main is kind of a btch...
															// the program closes and we have no idea why.
	require compiler.MainFunc != interact.OrigFn			// autocomplete also
	
	
	|| rr = ret.regonly
	|| ReturnType = .Root_Fn.ReturnType
	require !returntype or fnc.RegOnly == rr				// returning same var, or nothing at all.

	// If this overwrites params... then we need to copy params
	// We could adapt the TAIL encoder! That should do it.

	Fnc.prms[0] = Fnc.prms[1]
	Fnc.prms[1] = Fnc.prms[2]
	Fnc.prms[2] = 0
	Fnc.OutputPrms = 0
	Fnc._op = asm.tail
	fnc.incr
	(Fnc is exit)
	
	if 0: nil|message|!.TAIL



function fatasm.SimpleConst (|uint64| v, |int| Space,  |bool|)
	|| negate = v>>63
		v = ~v
	|| sh = 64-Space
	if (v << sh) >> sh == v
		.prms[1] = 0
		.prms[2] = negate|int|
		.prms[3] = v		// encoder will read from ._const anyhow
		.prms[4] = v>>32	// but we set this for fun.
		return true
//		Cond	1			// 0 == always, 1 = only if dest == 0
//		Inv		1
//		Value	17


function fatasm.FinishConst
	|| v = .const|uint64|
	if .SimpleConst(v, 17)
		._op = asm.KNST		// Already set, but its for clarity
		return
	if .RotateConst(V)
		._op = asm.KNSR
		return
	if .SimpleConst(v, 49)
		._op = asm.KNST2
		return
	.SimpleConst(v, 64)		// this is the only one that uses prms[5]. But why?
	._op = asm.KNST3		// we could just... use ._Const?? 



function uint64.rotl1 (|uint64|)
	return (self << 1) ||| (self >> 63)


function fatasm.RotateConst (|uint64| v, |bool|)
	|| BC = V.CountBits
	|| inv = 64-BC <= 12
		V = ~V
	  else
		require BC <= 12

	for i in 64
		if v <= (12~bits)|uint64|
			.p1 = i
			.p2 = inv|int|
			.p3 = v|uint|
			return true
		v = v.rotl1


