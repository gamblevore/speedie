

// MiniOptimisations, miniopts, optimize, finishmost 
function Assembler.FinishASM 
	if (.FnLength <= 0) or !.Last.IsFinisher or .ExpectOneMore
		.MissingReturn

	|| Last = .Last
	|| S = .FuncStart
	|| Length = 0
	
	target debug
		|ASM[4]| TestSpace

	while Last >= S
		|| op = s.op
		if op == asm.knst
			S.ConstFinish
//			.AskNop(s) // this is not good for consts even
// needs PHIs
		  elseif S.JumpPrm
			s.JumpImprove(self)
		  elseif op == asm.FNC3 or asm.FNC
			if s < last
				.TryTail(s)

		|| Predicted = s.GuessSize
		length += Predicted
		
		target debug
			|| Start = &TestSpace[0]
			|| After = s.µBakeInto(Start, start+4)
			|| Actual = After - Start
			if Actual != Predicted		// uugh		
		S++
		
	.out.µASMLength = Length



function assembler.TryTail (|fatasm| FNC)
	opt norefcounts
	|| Ret = Fnc + 1
	require (ret isa asm.ret) and (!fnc.p3)	// no pext, won't fit in tail.
	|| rr = ret.regonly
	|| ReturnType = .out.ReturnType
	require !returntype or fnc.RegOnly == rr					// returning same var, or nothing at all.

	// If this overwrites params... then we need to copy params
	// We could adapt the TAIL encoder! That should do it.

	Fnc.prms[0] = Fnc.prms[1]
	Fnc.prms[1] = Fnc.prms[2]
	Fnc.prms[2] = 0
	Fnc.OutputPrms = 0
	Fnc._op = asm.tail
	fnc.µRefCount++
	(Fnc is exit)
// can't do this as its too late. Something can jump to it.
// we'd have to do this at the time we created the fnc in the first place.
//	if (fnc.BasicBlock == ret.BasicBlock)
//		ret._op = asm.noop // nice
	if 0: nil|message|!.TAIL



function fatasm.SimpleConst (|uint64| v, |int| Space,  |bool|)
	|| negate = v>>63
		v = ~v
	|| sh = 64-Space
	if (v << sh) >> sh == v
		.prms[1] = 0
		.prms[2] = negate|int|
		.prms[3] = v		// encoder will read from ._const anyhow
		.prms[4] = v>>32	// but we set this for fun.
		return true
//		Cond	1			// 0 == always, 1 = only if dest == 0
//		Inv		1
//		Value	17


function fatasm.ConstFinish 
	|| v = .const|uint64|
	if .SimpleConst(v, 17)
		._op = asm.KNST		// Already set, but its for clarity
		return
	if .RotateConst(V)
		._op = asm.KNSR
		return
	if .SimpleConst(v, 49)
		._op = asm.KNST2
		return
	.SimpleConst(v, 64)		// this is the only one that uses prms[5]. But why?
	._op = asm.KNST3		// we could just... use ._Const?? 



function uint64.rotl1 (|uint64|)
	return (self << 1) ||| (self >> 63)


function fatasm.RotateConst (|uint64| v, |bool|)
	|| BC = V.CountBits
	|| inv = 64-BC <= 12
		V = ~V
	  else
		require BC <= 12

	for i in 64
		if v <= (12~bits)|uint64|
			.p1 = i
			.p2 = inv|int|
			.p3 = v|uint|
			return true
		v = v.rotl1


