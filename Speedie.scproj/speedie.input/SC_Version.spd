
module SCVersion	
	function File (|config|)
		opt norefcounts
		return compiler.SpeedieProj.filechild("vers.conf").Config
	
	function Bump (|int64| Hash)
		opt norefcounts
		|| v = .file	
		Hash &= (~0)|uint64|>>1
		|| s = hash.render
		if v["hash"]!=s
			"Bumping version"
			v["version"] = .Num + 50
			v["hash"] = s
			v.save
		
	function Str (|string|)
		opt norefcounts
		return .File["version"].Value
	
	function Hex (|string|)
		opt norefcounts
		return .num|int64|.hex
	
	function Num (|int|)
		opt norefcounts
		return .str.int
		
