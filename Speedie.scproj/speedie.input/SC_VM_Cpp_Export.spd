

extend Cpp_Export {

function WriteVMFuncs (|faststringcpp| fs)
	opt norefcounts
	for 32
		fs.appendvoid("(int64)(-1)") // ooof
	
	|| Position = 0
	for fn in packmaker.libfuncs
		if fn.NeedsLibExport
			|| id = fn.fpackid|int|
			|| Missing = id - position
			check (Missing > 0) (fn, "Bad PackID?")
			
			while --missing >= 1
				fs.appendvoid("(int64)(-1)")
			fs.appendwrap(fn)
			position = id
	fs.appendvoid("0")


function WriteLibGlobLookup (|faststringcpp| fs)
	opt norefcounts
	|| Position = 0
	
	fs <~ "#define JB_GlobOffset(g)		((unsigned short)(int64)(  &(((JB_Globals*)0)->g)  ))
#define JB_LibFunc(ty, fn)		((ty)((IntPtr)(fn)))

__lib__ unsigned short JB_GlobTable[] = {  // glob list
"
	for g in packmaker.LibGlobs
		|| id = g.gpackid|int|
		|| Missing = id - position
		check (Missing > 0) (g.source!, "Bad PackID?")
		expect (Missing < 1000) // what?
		
		while --missing >= 1
			fs <~ "\t65535,\n"
		fs <~ "\tJB_GlobOffset("
		fs.AppendLibGlob(g)
		fs <~ "),\n"
		position = id
	fs <~ "0 \n};

extern \"C\" unsigned short* JB_App__GlobTable() {
	return &JB_GlobTable[0];
}
"


function FillCake
	LibStability.StabiliseFuncs
	LibStability.StabiliseGlobs

	packmaker.LibGlobSize = packmaker.GlobalsSize(packmaker.libglobs)		// rebuild size
	assembler.sh.FillDebugInfo

	.WriteVMGlobsAndPtrs(.ModuleProperties)



function WriteVMGlobsAndPtrs (|FastStringCpp| fs)
	opt norefcounts
	.WriteLibGlobLookup(fs)
	
	fs <~ "// entire_function_list!\n\n"
	for f in packmaker.LibFuncs
		if (f.iscppinbuilt == 1)
			.MakeWrapperFor(fs, f)
	
	.WriteCakeTests(fs)
	fs <~ "\n__lib__ void* JB_PackPtrs[] = {\n"

	.WriteVMFuncs(fs)
	|| j = jbin()
	packmaker.DebugClassesAndGlobals(j)

	fs <~ "};

extern \"C\" JB_StringC* JB_App__LibDebug() {
	int n = ${j.length};
	const char* Data = "

	fs.AppendCppAll(j|string|)
	
	fs <~ ";
	return JB_StrCN(Data, n);
}

extern \"C\" void** JB_App__LibFuncs() {
	return &(JB_PackPtrs[0]);
}

extern \"C\" void** JB_App__LibGlobs() {
"
	
	.GlobalLibProtoTypes(fs)	
	fs <~ "
	return (void**)(&JBC__);
}
"


function GlobalLibProtoTypes (|faststring| fs)
	opt norefcounts
	for dcl in PackMaker.LibGlobs
		|| fn = dcl.Func
			fs <~ "\tJBC__."
			fs.AppendLibGlob(dcl)
			fs <~ " = JB_LibFunc("
			writetype(dcl, fs)
			fs <~ ", "
			fs <~ fn.exportname
			fs <~ ");\n"



function TestCakeStruct (|faststring| fs, |scclass| C)
	opt norefcounts
	|| n = c.CStructName
	for p in c.Properties
		.TestCakeProp(fs, n, p)


function TestCakeProp (|faststring| fs, |string| Name, |scdecl| Prop)
	fs <~ "\t_CakeTest($Name, ${Prop.exportname}, ${Prop.ExportPosition});\n"
	

function WriteCakeTests (|faststring| fs)
	opt norefcounts	
	
	fs <~ `
#define _CakeTest(C, P, W) {if ( ((int64)(&((C*) 0)->P)) != W ) { puts("fail"); debugger;} }

extern "C" void JB_Cake__Tester() {
`
		
	if !Options.TargetDebug
		fs <~ "}\n"
		return
	
	for c in Compiler.ClassList
		if (c.IsStruct or c.IsObject) and (c.Properties > 0) and c.IsLibrary and (!c.name[0, "cake", true])
			|| R = c.MyReacher
			if (R and R !=Compiler.Interpreter) or c.IsObject
				fs <~ "\t//\n"
				.TestCakeStruct(fs, c)
	fs <~ "}\n"
}




