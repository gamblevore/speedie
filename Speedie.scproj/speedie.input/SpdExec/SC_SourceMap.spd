
function Message.SrcLoc (|uint|)
	opt inline
	|| P = .Position
	// 11-bits for the file num, 21-bits for the position
	// 2K files and 2MB per-file max
	// File Num goes at the top, to make it more significant

	|| FileNum = .tag|uint|>>5
//	if (p>0) and !filenum // ooof?
	return (FileNum << 21) ||| (P&(21~bits))


function fatasm.BakeBreak (|uint| SrcMap, |uint| Break)
	|| i = .ASMIndex + sourcemap.ASMTotal
	if break & Assembler.BreakPoint
		SourceMap.BreakPoints!.AppendInt(I)
	
	|| value = (SrcMap|uint64| << 32) ||| I
	SourceMap.Breakable!.AppendInt64(Value)


datatype SortableLocation (uint64)
// we only use 32-bits of this. Another 32 are for
// making it possible to sort using SpdSort
// The appender above is a red-herring. We are just appending two things at once :)

	syntax expect (|string?| error=nil)
		opt norefcounts
		|| fs = FastString()
		.Render(fs, 128)
		error (error, fs)
			
	function Position (|int|)
		return self & 21~bits
	
	function File (|scfile|)
		return SCImport.AllFiles[self>>21]
	
	function MARK (|&FATASM|)
		return Assembler.sh.RequestOp(asm.mark, nil, self)
		
	function Render (|faststring| fs, |int| Max)
		opt norefcounts
		|| f = .File
		if !f
			fs <~ ("?", 3)
			return
		|| start = .Position
		|| after = start
		|| str = f.FData
		for max
			|| c = str[after]
			if !c or c.IsTextLine
				exit
			after++
		fs.AppendRange(str, Start, after)


module SourceMap
	|faststring|		Positions
	|int|				LastLength
	|int|				ASMTotal
	|FastString|		BreakPoints
	|FastString|		Breakable
	
	function Clear
		opt norefcounts
		|| p = .Positions
			p.Length = 0
		|| bp = .BreakPoints
			bp.Length = 0
		|| b = .Breakable
			b.Length = 0
		.ASMTotal = 0
		.LastLength = 0
	
	
	function Check (|scfunction| fn, |int| T, |bool|)
		opt norefcounts
		|| p = .positions
			|| Dbg = p.length - .LastLength
			expect (dbg == T)								(fn, "Debug length corrupt")
		return true
		

	function Reserve (|int| T, |&uint|)
		opt norefcounts
		|| p = .positions$

		.breakpoints ?= faststring()
		.breakable ?= faststring()
		.lastlength = p.length
		return p.Reserve(T)|&uint|


	prototype SourceSorter (|SortableLocation| A, |SortableLocation| B, |int|)

	function BreakableSorter (SourceSorter)
		return A - B


	function SortBreaks (|FastString| B)
		|| Start = B._Addr
		memory.sort(Start, b.length/8, 8, &BreakableSorter)


