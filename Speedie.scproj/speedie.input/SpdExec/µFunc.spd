

function Message.SrcMap (|uint|)
	opt inline
	|| P = .Position
	// 11-bits for the file num, 21-bits for the position
	// 2K files and 2MB per-file max
	// File Num goes at the top, to make it more significant

	|| FileNum = .tag|uint|>>5
	return (FileNum << 21) ||| (P&(21~bits))



extend SCFunction
	function FatFirst (|&fatasm|)
		return Assembler.sh.TotalStart + .µstart
	
	
	function ASMBake (|!&ASM| Where,  |!&asm| After,  |?&uint| Positions,  |!&asm|)
		opt norefcounts
		rz = where
		assembler.sh.funcstart_ = .fatfirst - 1			// for debug
		
		|byte| HasLabel
		|uint| PrevFatMap
		for fat.fat in self
			HasLabel |= fat.JumpPrm
			if (rz - where) > 63K
				error (.source, "Function too large (over 63K)")
			fat.ASMIndex = rz - where
			fat.CheckHasOutput
			
			|| Curr = rz
			rz = fat.µBakeInto(rz, after)

			if Positions
				|| pos = fat.msg.SrcMap
				if pos >> 21 == 0						// init code... has no file
					pos = 0
					|| prev = fat-1
					if prev >= .FatFirst
						Pos = PrevFatMap
				PrevFatMap = Pos
				if curr < rz
					|| Break = fat.BreakInfo
					Positions[] = pos
					while (Curr++ < rz)
						Positions++
					if break
						fat.BakeBreak(Pos, break)
				if fat.info is DebugVars
					fat.OutputDebugVars(rz-where)

		if HasLabel
			for fat.fat in self
				|| r = fat.JumpPrm
					fat.BakeLabelRequest(where, rz, r-1)	
	
	

	iterator fat
		|| FirstInst = .FatFirst
		|| CurrInst = FirstInst
		|| AfterInst = Currinst + .µfatlength
		while currinst < Afterinst
			yield currinst (CurrInst - FirstInst)
			++currinst



function fatasm.BakeLabelRequest (|!&asm| Start, |!&asm| After, |int| reg)
	(after)
	|| SelfOut = start + .ASMIndex
	target debug: debug_require  SelfOut >= start  and  SelfOut < after

	// this needs fixing.
	|int| J = .prms[reg]
	|| OldDest = self + J + 1
	|| DestOut = OldDest.asmindex
	|| dest = start + DestOut

	target debug: debug_require dest >= start and dest <= after
	|| J2 = (dest - SelfOut) -1
	check (J2 != -1) (self, errorreceiver.internalerror)
	.prms[reg] = J2
	.µBakeInto(SelfOut, SelfOut+1)			// rerender
	.prms[reg] = J							// restore!
	

	
function packmaker.BakeAllFuncs (|jbin| j, |faststring| bmr, |bool|)
//	We want to print this ? Or dump it to stdout? Why not just print.
//  And capture stdout, then uncapture? Simpler?
	|faststring| fs
	if !Compiler.InPerry
//		target debug
//			|file--| f = app.StdOut // i think always dumping is better
		fs = assembler.ASMDump.OutputStream
		
	|| i = 0
	while (|scfunction--| fn = .PackFuncs[i++])
		if !.BakeOneFunc(j, bmr, fs, fn)
			i = -1
			exit
	return i >= 0



function packmaker.BakeOneFunc (|jbin| j, |faststring| bmr, |faststring| dump, |scfunction| fn,  |bool|)
	opt norefcounts
	if !.PackSaved.AddOrShrink(j, fn)
		return true
	
	SCFunction.CurrFunc = fn
	|| Start = SourceMap.ASMTotal

	require j.BakeFunc(fn)
	|| glob = fn.HasProto
	if glob and !glob.type.IsInterface
		bmr.AppendHInt(glob.ExportPosition)
		bmr.AppendHInt(Start)
	
	if dump
		assembler.ASMDebug(fn, dump, int.max&~4)
		// we don't have the block info at this point. its gone! unless we made a fatter fatasm
		// which... might be a good idea. I mean... saving the old output could be nice?
		dump.Flush
	return true


function JBin.BakeASMSub (|SCFunction| fn, |int| T, |bool|)
	opt norefcounts
	|| Start = .StartAdd
	|| Positions = SourceMap.Reserve(t*4)
	|| Addr = .reserve(t*4)|&asm|
	|| after = fn.ASMBake(Addr, Addr+t, Positions)
	sourcemap.ASMTotal += t
	.FinishAdd(@bin, Start)
	expect (after-addr == T)									(fn, "ASM length corrupt")
	return sourcemap.check(fn, T*4)


function JBin.BakeFunc (|SCFunction| fn, |bool|)
	opt norefcounts
	|| t = fn.µASMLength
	Compiler.stTotalASMOps += t
	
	if !Options.StripNames // never true if dd
		.BakeFuncName(fn)

	|| dd = assembler.DebugDecls
		for a in fn.args
			a.DumpDeclOpen(dd, 0, a.reg)
	
	rz = .BakeASMSub(fn, t)
	
	if dd
		.add(@bin, dd)
		dd.Length = 0
		
		|| R = fn.ASMRange
		for i in 3
			dd.AppendHInt(r[i])
		.add(@bin, dd)
		dd.Length = 0
		
	if !Options.StripNames
		.exit


function jbin.BakeFuncName (|SCFunction| fn)
	opt norefcounts
	|| fs = FastString.new(nil|faststring|)
	|| cls = fn.cls
		fs <~ cls.name
		fs <~ '.'
	fs <~ fn.name
	.add(@tmp, fs, true)
	self <~ '\0'
	

