

class µForm
	|int|			Count
	|string|		Name
	|µParam[5]|		Params
	|message|		Src
	|byte|			TotalBits
	|byte|			RegsAltered
	|byte|			Index
	|byte|			RegForJump // remove RegForJump and use forms count
	
	render
		opt norefcounts
		fs <~ .name
		for i in .count
			fs <~ " "
			fs <~ .params[i].BitSize
		
	
	constructor (|message!| tmp)
		opt norefcounts
		.src = tmp
		.name = tmp.name
		.index = ++µform.count
		check (.Index < 255) (tmp, "Too many forms")

		|| Arg = tmp.last(@arg)
		for line.fast in Arg
			|| f = line.NeedFirst
			.LoadParam(f.name, line)
		if .RegForJump
			.FillRemainder(0)


	function FillParam (|int| Size, |µParam| P, |int | i)
		if size < 0 or size > 32 // hmm??
		expect (i < –count .params) ("Defined too many ASM params")
		if size
			.totalbits += size
			p |= Size - 1
		.params[i] = p	


	function AddParam (|int| Size, |µParam| P, |int|)
		|| i = .count++
		.FillParam(Size, P, i)
		if p is jump
			.RegForJump = i+1
		return i
			

	syntax Access (|int| i, |µParam|)
		cpp_part AccessInt
		return .params[i]
	

	function FillRemainder (|int| i)
		.FillParam(24 - .TotalBits, .Params[i], 0)
	
	
	function LoadParam (|string| pl, |message| Line)
		if (pl.isint)
			|| i = pl.int
			check (i > 0 and i <= 24) (Line, "Value out of range") // 1-24
			.AddParam(i, µparam.Number)
			return
		
		expect (pl == 1) (self)
		|| p = pl[]
		if  p == 'r'
			.AddParam(5, µParam.Input)
		  elseif p == 'R'
			.AddParam(5, µparam.Output)
			.RegsAltered++
		  elseif p == 'P'
			.AddParam(5, µparam.Output + µParam.input)
			.RegsAltered++
		  elseif p == 'x'							// for 64/96/128 sized instructions
			.AddParam(32, µparam.Number)
		  elseif p == 'l'
			|| i = .AddParam( 0, µparam.Number )
			.FillRemainder(i)
		  elseif p == 'j'
			.RegForJump = 1
			.AddParam( 0, µparam.signed + µparam.jump ) 
//			expect (line.IsFirst) (line)
		  elseif Line
			error (Line)
		  else
			error (self)
	
	
	iterator
		|| i = 0
		while (i < .count)
			yield self[i] (i)
			++i

	module
		|{µForm}|				Forms = dictionary()
		|int| Count
		function NeedForm (|string| Form, |message| m=nil, |µform|)
			opt norefcounts
			rz = .forms.valuelower(form)
			if !rz
				error (m, "Missing form: " + form)
				rz = µform(@arg.msg)

