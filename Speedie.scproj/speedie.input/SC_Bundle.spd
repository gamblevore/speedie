

// i used to do work to create a bundle on OSX.
// now I realised... this is futile. It makes a mess out of the compiler
// the complexity was spiralling. Files and stuff moved all over. I hated it
// this is not the place for creating such a complex product. Thats for an
// installer script or post-production script!

function compiler.Bundle
	require Platform.osx
	target osx
		require !Compiler.IsTest and !Options.ExternalCompile
		require SC_Targets["gui"]				// what about exec? or other that want to be cmd-line?
		require !linkage["nobundle"]
		.CodeSign


function compiler.CodeSign
	.Stage("Code signing")
	|| prod = .productpath.file
	|| sign = app.prefs[codesign_native]
		prod.codesign(sign.value)
	  else
		errorreceiver.NewWarning( nil, "No code-signature found. (`speedie --codesign=\"details\" to save signature). Unable to sign " + prod )
	// lets not scare users. it might a well be commented out at this point but I'd rather leave it.
	// could be useful info!


function compiler.WrongConf (CollectFunc)
	expect (!.ConfMsg) (node, "Conf already exists!")
	error (node, "Conf must be in the app.conf file")


constants
	codesign_native = "codesign_osx"
