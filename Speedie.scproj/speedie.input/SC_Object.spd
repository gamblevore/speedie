
/*
	Speedie Internals. By Theodore H. Smith...
*/


class SCObject
	|string|					Name
	|string|					ExportName
	|[SCFunction]?|				LinkFrom
	|message?|					Source
	|byte|						NoAutoComplete
	|byte|						AllocSource
	|SCObjInfo|					SCObjInfo
	|uint16|					CurrFuncLink
	|uint16|					GPackID
	|uint16|					FPackID
	
	constructor
		.SCObjInfo = Compiler.InBuiltType
		.linkfrom = nil
	
	
	function Name (|string|)
		nil safe
		if self
			return .name
		return "(nil)"
		
	render
		|| cname = ((.class.name|uint64|)+2)|cstring|
		fs <~ cname
		fs <~ ": "
		fs <~ .name

	function SyntaxExpect ( |string| Error )
		cpp_part Fail
		errorreceiver.NewError( .source, Error )

	function File (|SCFile?|)
		opt norefcounts
		|| src = .Source
			return src.File
		if self isa SCModule
			|| c = .cls
				return c.file

	syntax is (|SCObjInfo| i, |bool|)
		return .SCObjInfo&i

//	function TestASM (|SCObjInfo| i, |bool|)
//		return .SCObjInfo[i]
	
	syntax is (|SCObjInfo| i, assigns:|bool|)
		|| x = .SCObjInfo
		if value
			x |= i
		  else
			x &=~ i
		.SCObjInfo = x

	function IsVisible (|bool|)
		return self is visible
	
	function IsVisible (assigns:|bool|)
		(self is visible) = value

