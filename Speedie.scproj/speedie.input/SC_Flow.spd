function message.GenBranchFlow
	require  SCFunction.CurrFunc isnt FlowDisabled
	// if x {} --> if x {'a'.flowlog}


function message.GenWhileFlow
	require  SCFunction.CurrFunc isnt FlowDisabled
	// while x {} --> while x {app.flowlog}, 'a'.flowlog
	

function message.GenTernFlow
	require  SCFunction.CurrFunc isnt FlowDisabled
	// x = ((a)(b,c))
	// -->
	// x = ((a)(b,c)).flowlog
	

	
	

