

// Logs flow decisions... very useful.


function Tran_Flow (TranFunc)
	opt norefcounts
	expect (fn) (node, "Only use this on functions")
	|| msg = node[@thg, "off"]
		msg.ExpectLast
		node.SafeRemove
		(fn is FlowDisabled)

	
insertion
	quietly	({FlowLog.DisabledIncr, (_0), FlowLog.DisabledIncr(-1), rejoin 0})


|| GenFlowCount = 0

function message.GenFlow (|scnode| name_space=nil, |message|)
	opt norefcounts
	|| dot = @dot + "flowlog"
	dot <~ ++GenFlowCount
	dot <~ @emb
	if name_space
		TypeOfExpr(dot, name_space)
	return dot


function  @SCFunction.CanGenFlow (|bool|)
	opt norefcounts
	if Options.GenFlowLogCode and (compiler isnt Importing)
		|| fn = SCFunction.CurrFunc
		return fn isnt FlowDisabled and cpp
	

function message.GenBranchFlow
	// {} --> {'a'.flowlog}
	opt norefcounts
	if scfunction.CanGenFlow
		.first = .GenFlow


function message.GenWhileFlow
	// while x {} --> while x {app.flowlog}, 'a'.flowlog
	opt norefcounts
	if SCFunction.CanGenFlow
		.next = .GenFlow
		ifn (.first!.unbra isthing "true")			// inf loop, no log
			|| arg = .second
			arg ?= .arg
			|| g = .GenFlow
			arg.first = g
			g = g.first!
			g.func = @thg
			g.name = "app"



function message.GenProtoFlow
	// {} --> {'a'.flowlog}
	opt norefcounts
	if scfunction.CanGenFlow
		using self
		.first = .GenFlow


function message.GenTernFlow (|scdecl| Type, |scnode| name_space)
	// x = ((a)(b,c))
	// -->
	// x = ((a)(b,c)).flowlog
	opt norefcounts
	require scfunction.CanGenFlow
	ifn type.MiniMatch(typestring!.typenormal)
		|| ty = type.type.BaseType
		require ty is DataType // or Struct or Pointer

	|| dot = .WrapWith(@dot, "flowlog")
	dot <~ @emb
	TypeOfExpr(dot, name_space)
	dot.obj = type
	|| bra = dot.WrapWith(@bra)
	bra.obj = type





