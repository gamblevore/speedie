#!/usr/local/bin/spd

app.usage = "Usage: size path [...]
--types=cpp/c/h               Only report these types
--v=true/false                Count invisible files
"

|bool|		ShowInvis = app.yes("v")
||			Types = app["types"].trim.dict('/')
|[message]| FilesFound
|[message]| FoldersFound


main (|[file]| FileList)
	if !FileList
		Quit .Usage
	|| cwd = .cwd
	if cwd == "/": cwd = ""

	for F in FileList
		F.CountAll
	
	FilesFound.sort
	FoldersFound.sort
	"\n-------Folders-----\n"
	report(foldersfound, cwd)
	"\n-------Files-----\n"
	|| Total = report(filesfound, cwd)
	"\nTotal: ${Total.strsize}"


function Report (|[message]| List, |string| cwd,  |int64| )
	for m in List
		|| sz = m.position
		|| n = m.name.TrimStart(cwd)
			
		"$n: ${sz.strsize}"
		rz += sz


function file.CountAll (|int64|)
	if .isdir
		for c.files in self
			if !c.IsSymLink and (ShowInvis or c.Visible)
				rz += c.CountAll
	  else
		require !types or types[.ext]
		rz = .size
	|| m = message(@str, self)
	m.Position = rz
	if !.IsDir
		FilesFound <~ m
	  else
		FoldersFound <~ m

