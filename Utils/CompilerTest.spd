#!/usr/local/bin/spd

|| Speedie = "/usr/local/bin/spd"
import "GUI"

main (|[string]| Paths)
	printline 1073742055
	printline keys.RGUI//scan + 231
	|| files = Paths.GlobExpand
	if app["d"] // debug
		"$Paths\n$Files\n"

	|| fails = FastString()
	for f in files
		app.TryCompileOne(f, fails)
	if fails.Length	
		printline fails
		app.say("Failed")
	  else
		app.say("// All OK")


function app.TryCompileOne (|file| f, |faststring| dest)
	|| args = [f,  "--nocompile",  "--target=ForBatchTest"]
	if Speedie.Execute(args, ProcessMode.StdOutSilence).Successful
		printline f.TrimStart(app.cwd)
	  else
		dest <~ "Fail: $f\n"

