#!/usr/local/bin/spd

main (|file.existing| path=".".file)
	printline path
	.tree(path)

function app.tree (|file| path, |int| Indent=0)
	for c.files in path
		if c.Visible
			print "\t"*Indent
			|| GoBig = c.IsDir and file.StdOut.IsTerminal
				0
				print terminalcolor.bold + terminalcolor.green
			print c.name
			if GoBig
				print terminalcolor.normal
			printline
			if c.isdir and !c.IsSymLink
				.tree(c, indent+1)
	

