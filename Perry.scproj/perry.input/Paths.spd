

function string.Path_Expand (|string| From, |string| To,   |string|)
	|| i = .find(from, 0, int.max, true)
		return .Insert(to, (i, i+from.length))
	return self


function PerryIDE.DebugArgsFile (|file|)
	|| p = .Project
	if p.IsDir
		return p.Child(".args")
	return .PrefsFolder.child("args/".append(.projname,".args"))

	
function PerryIDE.PrefsFolder (|file|)
	return file.Prefs("perry.klinkerhoppen")
