

function App.GoddamnXcodeBugs
	opt norefcounts
	target debug
		if app.CWD == "/"
			for (s.backwards in .args) (ind)
				if s ~= "YES"
					.args.remove(ind)


function ClickedEditPrefs (GUIMenuEvent)
	opt norefcounts
	|| p = app._prefs
		|| F = p.path
			PerryIDE.New(F)


function string.IsProj (|bool|)
	return self isa "scproj" or "uwuz"


function string.PathIsCode (|bool|)
	return .IsProj or .IsSpd



function @string.ASCII_Chart (|string|)
	opt norefcounts // compiles to 256 bytes of CakeASM. nice!
	|| fs = FastString.shared
	|| sp = ' '
	for y in 32
		for x in 4
			|| c = y+x*32
			
			fs.AppendDecimal(c, 3)
			fs <~ sp
			fs <~ "x"
			fs.AppendHex(c, 2)
			fs <~ sp

			|| l = fs.length
			if c == '\t'
				fs <~ `\t`
			  elseif c == '\n'
				fs <~ `\n`
			  elseif c == '\r'
				fs <~ `\r`
			  elseif c == sp
				fs <~ `' '`
			  else
				if c <= sp
					c = sp
				fs <~ c|byte|
			if x < 3
				fs <~ (sp, (7+l)-fs.length)
				
		fs <~ '\n'
	return fs

	
function message.DebugArgNames (|[string]| out, |bool|)
	opt norefcounts
	if !self
		return true
	rz = .Expect(@arg)
	for s in self
		|| i = s.GoodArgName
		if i != string.error
			out <~ i
		  else
			rz = false


function message.GoodArgName (|bool| NeedName=false, |string|)
	opt norefcounts
	|| name = .GoodArgNameSub
		return name
	if name.IsOK and needname
		error (self, "No name found")
		return string.Error
	return name

	
function message.GoodArgNameSub (|string|)
	opt norefcounts
	|| f = .type
	if f.IsString or f == @thg or @num
		return .name
	if (f == @tmp) and !.IsFirst
		return .name
	error (self, "Make sure this item is a string or a proper-name.")
	return string.Error


function @error.From (|message?| self, |error|)
	opt norefcounts
	require self
	if self != @arg
		return .DecodeSpeedieError
	rz = error()
	for s in self
		rz <~ s.DecodeSpeedieError
	

function perryide.ask (|message| args)
	opt norefcounts
	for a in args
		if a.IsString and a.HasAny
/			.PathFix(a)
		  elseif a == @arel
			expect (a == "?") (a)
			|| str = a.firstname.Ask				#require
			a.Become(@str, str)
			a.clear


