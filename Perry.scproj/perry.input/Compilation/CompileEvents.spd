

function ClickedCompile (GUIAction)
	opt norefcounts
	.ide.WantCompile(CompileMode.compiling)


function perryide.WantCompile (|CompileMode| Mode)
	opt norefcounts

	if .IsBuilding			// They pressed it twice
		.DebugMode = 0
		if !.ExpandCompileSep					// Appeared to do nothing
			ClickedCancel(.BuildButton)			// might as well just do the next thing then
		return

	|| DebugArgs = .DebugArgs
	if !DebugArgs
		.RunArgsText.SetFocus
		notifications <~ "Please fix the debug args first."
		return	

	|| req = DebugArgs["compile"]
		if req ~= "cake"
			(mode is cakemode)
		  elseif req ~= "cpp"
			(mode isnt cakemode)
		  else
			Notifications <~ "Unrecognised compile mode: " + req.name

	if (mode isnt cakemode) and (mode is debug)
		(mode isnt debug)
		(mode is run)
	
	(mode is compiling)
	.DebugMode = mode
	.Actual_Compile
	.ShowOutput


function ClickedDebug (GUIAction)
	opt norefcounts
	|| i = .ide
	if (.text == "\07")				// stop
		i.Stop(i.RunningProd)
		return nil
	return i.StartDebug
	

function perryide.StartDebug (|bool|)
	if .MakeNothingRunning(" before debugging?")
		.WantCompile(CompileMode.CakeMode ||| compilemode.DebugSet)
	return true


function Perryide.ShowOutput
	opt norefcounts
	.ShowText(.ProductOut, "", false)
	|| itm = .CompileTab(3)
		(itm is hidden)
	.ProductErrors.text = ""



function PerryIDE.DebugArgs (|message|)
	.RunArgsText.InitDebugArgs
	return .RunArgsText.text.Parse(@arg)	


function PerryIDE.GUIIsCompiling (|[string]| args)
	.LogOneAction(args, speedie)
	.SpeedieText.text = ""
	
	(.BuildButton isnt enabled)
	(.BuildButton isnt visible)
	(.RunButton isnt enabled)
	(.Progress is visible)

	(self is preparing)
	.ShowCompileTab(.SpeedieText)
	.ViewAsCurr


function PerryIDE.RunCompileSub (|unixprocess?| r)
	require  r
	require r.PID or (r isa SpdProcess)
	.RunningProd = r
	if r isa SpdProcess
		|| btn = .DebugBtns.last
			btn.text = "\0E" // pause

	.ShowProductIfMoreOutput = 0
	.RunButton.text = "\07"
	.SetAppInfo

