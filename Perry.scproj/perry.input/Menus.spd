function PressingTabs (guiaction)
	if self isa Button
		|| p = .submenu|listview|
			|| ide = row.ide
				p.ListSource.clear
				|| ref = ide.first
				p <~ ("Copy " + ide.name, MenuCopyProject, ref)
				|| file = ide.path|string|
				if file and file != ide.Project|string|
					p <~ ( "Copy " + file.name, MenuCopyFile, ref)
				p <~ ("Show In Desktop", MenuShowProject, ref)
				p <~ ("Close", MenuCloseProject, ref)
				if ide.RunningProd.Status.IsRunning
					p <~ ("Kill", MenuKillProject, ref)
					
				.OpenMenu(row)


function message.IDE (|perryide|)
	opt norefcounts
	if self
		|| o = .MenuIDE
			return o
		for w in window.all
			if w isa PerryIDE
				if .name ~= w.Project
					return w

function ClickedOpenRecent (GUIaction)
	if self isa Button
		|| s = .SubMenu
			s.ListSource = Perry.RecentProjects
			s.ColumnFinder = &perry.RecentProjNames
			.OpenMenu


function list.MenuIDE (|Perryide|)
	opt norefcounts
	|| o = .Obj
	if o isa GuiControl
		if o isa PerryIDE // leak!
		return o.ide
	
	
function MenuCopyProject (guimenuevent)
	opt norefcounts
	|| ide = menu.MenuIde
		clipboard.notifiedtext = ide.project


function MenuCopyFile (guimenuevent)
	opt norefcounts
	|| ide = menu.MenuIde
		clipboard.notifiedtext = ide.Path


function MenuCloseProject (guimenuevent)
	opt norefcounts
	|| ide = menu.MenuIde
		ide.Close

function MenuKillProject (guimenuevent)
	opt norefcounts
	|| ide = menu.MenuIde
		ide.Stop(ide.RunningProd)


function ClickedTabs (GUIAction)
	opt norefcounts
	|| i = row.ide
		i.ShowIDE(True)


function MenuShowProject (guimenuevent)
	opt norefcounts
	|| ide = menu.MenuIde
		ide.Project.Reveal
	

function RightClickedTabs (GUIAction)
	if row and self isa Button
		|| i = row.ide
			.FillMenuPath(i.Project, row)

