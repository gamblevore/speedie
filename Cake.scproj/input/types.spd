

class XType
	|XType?|		Super
	|bool|			IsObject
	|bool|			IsLib
	|message|		Msg
	|[XVar]|		Properties
	
	constructor
		.msg = @emb + "(unreached)"
		
	constructor (|message| msg, |int| index)
		opt norefcounts
		|| fn = msg.Type
		.msg = msg
		|| Sup = msg[@nil]
		|| SupIndex = Sup.Int
		.IsObject = (SupIndex & 1)
		.IsLib = msg.second.int
		.Super = xtype.GetType(SupIndex, Sup)
		if .IsObject and (fn == @tmp or @msg)
			|| JBCls = cakerun.ClassTable.valuelower(.msg.name)|&Classdata|
				JBCls.Index = index
	
	function Name (|string|)
		return .msg.name
	
	syntax compare (|string| s, |bool| Aware, |int|)
		if self
			return .msg.name.syntaxcompare(s, aware)
		return 1
		
	operator isa (|xtype| Sup, |bool|)
		opt norefcounts
		while self
			if self == sup
				return true
			self = .super
		
	render
		opt norefcounts
		fs <~ .name
	
	
	module
		|InputStream|	Shared = InputStream("")
		|XType|			Unreached = xtype()
		|xtype|			Array
		|xtype|			List
		|xtype|			Dictionary
		|[XType]|		Types

		function LoadTypes (|message| List)
			opt norefcounts
			|| i = 0
			for Type.fast in List
				++i
				|| fn = Type.Type
				if fn == @msg or @tmp
					.types <~ XType(Type, i)
				  else
					.types <~ .unreached

		
		function AfterLoadTypes
			opt norefcounts
			.Array = .GetType("array")
			.dictionary = .GetType("dictionary")
			.List = .GetType("list")

			for T in .types
				|| P = T.msg[2]
					P.LoadXVars(nil, T.properties)
		
		
		
		function GetType (|string| name, |xtype|)
			opt norefcounts
			|| Cls = CakeRun.ClassTable[name]|&classdata|
				|| i = cls.index
					|| T = .types[i - 1]
						return T
			error ("Can't load class: " + name)
		
		
		function GetType (|int| i, |message| err, |xtype|)
			opt norefcounts
			i >>= 1
			if i > 0
				|| Sup = xtype.Types[i-1]
					return sup
				error (err, "TypeID out of range")



datatype Wierdness (uint)
	flags
		Pointer
		Reference
	syntax is (|Wierdness| N, |bool|)
		return self & N
	syntax is (|Wierdness| N, assigns:|bool|, |wierdness|)
		return (self & ~N) ||| (N*value)
	function Carray (|int|)
		return self >> 2
	function Pointerlike (|bool|)
		return self&~Reference


