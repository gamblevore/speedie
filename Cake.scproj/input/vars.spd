

datatype XVarFlags (byte)
	flags
		Parameter
		BareStruct
		CanBeNil
		Prototype
		CString
	syntax is (|xvarflags| F, |bool|)
		return self & F
	


class XVar (list)
	|Wierdness[5]|		Weirdness			// pointers, references, carrays
	|int|				CodeEnd
	|SourceLocation|	SrcMap
	|byte|				ViewStrength
	|XVarFlags|			Flags
	|uint16|			Reg
	|DataTypeCode|		DataType
	|string|			Name
	
	contains xvar
	
	constructor (|InputStream| s, |int| pos, |int| reg, |int| After)
		.Flags = s.Byte
		.SrcMap = s.hint
		.ViewStrength = 1
		.position = pos
		.reg = reg
		.name = s.CString
		.obj = xtype.GetType(s.hint, nil) // doesn't need to exist, .datatype is used for ints/etc.
		.DataType = s.HInt
		.CodeEnd = int.max

		for i in –count .Weirdness
			|| x = 0
			if s.Position < After
				x = s.hint
			.Weirdness[i] = x
	
	function ByteSize (|int|)
		|| w = .Weird
		if w is Pointer // references aren't real :]
			return 8
		|| s = .DataType.ByteCount
		w >>= 2
		return s * (w + !w)						// at least 1
		
	function Type (|xtype|)
		opt norefcounts
		return .obj|&nil||xtype|
	
	syntax is (|xvarflags| V, |bool|)
		return .flags&V
		
	operator contains (|int| P, |bool|)
		return P >= .Position and P < .codeend

	function Print (|!&CakeStack| Stack, |int| TabTo=0)
		opt norefcounts
		.RenderForPrint(Printer, Stack.reg0, true, TabTo, TerminalColor.RainbowTerm)
		printline Printer|&nil||string|
		printer.Length = 0
		
	module
		|| Printer = faststring()
		|| Expansion = message()
	
	
	render // for debug
		opt norefcounts
		.RenderForPrint(fs, nil, true, 0, false)
	

	function Wierdness
		Disabled "Spelt wrong!"
	
	
	function NilOK (|faststring!| fs, |!&nil| Where, |bool|)
		ifn (where|uint64| >= debugger.MinPointer) and fs.TestMem(Where, 8)
		// both should never happen. Its like a register being nil, or an object being nil.
		// Despite that we should have tested it for nil and not come here.
			debugger
			error (ErrorReceiver.internalerror)

		|| Ptr = (Where|&?&nil|)[]
		if (Ptr|uint64| >= debugger.MinPointer)
			return true
		if !Ptr and (self and self is canbenil)
			return true

		if !ptr
			fs <~ "nil"
		  else
			fs <~ "0x"
			fs.AppendHex(Ptr|uint64|)
	
	
	function xtype.TestObjectType (|&nil| Where, |xtype|)
		opt norefcounts
		require cake.Readable(Where, 8)
		|| obj = Where|&object|[]
			require Memory.TestObject(obj)
			|| Mine = obj.Class
			|| ind = mine.Index
			if ind > 0
				|| T = xtype.types[ind-1]
					// if the type is string, and it starts with string... its still a string
					// otherwise we get stringzeroterminated as the typical string type. no fun.
					ifn T.name[0, "string", true] and (T isa self)
						return T
		return self

		
	function SetValue (|!&nil| where, |message| Value)
		opt norefcounts
		require value
		if .Reg
			require cake.Readable(Where, 16)

		expect (self isnt BareStruct)							(value, "Unalterable")

		if .Weird is reference
			where = where|&&nil|[]

		|| C = .Type
		if c and c.IsObject
			return .SetObjectValue(Where|&object|, value)
		return .SetDataValue(Where, value)
	

	function RenderForPrint (|faststring| fs, |?&ivec4| Reg0, |bool| Full, |int| TabTo, |bool| Color)
		opt norefcounts
		if full
			if color
				fs <~ terminalcolor.yellow
			
			|| M = fs.StreamLength
			fs <~ "|"
			.RenderType(fs, nil)
			fs <~ "|"
			fs <~ " "
			fs <~ .name
			fs <~ ": "
			if color
				fs <~ terminalcolor.normal
			if TabTo
				|| Missing = TabTo - (fs.streamlength - M)
				fs <~ (' ', missing)
		
		if reg0
			if color
				fs <~ terminalcolor.red
			|| RefCount = 0
			.RenderValue(fs, reg0 + .reg, RefCount)
			if color
				fs <~ terminalcolor.normal
	
	
	function faststring.DisplayString (|?&byte| Addr, |int| n, |bool|)
		if n < 0
			self <~ "InvalidLength: "
			self <~ N
			return false

		if !addr												// testmem allows nil addr...
			self <~ "nil!"
			return false

		if !n
			self <~ `""`
			return true

		require .TestMem(addr, n, "BadString")					// check string
		
		|VirtualJBString| Skkrt
		Skkrt.Addr = Addr
		Skkrt.Length = n
		if n > 50
			Skkrt.length = (&skkrt)|string|.ByteCountUTF8(50)	// shrink string
		.AppendQuotedEscape((&Skkrt)|string|)
		if n > Skkrt.Length
			self <~ ('.', 3)
		
		return true
	

	function message.DebugRender (|faststring| fs, |bool|)
		opt norefcounts
		|| name = .name
		require fs.testobj(name)

		fs <~ .Type.name
		fs <~ " @ "
		if name isa string
			return true

	// bad class. not a string!
		fs <~ name.class.name
		fs <~ "!"
		return false


	function ParseObj (|object| Old, |string| Value, |object?|)
		|| msg = Value.parse
			|| fn = msg.Type
			if fn.IsString and !msg.HasAny
				rz = msg.name
			  elseif fn == @name
				|| NewType = Syntax(msg.name, msg)
					|message--| ch = msg.first
					if !ch.IsString or ch.HasAny
						ch = nil
					|string--| NewName = ch.Name
					if old isa Message
						old.Type = NewType
						old.name = NewName
						rz = old
					  else
						rz = NewType + NewName
			  elseif (old isa Message)
				if msg.iscontainer and msg == 1 // like (@str) incase i wanna set it to @str
					rz = msg.first


	function SetObjectValue (|!&object| Where, |message| Value)
		opt norefcounts
		|| OldObj = Where[]
			require Memory.TestObject(OldObj)
		
		if value ~= "nil" or "0" or "0x0"
			require self is CanBeNil
			Where[] = nil
			return
	
		|object| NewObj
		if value.name.IsInt
			NewObj = Value.int|object|!
		  else
			NewObj = .ParseObj(OldObj, value.name)$
		
		expect (Memory.TestObject(NewObj)) (value, "Invalid address")
		Where[] = NewObj
	
	
	function SetDataValue (|!&nil| Where, |message| Msg)
		opt norefcounts
		expect (msg.length < 60)						(msg, "SizeOverflow")

		|| W = .Weird
		expect !W.Carray								(msg, "Unwriteable") // surely it should be expanded first?
			
		// pointers can be altered... im sure of it
		// and references just need to be dereferenced...
		// i guess its a pointer TO data. So... just alter the value?
		
		|| T = .DataType
		|| V = t.VecCount
		|| BC = t.ByteCount
		if (bc > 8): bc = 16		

		if w is Pointer
/			bc = 8 // is it not already?

		expect (memory.Writeable(Where, BC))			(msg, "Unwriteable")

		if w is Pointer
			|| mark = StdErr.Mark
			|| addr = msg.int|&byte|							// 0x1234
			require mark == stderr.mark
			require cake.Readable(addr, 8)
			(where|&&byte|)[] = addr
			return
		
		|| value = msg.name

		if v > 1
			|| items = value.parse
				|| fn = items.Type
				expect (fn == @arg or @list or @arr)	(msg)
				|| i = 0
				|| ch = items.first
				while i < v
					if t is Float
						(where|&float|)[i] = ch.Float
					  else
						(where|&int|)[i] = ch.int
					i++
					ch++
					if (i == 3) and (v == 3) and ch
						v = 4							// allow setting last in vec3.
			return
	

		if t is bool
			(Where|&bool|)[] = value.Yes
			
		  elseif t isnt Floating
			if !t.IsSigned and (bc == 1) and !value.IsInt
				if value[] == '\'' and value.Last == '\''
					|| c = value[1]
					(Where|&int8|)[] = c
					return

			|uint64| IntValue = msg.int
			if BC > 4
				(Where|&int64|)[] = intvalue
			  elseif bc == 4
				(Where|&int|)[] = IntValue
			  elseif bc == 2
				(Where|&int16|)[] = IntValue
			  else
				(Where|&int8|)[] = IntValue
				
		  else
			|| ValueFloat = msg.float
			if BC <= 4
				(Where|&float|)[] = ValueFloat
			  else
				(Where|&f64|)[] = ValueFloat
	

	function RenderObject (|faststring| fs, |!&nil| Addr, |$int| RefCount,  |bool|)
		opt norefcounts
		nil self
		require .NilOK(fs, Addr)	
		|| obj = Addr|&object|[]
		if !obj
			fs <~ "nil"
			return true
		
		require fs.TestObj(obj)									// check object is readable and sane

		RefCount = obj.RefCount
		
		if obj isa string or faststring
			|| str = obj|&nil||string|
			return fs.DisplayString(str.addr, str.length)

		if (obj.class == Message) and (obj isa message)			// avoid rendering error as a message
			if self and .viewstrength == 2
				obj.RenderAST(Fs)
				return true

			require obj.DebugRender(fs)
			return obj.saferender(Fs) == 0

		fs <~ "0x"
		fs <~ obj.ObjectID

		|| Renderer = obj.ClassBehaviours[1]
		if Renderer == (Array).Virtuals|&&nil|[1]  or  Renderer == (list).Virtuals|&&nil|[1]
			fs <~ " ("
			if obj isa list
				fs <~ obj.count
			if obj isa Array
				fs <~ obj.length
			fs <~ ")"
		
		  elseif !(obj isa Dictionary)
			fs <~ ":"
			fs <~ (' ', 2)
			if !self or .ViewStrength >= 1
				obj.SafeRender(fs) // might crash...
				// rpg hero not seeing this? we render but nothing comes out
			
		return true
	
	
	function RenderType (|faststring| fs, |xtype?| type)
		opt norefcounts
		.RenderTypeSub(fs, type)
		
		for W in .Weirdness
			loop W
			w >>= 2
			if w
				fs <~ "[$w]"
	
	
	function RenderTypeSub (|faststring| fs, |xtype?| type)
		opt norefcounts
		for W in .Weirdness
			loop W
			if (w is Reference) and (self isnt barestruct)
				fs <~ "$"
			if w is Pointer
				fs <~ "&"
		
		if .flags is CString
			fs <~ "CString"
			return
		
		if .flags is Prototype
			fs <~ "(function)"
			return

		|| C = .type
		if !C and !type
			|| T = .DataType ||| datatypecode.Numeric
			T.Render(Fs)
			return
		
		require C
		if type and type.IsObject
			|| Good = type isa C
			if !good
				fs <~ "!"
			fs <~ type.name
			if !good
				fs <~ "!"
		  else
			fs <~ C.Name
		
	
	function faststring.TestObj (|object| Obj, |bool|)
		return .TestMem(obj|&nil|, -1, "BadObject")
	
	
	function faststring.TestMem (|!&nil| Mem,  |int| N,  |string| ErrName="Unreadable",  |bool|)
		|| Err = memory.Readable(Mem, N)
			return true
		
		if self
			self <~ ErrName
			self <~ ": 0x"
			.AppendHex(Mem|int64|)
	
	
	function RenderValue (|faststring| fs, |!&nil| Where, |$int| RefCount,  |bool|)
		opt norefcounts
		if .Reg
			require fs.TestMem(Where, 16, "BadStack")				// We still need to check for readability, though!

		|| w = .Weird
		if W is Reference								// Barestructs already handled in rendervalue
			|| Ptr = Where|&uint64|[]
			Ptr = (Ptr<<1)>>1										// Clear high bit.
			if !Ptr
				fs <~ "nil"
				return false
			Where = Ptr|&nil|
		
		|| C = .type
		if c and c.IsObject and !W.Pointerlike
			return .RenderObject(fs, Where, RefCount)
		
		if self is BareStruct
			return .RenderBareStruct(Fs, where)						// What about structs in general?

		return .RenderData(fs, Where)

		
	function RenderBareStruct (|faststring| fs, |!&nil| Ptr, |bool|)
		opt norefcounts
		require .NilOK(fs, Ptr)
		|| Where = Ptr|&&nil|[]
		rz = true
		|| Ty = .type
			fs <~ "<"
			|| n = fs.Length
			for (v in ty.Properties) (i)
				loop (n - fs.Length) < 100
				if i > 0
					fs <~ ", "
				|| Prop = Where|&byte| + v.position
				|| Ref = 0
				if !v.RenderValue(fs, prop, ref)
					rz = false
			fs <~ ">"


	function IsObject (|bool|)
		opt norefcounts
		|| t = .Type
			return t.IsObject
	
	
	function RenderData (|faststring| fs, |!&nil| Addr, |bool|)
		opt norefcounts
		|| T = .DataType
		|| V = t.VecCount
		|| BC = t.ByteCount
		if (bc >= 12): bc = 16		
		|| W = .Weird
		|| F = .flags

		if (W.pointerlike) or (F is prototype or f is cstring)
			require .NilOK(fs, addr)
			
			|| Ptr = addr|&&nil|[]|int64|
			if !ptr
				fs <~ "nil"
				return true
			
			if f is CString
				|| len = ptr|cstring|.Length(256)
				if fs.TestMem(ptr|&byte|, len)
					fs <~ '"'
					fs.AppendMemory(ptr|&byte|, len)
					fs <~ '"'
					return true
				return false
			
			fs <~ "0x"
			fs.AppendHex(ptr, 2)
			
			if .Weirdness[1]
				return fs.TestMem(addr, bc)		// dont render pointer to a pointer
			if (f is Prototype) or w.Carray or .isobject
				return true
			addr = ptr|&ivec4|
			fs <~ ": "

		require fs.TestMem(addr, bc)
				
		if t is bool
			fs <~ (addr|&bool|)[].string
		  elseif t isnt Floating
			if v <= 1
				|uint64| Value
				if BC > 4
					value = (addr|&int64|)[]
				  elseif bc == 4
					value = (addr|&int|)[]
				  elseif bc == 2
					value = (addr|&int16|)[]
				  else
					value = (addr|&int8|)[]
				
				|| sh = 64 - (bc*8)
				if !t.IsSigned and (sh > 0)							// unnecessary??
					value = (value << sh) >> sh						// remove later

				ifn value and (bc == 1) and !t.IsSigned
					fs.AppendDecimal(value)

				  else
					fs <~ "0x"
					fs.AppendHex(value)
					fs <~ " "

					if Value|byte|.isprintable
						|| Container = '\''
						if value == Container
							Container = '"'
						fs <~ Container
						fs <~ value|byte|
						fs <~ Container
									
			  elseif v == 2
				fs <~ (addr|&ivec2|)[]
			  elseif v == 3
				fs <~ (addr|&ivec3|)[]
			  elseif v == 4
				fs <~ (addr|&ivec4|)[]
		  else
			if v <= 1
				if BC <= 4
					fs <~ (addr|&float|)[]
				  else
					fs <~ (addr|&f64|)[]
			  elseif v == 2
				fs <~ (addr|&vec2|)[]
			  elseif v == 3
				fs <~ (addr|&vec3|)[]
			  elseif v == 4
				(addr|&vec4|)[].SmallerVec4Render(fs)

		return true
	
	
function vec4.SmallerVec4Render (|Faststring| fs)
	if self == vec4()
		fs <~ "vec4()"					// fs <~ "0.0,0.0,0.0,0.0" // noisy as hell
	  else
		fs <~ "("
		for i in 4
			|| v = self[i]
				fs <~ v
			  else
				fs <~ "0"
			if i < 3
				fs <~ ", "
		fs <~ ")"


function faststring.EscapeByte (|byte| value)
	opt norefcounts
	if  value > 32  and  value != 9 and 10 and 13
		|| str = jeebox.EscapeStr[value|byte|.render]
			self <~ str
			return
	self <~ value|byte|



function jbin.RenderListObject (|object| Item, |int| i, |bool|)
	|object--[1]| Temp
	Temp[0] = item
	return .RenderListItem((&Temp[0])|&uint64|, i)


function jbin.RenderListItem (|&uint64| Items_, |int| i, |bool|)
	opt norefcounts
	if i >= 10K
		.AddStr("...")
		return true
		
	|| RefCount = 0
	|| name = debugger.VariablePrinter!
	name.Length = 0
	|| Items = Items_|&object|
	if !nil|xvar|.RenderObject(name, Items, RefCount)
		.add(@tmp, "", true)
		.AddStr(name)
		return false
		
	|| item = Items[0]!
	|| C = item.class
	.AddCString(@tmp, C.name, true)		// .class already checked by .RenderObject
	.AddStr(name)
	return true


function message.xvariables (|[xvar]|)
	opt norefcounts
	cpp_part xvar0
	if self
		|xvar[32]| Regs
		.LoadXVars(Regs, rz)


function message.LoadXVars (|?&xvar| Registers, |[xvar]| out)
	opt norefcounts
	cpp_part xvar
	|| input = xtype.shared
	input.Reset(.name)

	while (|| Section = input.byte)
		|| StartPos = input.Position
		|| ReadEnd = StartPos + Section
		|| Pos = Input.hint|int|
		|| Reg = Input.hint|int|
		|| OK = !Reg
		if registers
			OK = (reg-1)|uint| < 31
		
		
		if input.Position >= ReadEnd
			#!Close Register
			expect (OK)									(self, "CloseOutRange: "	+ reg)
			expect (Registers)							(self, "BadRegClose: "		+ reg)
			|| r = Registers[reg]			#expect		(self, "BadRegClose: "		+ reg)
			R.CodeEnd = pos
		  else
			expect (OK) (self, "OpenOutRange: " + reg)
			|| var = xvar(input, pos, reg, ReadEnd)
			if Registers
				Registers[reg] = var
			out <~ var

		expect (input.position == ReadEnd)				(self, "Corrupted debug vars")
	

