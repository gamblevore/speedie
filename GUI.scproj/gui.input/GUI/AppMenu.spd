


// No need to have a whole class just for this.
role AppMenu (Window)
	linkage:	cpp_Part AM

	constructor
		super.constructor
		is visible
		isnt drawsfocus
		.id	= "AppMenu"
		.ClickOutsideCloses = true
		.OnKeyDown = menukeydown|GUIKeyEvent|
		
		|| LV = ListView(self,	nil,	MenuReturnkey)
		lv.id = "AppMenu"
		.gnormal.edge = (0.5, 0.0, 1.0, 0.5).px
		lv.gnormal = ¥.Menus
		lv.gRowSel = ¥.MenuRowSel

		lv <~ ("About " + app.filename,		MenuAbout)
		lv.addsep
		lv <~ ("FullScreen",				MenuFullScreen)
		lv <~ ("Help",						MenuHelp)
		lv <~ ("Quit",						MenuQuit)

		.setfocus


	libinternal MenuKeyDown (GUIKeyEvent)
		require key is escape
		.cancelreturn
		Choices().selectnone
		return true


	function ShowAsDialog
		|| c = AppMenu.Choices!
		|| n = c.listsource.Count
		|| mh = n * c.rowheight + 4
		.size = 160~wide by (mh)~high
		c.size = the~area
		c.selectfirst
		
		|| p = (self)()
		if p isa menuitem
			c.selectnone
			(p.MenuEvent)(self, p, nil)?


	module
		|AppMenu|	Menu
		libinternal Choices (|ListView!|)
			opt norefcounts
			.GetAppMenu
			return .menu["AppMenu"]|&nil||listview|!

		function SyntaxAppend (|string| name="", |guimenuevent| ev=nil)
			opt norefcounts
			|| where = .Choices!.listsource.second
				where.next = menuitem(name, ev)

		libinternal GetAppMenu (|appmenu!|)
			opt norefcounts
			rz = .menu
			if !rz
				rz = appmenu()
				.menu = rz
				rz.hide

		libinternal Show (|int|)
			|| m = .GetAppMenu
			.choices.setfocus
			m.ShowAsDialog
			return GUIActivity.activity


		libinternal MenuHelp (GuiMenuEvent)
			|| it = app.Conf("HelpURL")
				app.showurl(it)
				return 
			if self isa listview
				.RemoveRow(menu)
			beep "No help available."
		
		
		libinternal MenuQuit (GuiMenuEvent)
			GUI.QuitReason |= GUIActivity.exiting
		
		
		libinternal MenuFullScreen (GuiMenuEvent)
			gui.FullScreen(true) = (!gui.IsFullScreen)|int|


		libinternal MenuReturnkey (GuiListEvent)
			(.window as appmenu)!.ReturnValue = .FirstSelected
			return true
		
		
		libinternal MenuAbout (GuiMenuEvent)
			|| aboutstr = app.Conf("about")
			if !aboutstr
				aboutstr = `$appname v$version`
			aboutstr = aboutstr.ReplaceAll(`$appname`, app.filename)
			aboutstr = aboutstr.ReplaceAll(`$version`, app.Conf("version"))

			// this is a lot of complexity...
			// maybe easier to let them manually write it themself.
			// perhaps an "about string" generated by the compiler
			// just like we have a usage string?

			// or perhaps the conf can have the string replacement done at that level?

			aboutstr = aboutstr.ReplaceAll(`$creator`, app.Conf("creator"))
			|| T = __time_id__
			|| N = __now__
			aboutstr = aboutstr.ReplaceAll(`$apptime`, T.render)
			aboutstr = aboutstr.ReplaceAll(`$appdate`, N.localtime)

			app.alert aboutstr


