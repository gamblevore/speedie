

function image.RoundRectDrawer (ImageDrawStyleEvent)
	require Edges is open
	|| Col = g.bg.PreMul
	|| Edge = g.edge.Color
	|| center = rect.CenterVec2
	center.y -= 0.5

	|| CS = G.CornerSize|float| * 0.25 + 1.0
	|| LW = g.EdgeWidth|float| * 0.5
	|| Lim1 = (CS-LW).pow2
	|| Lim2 = (CS+LW).pow2
	|| Conv = math.RangeConvert(lim2, lim1)
	|| SubX = center.x - (rect.x|float| + CS)
	|| SubY = center.y - (rect.y|float| + CS)
	
	rect = .Clip(rect)
	for Y in rect.Vert
		|| Y2 = (Y|float| - center.y).length.minus0(suby).Pow2
		|| W = self[rect.x, Y]
		for X in rect.Horz
			|| X2 = (X|float| - center.x).length.minus0(subx).pow2
			|| D2 = X2 + Y2
			
			if D2 <= lim1
				w.Overlay(Col)
			  elseif D2 <= Lim2
				|| E = Edge
				E.a *= Conv.Convert(d2)
				w.Overlay(E.premul)
			W++


function image.ClippedRectDrawer (ImageDrawStyleEvent)
	require Edges is open
	rect.y2-- // seems to draw too high? not sure why.
	|| Col = g.bg.PreMul
	|| Edge = g.edge.Color.PreMul
	|| Lim = (G.CornerSize|float| * 0.5 + 1.0)|int|
	|| center = rect.Center
	|| Active = g.CornersCut

	for Y in rect.Vert
		|| W = self[rect.x, Y]
		|| YCorner = (y >= center.y)
		for X in rect.Horz
			|| D = rect.DistToCorner((X,Y))
			|| DS = d.sum
			|| XCorner = (x >= center.x)
			|| Corner = 1 << (XCorner+(YCorner<<1))
			ifn (Corner) & Active
				if !d.x or !d.y
					w.Overlay(Edge)
				  else
					w.overlay(col)
			  elseif DS >= lim
				if (DS == Lim) or (!d.x or !d.y)
					w.Overlay(Edge)
				  else
					w.Overlay(Col)

			W++



extend_module Image
	|image| CurlieQue_
	function CurlieQue (|image|)
		|| c = .Curlieque_
			return c
		c = ( img://curlieque.png ).LoadQOI #require
		c.Rotate(c)
		.Curlieque_ = c
		return c


function image.CurlieQueDrawer (ImageDrawStyleEvent)
	opt norefcounts
	|| BG = g.bg.PreMul
	|| Edge = g.edge.Color.PreMul
	|| Nothing = vec4(0).PreMul
	|| Q = image.CurlieQue
	
	for Y in rect.Vert
		|| W = self[rect.x, Y]
		for X in rect.Horz
			|| D = rect.DistToCorner((X,Y)).abs
			if 16 > d.x and d.y			
				if q and Q[D].r > 128 // white
					w.overlay(edge)
				  elseif edges is OPEN
					if (d.x+d.y) >= 2
						w.overlay(bg)
					  else
						w.overlay(nothing)
			  elseif !d.x or !d.y
				w.overlay(edge)
			  elseif edges is OPEN
				w.overlay(bg)

			W++



libinternal ivec4.FollowEdge (|int64| Progress, |ivec2|)
	|| x = .x
	|| y = .y
	|| w = .Width
	|| h = .Height
	|| C = w*2 + h*2
	if Progress < 0
		progress += ((progress / -C)+1)*C
	|int| P = Progress mod c
	if P <= h
		return (0+x, p+y)
	p -= h
	if p <= w
		return (p+x, h+y)
	p -= w
	if p <= h
		return (w+x, (h+y)-p)
	p -= h
	return ((w+x)-p, 0+y)


function image.ActiveEdges (ImageDrawStyleEvent)
	opt norefcounts
	
	|| P = gui.framestart / 600
	|| Edge = ((Rect.Width*2 + rect.Height*2) - 4)|float|
	|| iLineCount = 1.0/math.phi
	|| sub = 0.75 / (edge*iLineCount)
	|| A = 0.0
	|| Reset = 0.0
	|| H = 0.0
	
	for Edge
		if reset <= 0
			reset = iLineCount*edge
			A = iLineCount*0.75
		
		|| Curr = rect.FollowEdge(P)
		|| Col = Colors.rainbow(H, 0.625, 1.0, A*2).PreMul
		self[Curr].overlay(col)
		A -= sub
		reset--
		p--
		H += 0.005
	
	if !gui.IsBackground
		gui.Touch
	

libinternal ivec4.DistToCorner (|ivec2| xy, |ivec2|)
	return (xy - .x1y1)  min  (.x2y2 - xy)


		
