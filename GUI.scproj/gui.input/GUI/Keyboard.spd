datatype GUIKeyRecordInfo (byte)
	constants
		|GUIKeyRecordInfo|
		Empty		= 0
		ToRemove	= 1
		ToAdd		= 2
		NewlyAdded	= 3
		Stable		= 4


struct GUIKeyRecord
	|date|	Date
	|keys|	Key
	|GUIKeyRecordInfo| State

	function IsEaten (|bool|)
		return self and !.date and .key!=nil
		
	inline Clear
		.date = nil
		.key = nil
		.state = nil
	
	inline Eat
		if self
			.date = nil
		
	
	syntax is (|GUIKeyRecordInfo| V, |bool|)
		inlined
		return .state == v


