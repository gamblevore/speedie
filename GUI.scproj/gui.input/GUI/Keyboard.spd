


dataType SDL_Scancode (int)
	linkage
		wrapper
		cpp_part Scan
	
	function Key (|keys|)
		cpp_wrapper SDL_GetKeyFromScancode



datatype KeyModifier (int)
	linkage
		cpp_part KM
	// if I'm bored and drunk enough one day I can merge key with keymodifier haha.
	// function key.syntaxequals (|key| x, |bool| aware, |bool|)
	//     if aware: return x<<5==self<<5
	// whatever...
	
	flags
		Shift
		Option
		Control
		Command
		
	syntax is (|keymodifier| Mod, |bool|)
		inlined
		return self & mod
	
	module
		function Collect (|keymodifier|)
			rz |= Command*keys.cmd
			rz |= Control*keys.ctrl
			rz |= shift*keys.shift
			rz |= option*keys.option




struct SDL_KeyboardEvent
	linkage: wrapper
	|SDLEventType|				Type
	|uint|						Timestamp
	|SDL_Keysym|				keysym
	
	function Scan (|SDL_Scancode|)
		inlined
		return .keysym.scancode

	function Key (|keys|)
		inlined
		return .keysym.sym

	syntax is (|keys| x, |bool|)
		inlined
		return .key == x



struct SDL_Keysym
	linkage
		wrapper
		cpp_part KS
	|SDL_Scancode|	scancode		/* SDL physical key code - see ::SDL_Scancode for details */
	|keys|			sym				/* SDL virtual key code - see ::SDL_Keycode for details */
	|Uint16|		mod				/* current key modifiers */
	|Uint|			unused

	inline Command (|bool|)
		return .mod & (1024|||64|||128|||2048)
	



dataType Keys (int)
	linkage
		wrapper
		cpp_class SDL_Keycode
		cpp_part Key
	

	libinternal Record (|&guikeyrecord|)
		if self != 0
			for i in keys.MaxKeyRecord
				|| g = keys.record[i]
				if g.key == self
					return g

	function Name (|string|)
		if .IsShift
			return "shift"
		if .IsCmd
			return "cmd"
		if .IsCtrl
			return "ctrl"
		if .IsOption
			return "opt"
		if self < 128
			return self|byte|.Render
		
	libinternal Limit
		|| r = .record
			if r.date
				r.date = gui.FrameStart

	function HeldKey (|duration| durr=0.05s, |bool|)
		|| r = .Record
			return r.date.guiago >= durr
	
	function Number (|ind|)
		|uint| x = self-num0
		if x > 9
			x = -1
		return x
		
	function IsFirstFrame (|bool|)
		|| r = .Record
			return r.date and r is NewlyAdded
	
	
	function Length (|int| Plus,  |float| Limit,  |float|)
		require Plus
		|| i = .record						#require
		|| D = i.date						#require
		|| G = gui.FrameStart
		rz = (((1+G)-D)*plus).float
		if limit and i.State == guikeyrecordinfo.Stable
			if rz.length > limit
				i.date = G
			  else
				rz = 0

	function IsAccept (|bool|)
		return (self is RETURN or RETURN2 or Enter or AC_FORWARD)
	
	operator IsCmd (|keys| s, |bool|)
		return keys.cmd and self == s

	function IsCMM  (|bool| shift=false, |bool|)
		if shift == (keys.shift or keys.option)
			return self is MacBacktick or backtick or APPLICATION or slash

	function IsModifier (|bool|)
		return (self is lgui or rgui or lctrl or rctrl or lalt or ralt or lshift or rshift)

	function IsCancel (|bool|)
		return (self is cancel_key or escape)

	function IsDelete (|bool|)
		return self is ForwardDELETE or DELETE or KP_DELETE

	function IsShift (|bool|)
		return self is lshift or rshift
		
	function IsScan (|bool|)
		return ((1<<30) & self)!=0

	function IsOption (|bool|)
		return self is lalt or ralt
	
	function IsCmd (|bool|)
		return self is lgui or rgui

	function IsCtrl (|bool|)
		return self is LCTRL or RCTRL

	syntax access (|bool|)
		|| i = .record
		if i and i.date and i.state >= guikeyrecordinfo.newlyadded
			return true

	syntax cast (|bool|)
		disabled "Use [] to test keydown. Use != 0 to test key is real"

	syntax is (|keys| x, |bool|)
		inlined
		return self == x
	
	module
		|bool|					Debug = true
		|GUIKeyRecord[6]|		Record

		
		libinternal KeysVs (|keys| pa, |keys| pb,  |keys| ma, |keys| mb, |float| Limit,  |float|)
			|| P = pa._ago(pb)
			|| M = ma._ago(mb)
			if P and M
				return 0
			
			if M
				P = -M
			|| Str = P.float
			if !Limit or (p & 1) // first frame
				return str
			
			if str.length >= limit
				pa.limit
				pb.limit
				ma.limit
				mb.limit
				return str
		
		
		libinternal keys._ago (|keys| O, |duration|)
			|| a = .record
			|| b = o.record
			if a and b and b.date < a.date
				a = b
			if a
				rz = a.date.GuiAgo + 2
				rz.trip = a is newlyadded
		
		
		libinternal Date.Trip (assigns:|bool| B, |date|)
			return (self &~ 1) ||| B
		
		
		function Movement (|vec4| Limiter=vec4(), |vec4|)
			rz[0] = .KeysVs(d,right,	a,		left,	limiter[0])
			rz[1] = .KeysVs(space, 0,	LCTRL,	RCTRL,	limiter[1])
			rz[2] = .KeysVs(w,up,		s,		down,	limiter[2])
			rz[3] = .KeysVs(e, 0,		q,		0,		limiter[3])
			// can get into a wierd state where s[] or w[]
			// get buggered and it thinks it is up when
			// its down. Not sure why. the problem isnt here.
			// we need to figure out what or where releaseed
			// w[] or s[] or didn't add them.
			// this probably affects everything, even typing
		
				
		libinternal ResetKeyboard		()
			cpp_wrapper SDL_ResetKeyboard
		
		function State (|?&int| n, |&byte|)
			cpp_wrapper SDL_GetKeyboardState
		
		libinternal Count (|int|)
			disabled "Keys can be disparate"

		function Reset
			for i in MaxKeyRecord
				|| r = .Record[i]
				if !r.IsEaten
					r.Clear

		libinternal EmptySlot (|keys| Key, |&guikeyrecord|)
			if key != 0
				for i in MaxKeyRecord
					|| r = .Record[i]
					if r.key == 0
						rz = r
					if r.Key == key // nooooo. this is bad
						return r	// let it be-readded.


		libinternal AddKey (|keys| Key)
			|| r = .EmptySlot(key)
			if  !r  or  r.key == key  and  r.state >=  GUIKeyRecordInfo.ToAdd
				return
				
			r.key = key
			r.date = GUI.FrameStart
			r.state = GUIKeyRecordInfo.ToAdd + (key is escape)		// escape starts as "newly added"
					
		
		libinternal RemoveKey (|keys| Key)
			|| r = key.record
				r.State = guiKeyRecordInfo.ToRemove
		
		
		function keys.Scan (|SDL_Scancode|)
			// 512 max I think.
			cpp_wrapper SDL_GetScancodeFromKey

	
		libinternal FlushKeys
			|int[1]| MaxScanCodes_						// C++ bug
			|| Buff = .state(MaxScanCodes_)|&byte|
			|| MaxBuff = 512 min MaxScanCodes_[0]
			for i in MaxKeyRecord
				|| r = .record[i]
				|| k = r.key
				if k != 0
					|| scan = k.Scan					// SDL dangling key bug work around.
					if (scan < MaxBuff) and !buff[Scan]
						r.clear
				
				|| s = r.state
					if s == guikeyrecordinfo.ToRemove
						r.clear
					  elseif s < guikeyrecordinfo.Stable
						r.state = s + 1


		libinternal FindTwoModifiers (|keys| A, |keys| B, |&guikeyrecord|)
			for i in MaxKeyRecord
				|| r = .Record[i]
				if r.State >= GUIKeyRecordInfo.ToAdd //
					|| k = r.Key
					if k == A or B
						return r


		function Ctrl (|bool|)
			return .FindTwoModifiers(lctrl, rctrl)


		function Cmd (|bool|)
			target osx
				if .gui
					return true
			return .ctrl
		
		
		function GUI (|bool|)
			return .FindTwoModifiers(lgui, rgui)


		function PlatCmd (|bool| Yes=true,|bool|)
			|| OSX = true
			target !osx
				OSX = false
			if OSX==yes
				return .gui
			return .ctrl


		function Shift (|bool|)
			return .FindTwoModifiers(lshift, rshift)


		function Cancel (|bool|)
			return .FindTwoModifiers(cancel_key, escape) // ac_back too?


		function Option (|bool|)
			return .FindTwoModifiers(lalt, ralt)


	constants
		MaxKeyRecord = 6
	
	

