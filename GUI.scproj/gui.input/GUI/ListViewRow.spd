


role ListViewRow (message)
	linkage
		cpp_part Row
	contains ListViewRow
	constructor
		super.Constructor(@arg, "")
		is editable
		
	constructor (|string?| name=nil, |ListViewState| state = ListViewState.editable)
		cpp_part Named
		super.Constructor(@arg, name)
		.tag = state

	function State (|ListViewState|)
		inlined
		return .tag

	function State (assigns:|ListViewState|)
		inlined
		.tag = value

	syntax is (|ListViewState| s, |bool|)
		inlined
		if self
			return .tag & s

	syntax is (|ListViewState| s, assigns:|bool| b)
		|| t = .tag
		|| t2 = (t &~ s) ||| (s*b)
		if t2 != t
			.tag = t2
			gui.touch


	libinternal ListView.HierEnd (|listviewrow| row, |listviewrow|)
		opt norefcounts
		rz = row
		|| root = .ListSource
		|| h = ._Hierarchical
		while (rz is expanded) or (rz == root)
			|| try = rz.last
			if (h is last) and (rz!=root)
				try = try.last
			loop try
			rz = try
			


	libinternal ListView.HierPrev (|listviewrow| Row, |listviewrow|)
		opt norefcounts
		|| root = .ListSource
		|| p = row.Prev
			return .hierend(p)
		if ._hierarchical is last
			row = row.parent
			if row == root
				return nil
		p = row.parent
		if p == root
			p = nil
		return p


	libinternal listview.HierNext (|listviewrow| Row, |listviewrow|)
		opt norefcounts		// ListViewHierarchy isnt so easy to get working...
		if (row is expanded) or (row == .listsource)
			if ._hierarchical is Last
				row = row.last
			return row.flatnext
		return row.next ?? row.flatafter
	

	function NextSelected (||)
		opt norefcounts
		|| f = .next
		while f
			if f is selected
				return f
			f = f.next


	libinternal DrawSep (|ivec4| rect, |image| Where, |float| Str=1)
		opt norefcounts
		|| y = (rect.y + rect.y2+1)/2
		rect = (rect.x+1, y, rect.x2, y+1)
		|| v = (1.0, 1.0, 1.0, 0.25*str)
		|| A = v.px
		where.DrawRect(Rect, A) 
	
	
	libinternal DrawLineAcross (|ivec4| z2, |image| Where, |int| i, |uint| Skips)
		opt NoRefCounts
		require (self isnt disabled) and (.prev isnt disabled)
		|| Vis	= (1<<i)&Skips
			Where.MarkLineH(z2.x1y2, z2.width, 1)


	libinternal DrawLineUpwards (|ivec4| z2, |image| Where)
		Where.MarkLineV(z2.x1y2,		z2.height, 1)
		Where.MarkLineV(z2.x2y2+(1,0),	z2.height, 1)

	
	libinternal ListRowDraw (|image| Where, |ivec4| Rect, |ListView| Owner, |int| indent_depth, |int| N)
		opt NoRefCounts
		|| w	= Owner.window	
		|| z2	= rect
		|| str = 1.0

		|| Skips = ~Owner.CalculateRowSkip(self, N)
		for i in n
			rect.horz	= Owner.ColumnBounds(i, z2, self)
			rect.x		+= indent_depth
			where.ControlClip = rect.clip(Owner.lastrect)
			.DrawCellInsides(rect, where,  Owner, i, str, (1<<i)&Skips != 0)
		
		where.controlclip = z2
		
		if self is active
			where.horz	= z2.h
			where.DrawCircleStyled( z2 + (4,0,-4,0), ¥.WhiteStyle, 1.0)
		
		if self is Error
			|| c = vec4(1.0, 0.25, 0.125, 0.2)
			where.DrawRect(z2, c)

		if (self is Disabled) and !.Name
			|| c = vec4(0.5)
			c.a = 0.25
			|| z3 = z2
			|| y = (z3.y + z3.y2)/2
			z3.y = y - 1
			z3.y2 = y
			where.DrawRect(z3, c)
		
		if self is found
			z2 += (0, 1, 0, 0)
			z2.y2 = z2.y + 2
			|| edge = ¥.textselection.edge
			edge.Alpha *= str
			where.DrawRect(z2, edge)
	
	
	libinternal CellOrRow (|ListView| Parent, |int| Column, |string|)
		opt norefcounts

		|| Cols = parent.columns
		if cols == self
			return self[column].name
		if (Cols == nil) or (parent._Hierarchical is Hierarchical)
			column = -1
		return parent.TableCell(self, column)
	
	
	libinternal DrawCellInsides (|ivec4| rect, |image| Where, |ListView| Parent, |int| Column, |float| str, |bool| CanDraw)
		opt NoRefCounts

		require CanDraw or parent.OnDrawRow
		
		|| CellText = .CellOrRow(parent, column)
		if !CellText and (self is Separator)
			.DrawSep(Rect, where, str)
			return
		
		|| R		= Rect.TextCorner(parent.GNormal, CellText, .state)
		|| sighy	= ((rect.y + rect.y2)/2) - 3
		|| TextCol	= parent.GNormal.TextColor
		
		|| Shader = parent.OnDrawRow
			|| Shading = (Shader)(self, Rect.y1, sighy, where, parent, column, str) // why would y get adjusted??
			r.x += shading.x
			|imagepixel| Col = Shading.y
				textcol = Col
		
		  elseif (Column==0) and parent.Hierarchical and (self!=parent.Columns)
			if parent.CanExpand(self)
				|| exp = (self isnt expanded)("\02", "\03")
				|| VCol = vec4(1, 0.5)
				font.small!.DrawTextWrap(exp, Where, R - (2,-1), VCol, parent.LineHeight)
			r.x += font.width + 2
		
		if CanDraw
			if parent.MultiLineDraw
				r.y = rect.y2 - 10
			if self is Disabled
				str *= 0.375
			TextCol.alpha *= str
			font.small!.DrawTextWrap(CellText, Where, R, Textcol, parent.LineHeight)
	

	libinternal listview.CanExpand (|listviewrow| Row, |bool|)
		opt norefcounts
		if row.last == @arg
			return true // Right? even if its empty.
						// Cos we need some way to ask a server/process for open a folder
		if .ListChild(row)
			return true // also
	
	
	module
		function NewSeparator (|int| Pos = 0, |listviewrow|)
			opt norefcounts
			rz = @str + ""
			rz.Position = Pos
			(rz is separator)
			



datatype ListViewState (uint16)
	flags
		|ListViewState|
		AlignLeft	= 0
		Align		= [AlignCenter, AlignRight]
		Selected
		Modified

		UnSelectable = [Separator, Disabled]
		Broken		// we tried to use the item but it failed. maybe replace with "Missing"?
		Error		// something is definitely wrong
		Preparing
		Active

		Editable
		Expanded
		Found
		
		Hidden
		
	syntax is (|ListViewState| s, |bool|)
		(Hidden)
		inlined
		return self & s



datatype ListViewSelectMode (uint)
	linkage
		numeric false
	flags
		|ListViewSelectMode|
		InitialSelection
		NoShow
		NoEvent
		SendEvent
		
		Normal = 0
		Expanded = 1

	
	syntax is (|ListViewSelectMode| s, |bool|)
		inlined
		return (self|uint| & s|uint|) == s



datatype ListViewHierarchy (int8)
	constants
		Flat = 0
		Hierarchical = -1		// a normal tree, we are the container.
		Last = -2
								

	syntax is (|ListViewHierarchy| s, |bool|)
		inlined
		return self == s



extend ListView
	inline Hierarchical (|bool|)
		return ._Hierarchical
	
	setter Hierarchical (|bool|)
		inlined
		cpp_part HierBool
		._Hierarchical = -value|int|

	setter Hierarchical (|listviewhierarchy|)
		inlined
		._Hierarchical = value
	
	libinternal HierStep (|ListViewrow| l,  |bool| Forward, |listviewrow| Within=nil, |ListViewrow|)
		opt norefcounts

		|| H = ._Hierarchical
		if !H
			if Forward
				return l.next
			  else
				return l.prev

		Within ?= .ListSource
		|| Found = (Forward)(.hiernext(l), .hierprev(l))		
		if Within contains Found
			return Found

