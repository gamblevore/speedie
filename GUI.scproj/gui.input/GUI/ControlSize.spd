


//struct ControlSize
//	linkage
//		cpp_part csiz
//		datatype true
//	|controlrect|				GSize
//	
	// would be nice to be able to remove this struct.
	function ControlRect.CalculateSize (|ivec4| Parent, |ivec4| Prev, |ivec4| Window, |guicontrol| upon, |ivec4|)
		|| UseBlocks = upon is blocksized
			|| V = .vec4 * 16th
			return V.Screen

//		|| dbg = upon.clipmode is debug
//			"---------------"
		window = window ± upon.Padding
		|| PS = parent.size
		for i in 4
			|| sz = .length(i)
			|| m = .Mode(i)
			if m <= ControlPoint.Centered
				|int| d = (m&2) + (i&1)
				if m ==	ControlPoint.Low or ControlPoint.High
					d = parent[d]
				  elseif m == ControlPoint.Before or ControlPoint.After
					d = Prev[d]
				  elseif m == ControlPoint.Centered
					d = PS[i&1]>>1
				rz[i] = d + sz
//				if dbg
//					.PrintExplain(i, d, rz)
//			  elseif m == controlpoint.Percent // ~pc
//				rz[i] = ((Sz * PS[i&1]) / (64K*100)) + parent[i&1]
//				if dbg
//					.PrintExplain(i, 0, rz)
		
		if 1234 { // find the length. Could be sliding.
			|| E = upon.FindAttachedEdge.flip
			for i in 4
				if .mode(i) == ControlPoint.Length
					|| other = i xor 2
					|| ro = rz[other]
					|| sz = .length(i)
					
					sz = upon.Transition(sz, i, e)
					rz[i] = ro + (sz * (i>=2).dir)
	//				if dbg
	//					.PrintExplain(i, ro, rz)
		}
		
		if upon.ClipMode is SlideBackInParent
			|| rz2 = rz.Bound(parent)
//			if dbg
//				.ExplainBound(rz, rz2)
			rz = rz2
		
		if upon.ClipMode is SlideBackInWindow
			|| rz2 = rz.Bound(window)
			rz2 = rz2.boundclip(window) // in case parent goes outside window
//			if dbg
//				.ExplainBound(rz, rz2)
			rz = rz2
	
	
