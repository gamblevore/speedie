

datatype MouseDragging (byte)
	constants
		Ignored			= 0
		Eaten			= 1<<1
		Flags			= 7

		Handled			= 1<<4
		DragWithin		= 2<<4
		DragBeyond		= 3<<4
		DragEvenIfStill	= 4<<4



datatype SystemCursor (uint)
	linkage
		wrapper
		cpp_class SystemCursor
	
	constants
		|SystemCursor|
		Arrow		// arrow
		IBeam		// i-beam
		Wait		// wait
		CrossHair	// crosshair
		WaitArrow	// small wait cursor (or wait if not available)
		SizeNWSE	// double arrow northwest and southeast
		SizeNESW	// double arrow northeast and southwest
		SizeWE		// double arrow west and east
		SizeNS		// double arrow north and south
		SizeAll		// four pointed arrow pointing north, south, east, and west
		No			// slashed circle or crossbones
		Hand		// hand
	
	function Use
		require self <= hand
		SystemCursor.Curr = self
		(_Cursors[self] init .create).use

	libinternal Create (|!&SDL_Cursor|)
		cpp_wrapper JB_CreateSystemCursor

	module
		|byte|				Curr
		|(&SDL_Cursor)[12]| _Cursors
		|&SDL_Cursor|		_Empty
				
		autogen Show (|int| show=-1, |int|)
			cpp_wrapper SDL_ShowCursor
			
		function Create (|&byte| data, |&byte| mask, |int| w, |int| h, |int| hot_x, |int| hot_y, |&SDL_Cursor|)
			cpp_wrapper SDL_CreateCursor

		libinternal Empty (|!&SDL_Cursor|)
			|byte[1]|			Nothing
			return ._empty  init  Create(&nothing[0], &nothing[0], 1, 1, 0, 0)


struct SDL_Cursor
	linkage
		wrapper

	libinternal Use
		cpp_wrapper SDL_SetCursor
	
