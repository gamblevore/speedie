#!/usr/local/bin/spd

// press command-R to run this app.

main (|int| amount)	
	require "/usr/bin/say".file.MustExist("speak")
	
	if amount > 10
		app.say "$amount ??"
		app.say("thats too many bananas")
		return 0
	if amount <= 0
		app.say("you don't like bananas?")
		return 0
	
	for count in 0 to Amount
		app.say count of "banana"
	app.say "bye"




// This is the config area. Used here just to make the example more fun!
// Upon pressing command-R in perry, perry will ask the question below:

conf
	perry_args "args\n\t'how many bananas'?"

