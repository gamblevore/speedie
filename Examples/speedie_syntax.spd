#!/usr/local/bin/cake

// Tests a lot of different syntax and features in one project.
// doesnt really actually do anything useful otherwise.

targets: flow

main
	ObjRenderTest()
	|object[10]| Objs
	|&object| ObjPtr = &Objs[0]
	for i in 10
		Objs[i] = "abc" + i

/	ByteCountTest(DataTypeCode.byte, DataTypeCode.float)
	ByteCountTest(DataTypeCode.uint16, DataTypeCode.f64)
	app.TestSyntax



class Person
	|int| age
	|string| name
	setter Age (|int|)
		ifn (value > 0 and value < 300)
			|| str = "Age $value out of range on ${.name}"
			printline str
			return
			
		.age = value
	
	render
		fs <~ "$.name's age is $.age"



function PrintNum (|int64| b1)
	"${B1.strsize} = $B1"



function ByteCountTest (|DataTypeCode| A, |DataTypeCode| B)
	opt noinline
	|| AC = A.ByteCount
	|| BC = B.ByteCount
	printline "Datatype ${A.render} has $AC bytes"
	printline "Datatype ${B.render} has $BC bytes"


function app.TestSyntax
	printnum(60GB)
	printnum(7.9MB|int|)
	printnum(9524600)

	|| D = ["abc":"def", "def":"ghi"]
	printline D
	
	|| P = person(12, "fred")
	P.age = -2 // try to corrupt the age
	"$p" // see if it worked or not?
	|| x = ["a", "b", "c"]
	if x == 3
		"$x has three items."
		x <~ "d"
	
	|| H = "house".file
	if H == 5
		"'$H' has five letters"
	|| L = "(aaaaa,bbbbb,ccccc,ddddd,eeeee,fffff,ggggg,hhhhh,iiiii,jjjjj,kkkkk,aaaaa,bbbbb,ccccc,ddddd,eeeee,fffff,ggggg,hhhhh,iiiii,jjjjj,kkkkk,aaaaa,bbbbb,ccccc,ddddd,eeeee,fffff,ggggg,hhhhh,iiiii,jjjjj,kkkkk)".parse
	if L == 4
		"The list $L has four items!"
	(x)
	
	|| zz = 0
	for i in 1 to 6
		if i isa 2
			"$i is even"
			zz[i] = true
		  else
			zz++
			zz--
			"$i is odd"
	"zz is $zz"

	FlowLog.disable
	for i in 4
		|| fn = (0.5[])(mesayer, shesayer)
		(fn)("hello")
	Flowlog.enable
	FunctionPointers()


function ObjRenderTest
	|| err = Error.new(nil, "im ok!", nil, "anywhere")
/	|| G = RPGHero("fred")
//	printline g.__Render__

	|| R = []
	R <~ R						// put an array into itself
	printline r					// seems to survive!

	printline err
	|| proc = UnixProcess("abc")
/	printline proc
	(proc)
	(err)
	(r)
	(g)


function FunctionPointers (|fn_doaction!|)
	opt norefcounts
	|| G = RPGHero("fred")
	|dictionary of fn_doaction| EmptyDict
	|| x = EmptyDict["hello"]
		(x[])(G, "no reason")		// will never run
	printline DoAction.Render
	|| j = DoAction["jump"]
		j[](G, "hes scared")
	if x
		return x[]
	return DoAction_duck


prototype SayerFunction (|string?| input)

function MeSayer (SayerFunction): "Me says: $input"

function SheSayer (SayerFunction): "Rebecca says: $input (very quietly)"


class RPGHero // for a tile-based board game
	|string|	Name
	|bool|		OnGround
	|bool|		IsDucking
	|int|		YSpeed
	|int|		GroundSpeed

	constructor (|string| name)
		.OnGround = true
		.IsDucking = false
		.name = name
	
	render
		fs <~ .Name
		fs <~ " (currently "
		if .IsDucking
			fs <~ "ducking, "
		if .GroundSpeed
			fs <~ "moving at $.groundspeed, "
		if .OnGround
			fs <~ "onground, "
		if .YSpeed > 0
			fs <~ "jumping"
		fs <~ ")"
		


dispatch DoAction (|rpghero|self, |string| Reason)
	jump
		"$.Name jumped because $Reason"
		if .OnGround
			.YSpeed = (.YSpeed max 0) + 2 
			.IsDucking = false

	run
		"$.Name ran because $Reason"
		.GroundSpeed = .GroundSpeed min 5
		.IsDucking = false

	duck
		if !.isducking
			"$.Name ducked because $Reason"
			.IsDucking = true


