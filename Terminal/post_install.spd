#!/usr/local/bin/spd

|| Spd = file.SpeedieDir
|| SpdTerm = spd.child("Terminal/Speedie")
|| User = app.BaseUser
|string| CreationType
|[string]| FilesMade
|[string]| FailedLinks
|bool| PrintMake

main
	.MadeFile(SpdTerm, "Compiler")
	.LetsGo
	if StdErr.ok
		app <~ "Success!"
		
	.TwoLinesPrint(FilesMade, 60, "Files Created")
	if FailedLinks
		.TwoLinesPrint(FailedLinks, 30, "SymLinks Failed. Please manually recreate.")


function app.TwoLinesPrint (|[string]| Lines, |int| Pad, |string| Title)
	app <~ Title
	|| i = 0
	while (|| f = Lines[i++])
		"    $f${` ` * (pad-f.length)}(${Lines[i++]})"	


function app.LetsGo
	"\nSpeedie Installation (v0x${__speedie__|int64|.hex})... lets go!"
	.relax(spdterm)

	.buildSDL2(.cwd.File)

	.cwd = spd
	|| cake = .compile("Cake", "VM")
	|| perry = .compile("Perry", "IDE")
		
	self <~ ("Symlinking", "symlink")

	|| where = "/usr/local/bin"
	.link("$where/spd", SpdTerm)
	.link("$where/speedie", SpdTerm)
	if cake
		.link("$where/cake", cake)
		.link("$where/🎂", cake)
	if perry
		.link("$where/perry", perry)

				// Jeebox //
	PrintMake = true
	|| libJeebox = .compile("jeebox", "")$
	.mkdir("/usr/local/include/")$					// Does not always exist! can you beleive it.
	self <~ ("Install libJeebox", "Jeebox: Universal Data Format")
	.cp(libJeebox, "/usr/local/lib/"+libJeebox.name)$

	self <~ ("Copying libJeebox Headers", "jeebox header")
	.cwd = "$spd/jeebox.scproj/Examples"
	|| examples = "$spd/jeebox.scproj/Examples".file
	for ch.files in examples
		if ch isa "h"
			.cp(ch, "/usr/local/include/"+ch.name)
	PrintMake = false
	
	self <~ ("Compile libJeebox .cpp examples", "c++ jeebox example")
	.compile_example("jb")
	.compile_example("xml")
	.compile_example("test")
	.compile_example("users")


function app.SyntaxAppend (|string| name, |string| type="")
	"\n         -- $name -- "
	CreationType = type
	

function app.relax (|string| Path, |errorint|)
	// sudo keeps forcing speedie/gcc to create files owned by root
	// which is useless and makes it impossible to actually USE the files.
	|| Status = .run("chmod", "775", Path)
		status = .run("chown", User, Path)

	if status!=0	
		"relax failed: $Path"
	return Status


function app.mkdir (|string| Path, |errorint|)
	|| f = path.File
	if f.Exists
		expect (f.IsDir) ("Unexpected file at directory: $path")
		return 0
	|| Status = f.MakeDir
		return app.MadeFile(f + "/")
	return Status


function app.compile_example (|string| name, |errorint|)
	"Compiling ${name}.cpp"	
	|| Built = ("Build/" + name).file
	|| cflags = "-std=gnu++20 -lstdc++ -L/usr/local/lib/ -I /usr/local/include -I $spd/Library/CppLib -w -Os -D TARGET_UNIX=1 -g -ljeebox"
	|[string]| args

	args.SplitAppend("g++ -o")
	args <~ Built
	args.SplitAppend(cflags)
	args <~ "${name}.cpp"

	|| Status = .Run(args)
		status = .madefile(Built)
	return Status
	

function array.SplitAppend (|[string]| self, |string| name)
	for item in (name / ' ')
		if item
			self <~ item


function app.cp (|string| From, |string| To, |bool|)
	if From.file.CopyTo(To.file)
		return .madefile(to)

	
function app.link (|string| From, |string| To,  |errorint|)
	|| Made = from.file
	if made.LinksTo == to
		return 0
	|| Status = made.LinkTo(to)
		return .madefile(made)
	FailedLinks <~ from
	FailedLinks <~ To
	return Status


function app.BuildSDL2 (|string| P)
	self <~ "Checking for SDL2"
	|| Header = "/usr/local/include/SDL2/SDL.h"
	if header.FileExists
		if !FileDes.stdout.isterminal
			"SDL2 already installed"
			return
		require  !app.ask("SDL2 is already detected at $header.", "Skip SDL2 Update?")

	self <~ "Building SDL2"
	if p starts Spd
		if !app.ask("Working directory is currently in $spd.", "Use /tmp/spd_install instead?")
			app.quit
		P = "/tmp/spd_install".file
		.mkdir(P)$
		.cwd(P)$
		
	|| SDL = P.child("SDL")
	if "SDL".fileExists
		.cwd(SDL)$
		.run("git", "pull")$
	  else
		.run("git clone https://github.com/libsdl-org/SDL.git -b SDL2" / ' ')$

	.cwd(SDL)$
	printline .cwd
	.mkdir("build")$

	.run(SDL["configure"])$
	.run("make")$
	.run("sudo", "make", "install")$
	
	self <~ "Returning To Installing Speedie! (SDL2 is done)"
	


function app.MadeFile (|string| f, |string| Kind=CreationType, |errorint|)
	if kind
		if PrintMake
			printline f
		FilesMade <~ f
		FilesMade <~ kind
	return .relax(f)

	
function app.Compile (|string| str, |string| MakeKind,  |string|)
	|| out = FastString()
	print "Making $str: "
	|| Status = .run(SpdTerm, "$spd/$str.scproj",  "--quiet", out)
		|| answer = out.GetResult
		|| f = answer.file
		if f.Exists
			printline f
			.MadeFile(f, MakeKind)
			return f
		error "$answer does not exist!"


function app.Run (|string| name, |string?| arg1=nil, |string?| arg2=nil,   |faststring| out=nil,   |ErrorInt|)
	|| args = [arg1, arg2]
	rz = name.Execute(Args, out, processmode.PassThru)
	if rz!=0
		printline "$name: $args Error: $rz"


function app.Run (|[string]| args,  |faststring| out=nil,  |ErrorInt|)
	|| name = args[0]
		args.Remove(0)
		rz = name.Execute(Args, out, processmode.PassThru)
		if rz!=0
			printline "$name ${args * ' '}\n\nError: $rz"


function array.operatormul (|[string]| self, |byte| c, |string|)
	return .join(string.byte(c))


function app.Ask (|string| Prefix, |string| Q,   |bool|)
	print prefix
	if app["y"] or app["n"]
		""
		return app["y"]

	"  $Q Y/n"
	while
		|| y = app.Input
		if !y.isok
			return false
		if (y ~= "" or "y")
			return true
		if y ~= "n"
			return false
		"Not a Y/n answer. Type y or n"

