#!/usr/local/bin/spd

/*
	Creates a bash file. This bash file builds speedie, then uses Speedie to complete the install.
*/

|string|	spd = file.SpeedieDir
|string|	CFlags = "-std=gnu++20 -L/usr/local/lib/ -I /usr/local/include -I \$Speedie/Library/CppLib -w -Wno-return-type-c-linkage -Os -ffast-math -D TARGET_UNIX=1 -D __SPEEDIE__=1"
|string|	SpdSrc = "\$Speedie/Speedie.scproj/Build"
|string|	SpdTerm = "\$Speedie/Terminal/Speedie"

main
	|| R = app.args
	expect (!R.length or R.Last isa "git")			("This script takes no arguments.")
	expect (spd.FileExists)							"Can't find Speedie installation at: $spd}"

	print "Generating cpp: "
	require "/usr/local/bin/speedie".Execute(["--self", "--x", "--nocompile", "--quiet", "--bump"]).Successful

	|| ScriptOut = "$spd/make.sh".file
	scriptout.writeall "#!/bin/bash

set -e
Speedie=\$(dirname \"$(realpath $0)\")
NativeFlags=\"-lrt\"

if [ \"\$Speedie\" = \"\" ] ; then
	echo \"failed to find speedie path\"
	exit 1
fi
if [ $(uname) = \"Darwin\" ] ; then
	NativeFlags=\"\"
	echo \"Building Speedie for OSX: $SpdTerm\"
else
	echo \"Building Speedie for Linux: $SpdTerm\"
fi

cd \"\$Speedie/Library/CppLib\"
g++  -o  ${SpdTerm}tmp  $CFlags  \$NativeFlags  *.cpp *.S  -I $SpdSrc  $SpdSrc/JB.cpp  $SpdSrc/JB_Globals.cpp
mv ${SpdTerm}tmp $SpdTerm

echo \"Running post_install.spd\"
$SpdTerm \$Speedie/Terminal/post_install.spd
"
	"Testing: $scriptout"
	|| Exit = scriptout.Execute
	expect (exit.Successful)						("Failed to execute script: $scriptout ($exit) ${exit.name}")

	

