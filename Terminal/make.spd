#!/usr/local/bin/spd

// INSTALL:
// sudo /usr/local/speedie/Terminal/make.spd

|string|	SpdLocal = file.speediedir
|file|		CppLibLocal = (SpdLocal+"/Library/CppLib").file

main {
	|| R = app.args
	ifn R.Last isa "git"
		expect (!R.length) ("This script takes no arguments.")
	
	if !SpdLocal or !SpdLocal.FileExists
		printerror "Can't find Speedie installation: "
		|| f = app.exepath
		printerror f
		printerror "  -->  "
		f = f.Resolve
		printerror f
		return 1
	
	printline "Installation: " + SpdLocal
	print "Generating cpp files: "
	require "/usr/local/bin/speedie".Execute(["--self", "--x", "--nocompile", "--quiet"]).Successful

	|| tocompile = FastString()
	|| Count = 2							//JB.cpp and JB_Globals.cpp
	for ch in CppLibLocal!
		if ch isa "cpp" or "S"
			tocompile <~ ch
			tocompile <~ ' '
			Count++
	|| list = tocompile.render

	app.Gen("osx", platform.OSX, Count, List)
	app.Gen("linux", platform.linux, Count, List)
	"All done!"
}


|| GetUserName = `
U="$SUDO_USER"
if [ "$U" = "" ]  ||  [ "$U" = "root" ] ; then
   U=$USER
fi
if [ "$U" = "" ]  ||  [ "$U" = "root" ] ; then
   U=$LOGNAME
fi
if [ "$U" = "" ]  ||  [ "$U" = "root" ] ; then
   U=$(basename -- "$HOME")
fi
if [ "$U" = "" ]  ||  [ "$U" = "root" ] ; then
   echo "Please set LOGNAME to the desired user's name so we can make these files and folders owned properly."
   exit 1
fi
`

// can't quote the path as one path ends with * to capture all files.
function UnMod (|string| Dir, |string| indent="",  |string|)
	return "chmod 775 $dir
$indent${}chown \$U $dir"

	
function compile_example (|string| name, |string|)
	return "echo \"Compiling ${name}.cpp\"
$gcc -o Build/$name  $CFlags -g -ljeebox  ${name}.cpp
${unmod(`Build/`+name)}
"

function mkdir (|string| dir, |string|)
	rz = "
if [ ! -f $dir ]; then
    echo \"Creating: $dir/\"
    mkdir -p \"$dir\"
    ${unmod(dir, `    `)}
fi
"

function link (|string| src, |string| dest, |string|)
	return "
ln -sf $src $dest
${unmod(dest)}
"


|string|	CFlags
|string|	SpdGccFlags
|string|	SpdSrc = "\$Speedie/Speedie.scproj/Build"
|string|	SpdTerm = "\$Speedie/Terminal/Speedie"
|string|	CakeTerm = "\$Speedie/Terminal/Cake"
|string|	gcc = "g++"


module Vars
	function InitVars (|string| Plat)
		CFlags = "-std=gnu++20 -L/usr/local/lib/ -I /usr/local/include -I \$Speedie/Library/CppLib -w -Wno-return-type-c-linkage -Os -ffast-math -D TARGET_UNIX=1 -D __SPEEDIE__=1"
		// what about -D __VM__=1 ???
		// cflags += " -flto" // seems to cause crashes. no idea why. Some kinda clang bug I guess.
		SpdGccFlags = ""
		if plat ~= "osx"
			CFlags += " -lc++"
		  else
			SpdGccFlags += "-lrt -pthread"

	function CreateScriptOut (|string| list, |string|)
		return "#!/bin/bash
echo \"Starting Speedie Build\"
Speedie=\$(dirname \"$(realpath $0)\")
Speedie=\$(dirname \"\$(realpath \$Speedie)\")
if [ \"\$Speedie\" = \"\" ] ; then
	echo \"failed to find speedie path\"
	exit 1
fi
set -e
cd \"\$Speedie/Library/CppLib\"

$GetUserName
echo \"Compiling Speedie to $SpdTerm\"
$gcc -o ${SpdTerm}tmp  $CFlags  $list  -I $SpdSrc  $SpdSrc/JB.cpp  $SpdSrc/JB_Globals.cpp $SpdGccFlags
mv ${SpdTerm}tmp $SpdTerm
${unmod(SpdTerm)}


cd \$Speedie/jeebox.scproj/Examples
${mkdir(`Build`)}
${mkdir(`/usr/local/include`)}

echo \"Cleaning Build temp files\"
rm -rf Build/* 2>/dev/null || true

echo \"Installing headers\"
cp    *.h /usr/local/include/
${unmod(`/usr/local/include/jeebox*`)}

set +e									# better to continue
echo \"Symlinking Speedie\"
${link(SpdTerm, `/usr/local/bin/spd`)}
${link(SpdTerm, `/usr/local/bin/speedie`)}


echo \"\"
cd \$Speedie/Library/CppLib				# allow source to be found!

echo \"Compiling libJeebox for user '\$U'\"
$SpdTerm \$Speedie/jeebox.scproj --quiet		# regenerate libjeebox source

echo \"Relaxing permissions\"

${unmod(`../../jeebox.scproj/Cpp/*`)}
${unmod(`../../jeebox.scproj/Build/*`)}


cd \$Speedie/jeebox.scproj/Examples
${compile_example(`jb`)}
${compile_example(`xml`)}
${compile_example(`test`)}
${compile_example(`users`)}


set -e


if [ ! -f \"/usr/local/include/SDL2/SDL.h\" ]; then
	echo \"Please install SDL2 to get Perry and Cake to compile. Speedie expects SDL2 headers at /usr/local/include/SDL2/SDL.h\"
	echo \"https://wiki.libsdl.org/SDL2/Installation contains the guidelines.\"

else

echo -n \"Making 🎂 Cake 🎂: \"
$SpdTerm \$Speedie/Cake.scproj --output_path=\$Speedie/Terminal/Cake --quiet

echo \"Symlinking 🎂\"
${link(CakeTerm, `/usr/local/bin/cake`)}
${link(CakeTerm, `/usr/local/bin/🎂`)}


echo -n \"Making Perry: \"
$SpdTerm \$Speedie/Perry.scproj --quiet

fi
"



function app.Gen (|string| Plat, |bool| IsCurrentPlatform, |int| Count, |string| List)
	"Making Script: make$plat.sh"
	vars.initvars(plat)
	////////////////////////////
	
	|| ScriptOut = "$SpdLocal/Terminal/make$plat.sh".file	
	scriptout.writeall vars.CreateScriptOut(list)

	if IsCurrentPlatform
		"Running Script: $scriptout\n"
		ScriptOut.NeedExecute										/* <----- ACTUAL CALL POINT -----> */



function file.NeedExecute (|bool|)
	|| Exit = .Execute
	if exit.Successful: return true
	error ("Failed to execute script: $self ($exit) ${exit.name}")


// ANTI-MAKE THEORY:
	// NO:    unix 'make' or cmake
	// DO:    Call g++ (etc), from a bash script that you create via code.
	// MOVE:  All possible control-flow + vars out of bash, and into speedie (or whatever lang).

	// This basically makes YOU replace cmake with your small program. This 205 lines of code
	// replaces all of cmake. Meaning I don't need to remember or understand it!



