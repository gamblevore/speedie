

datatype FileDescriptor (int)
	function IsTerminal (|bool|)
		cpp_wrapper JB_IsTerminal
		
	syntax cast (|bool|)
		inlined
		return self >= 0



struct DirectoryReader
	linkage
		wrapper
		cpp_class JB_DirReader
	size 24

	autogen ListEnd
		cpp_wrapper JB_File_ListEnd

	autogen MoveNext (|bool|)
		cpp_wrapper JB_File_MoveNext

	autogen CurrChild (|int| MakeDirsObvious=0, |String|)
		cpp_wrapper JB_File_CurrChild
	



datatype FileMode (int)
	constants
		|FileMode|
		Owner	= 7<<6
		Group	= 7<<3
		Other	= 7<<0
		CanExec	= 1<<6  + 1<<3 + 1<<0
		Process	= Owner + 5<<3 + 5<<0
		Data	= 6<<6  + 4<<2 + 4<<2


