
/*
	Jeebox internals. By Theodore H. Smith...
*/


datatype Date (int64)
	description "Total range is +- 4.46 million years. Resolution is 64K/s.

Being a plain data-type, this can never be nil, which is useful. Represents Unix-time.

Unix time does not have leap-seconds, so one day is always 86400 seconds."

	constants
		|int64|
		Highest	=  0x7FFFffffFFFFffff_
		
	function Seconds (|float|)
		disabled "Use .float64 for fractional seconds, or .WholeSeconds for integer seconds"
	
	function Float (|Float64|)
		return self|Float64| / (64.0*1024.0)|float64|
	
	inline WholeSeconds (|int64|) // needs 48 bits!
		return self >> 16
	
	operator Minus (|date| D, |duration|)
		inlined
		return self|int64| - D|int64|

	function Ago (|Duration|)
		if self
			return now() - self
	
	render LocalTime
		opt norefcounts
		fs.AppendLocalTime(self)
	
	render RenderDurr
		opt norefcounts
		fs.AppendDurr(self)

	render RenderInt
		opt norefcounts
		fs.AppendDecimal(self)
	
	render  // hmmm... i guess this is just for data-formats.
		disabled "Do you mean .LocalTime or .RenderInt"

		
	function Fired (|bool|)
		if self != 0
			return self < date.now
	
	inline Weeks (|int64|)
		return self  /  1weeks
	
	inline Days (|int64|)
		return self  /  1days

	inline Minutes (|int64|)
		return self / 1mins
	
	inline WithinDay (|duration|)
		return self mod 1days

	function TimeID (|uint64|)
		cpp_wrapper

	function Cycle (|duration| Length, |float|)
		description "Returns a number between 0 and 1. This number cycles back and forth in a sinusoidal fashion."
		opt min 3
		|| P = .loop(length)
		return (P.sin * 0.5) + 0.5


	function Loop (|duration| Length, |float|)
		description "Returns a number between 0 and 1. This number increases linearly, then resets"
		opt min 3
		return (self mod Length)|float| / Length|float|

	iterator
		|| StartDate = date.now()
		|| EndDate = StartDate + self
		while
			|| Currtime = date.now
			if Currtime >= EndDate
				exit
			yield ((CurrTime - StartDate).float) (CurrTime-StartDate) // why a float at all?

	module
		inline TimeID (|uint64|)
			return .now.timeID
			
		inline Ticks (|int64|)
			description "64 ticks per second, not 60." 
			return (.now>>10) //64KB-->64

		function Now (|Date|)
			cpp_wrapper JB_Date__Now

		function New (|Date|)
			disabled "Use .now"

		libinternal TimeStamp  (|uint64|)
			cpp_wrapper RDTSC
			
		function Hash  (|uint64|)
			return .timestamp.hash


datatype Duration (date)
	linkage
		cpp_class JB_Duration

	function Float (|float|)
		return (self|Float64| / (64.0*1024.0)|float64|)|float|

	inline WholeSeconds (|int64|) // needs 48 bits!
		return self >> 16
	
	syntax cast (|float|)
		// are these bad? remove them??
		inlined
		cpp_Part CastFloat
		return .Float	
		
		
