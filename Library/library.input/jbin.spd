
// jbin: streamable, binary jeebox


extend message
	render RenderJbin (|string| shell_path = "")
		opt norefcounts
		require self
		|| js = fs|jbin|
		js.RunHeader(shell_path)
		.render_jbin_sub(js)
	
	libinternal render_jbin_sub (|jbin| js)
		opt norefcounts
		|| ch	 = self
		|| after = .FlatAfter
		while ch and ch != after
			|| Depth	= 0
			|| curr		= ch
			ch			= curr.FlatNextDepth(depth)
			js.Add(curr.type, curr.name, depth > 0)
			js.exit(-depth)



role JBin (Faststring)
	target true//debug2
		skipto object
	constants
		|int|
		JBinHeader = 0xE2EA1001 // little-endian appends this backwards somehow. it works tho!

	linkage: cpp_part bin
	
	constructor				(|syntax| type=@arg, |string?| name=nil)
		cpp_part Constructor
		super.AppendInt(JBinHeader)
		.enter(type, name)
	
	constructor (|int| n)
		disabled `Use jbin(@syx, "name")`
		cpp_part Constructor0

	
	function Start			(|syntax| type=@arg, |string?| name=nil, |jbin|)
		super.Length = 0
		super.AppendInt(JBinHeader)
		.enter(type, name)
		return self
	
	inline Enter			(|syntax| type=@arg, |string?| name=nil, |jbinleaver|)
		return .add(type, name, true)

	inline ExitAll
		cpp_Part Exit0
		.Exit(super.indent)
	
	function Exit			(|int| Amount=1, |int|)
		super.Indent = (super.Indent - amount) max 0
		|| Add = 239
		while amount > 0
			rz++
			|| B  = (add + amount)  min  (255)
			super    <~ B|byte|
			amount  -= (B-add)

	function TmpArg			(|string| name, |jbinLeaver|)
		.Enter(@tmp, name)
		.Enter(@arg)
		return 2

	function RunHeader		(|string| name)
		if name
			super <~ '#'
			super <~ '!'
			super <~ name
			super <~ '\n' // noice
		super.AppendInt(JBinHeader)
	
	inline AddStr			(|string?| name)
		.add(@str, name)
	
	inline AddStr			(|faststring!| fs)
		cpp_part FSStr
		.add(@str, fs|string|)
		fs.Length = 0
	
	function AddInt			(|int64| value)
		.add(@num, value.render)

	function AddHint		(|int64| Value)
		.WriteType(@hint, false)
		super.AppendHInt(Value|uint64|.HintLength)
		super.AppendHInt(Value)
	
	function AddRow			(|syntax| type, |string| Row, |string| Value)
		.enter(@tmp, row)
		.Add(type, value, false)
		.exit
	
	function Add			(|syntax| type, |string?| name=nil, |bool| into = false, |jbinleaver|)
		.WriteType(type, into)
		|| L = name.Length
		super.AppendHInt(L)
		if L
			super.AppendMemory(name!.addr, L)
		return into|int|
	
	function Add			(|syntax| type, |faststring| fs, |bool| into = false, |jbinleaver|)
		cpp_part AddFS
		return .add(Type, fs|string|, into)

	inline AddCString		(|syntax| type=@str, |cstring| name, |bool| into=false)
		.AddMemory(type, name.length, into, name|&byte|)

	function AddMemory		(|syntax| type, |int| L, |bool| GoIn, |&byte| data, |jbinleaver|)
		.WriteType(type, goin)
		super.AppendHInt(L)
		super.AppendMemory(data, L)
		return goin|int|

	function WriteType	(|syntax| type, |bool| GoIn=false)
		|| T = (type|int|<<1) ||| (goin)
		super <~ T|byte|
		super.Indent += goin

	function StartAdd (|int|)
		super <~ (0|byte|, 5)
		return super.Length
		
	function FinishAdd (|syntax| Ty, |int| Start, |int|)
		|| NewLength = super.Length
		|| Gained = NewLength - Start
		|| HLength = Gained|uint64|.hintlength
		super.Length = Start-5
		super <~ (0|byte|, 5-(hlength+1))
		super <~ (ty|int|<<1)|byte|
		super.AppendHInt(Gained)
		super.Length = NewLength
		return Gained
	
	inline Length (|int|)
		return super.Length
	inline Length (assigns:|int|)
		super.Length = value
	inline Flush
		super.Flush
	inline GetResult (|string|)
		return super.GetResult


libinternal uint64.HintLength (|int|)
	rz = 1
	if self|int64|<0
		self = -self
		rz++
	while self >= 128
		self = self >> 7
		rz++


libinternal InputStream.NextMsgInfo (|uint64|)
	opt norefcounts
	|| Msg = ._Object|message|!
	|int| info
	while 
		info = .NonZeroByte
		loop info > 239
		msg = Msg.parent(info - 239)
		._Object = msg, require msg

	|| T = (info >> 1)|syntax|
	if (t < @max  and  T > @nil)					// 01 --> T=@nil
		|| N = .hint
		expect !(N>>31) (self, "Value out of range: " + n)
		msg = msg.msg(t, .str(N))
				
		if info & 1
			._Object = msg
		|| cb = .CallBack
		if !cb // common case
			return msg|uint64|
		(cb)(msg)
		return msg|uint64|

	._Object = nil
	if info >= 0
		expect (T > @nil) (self, "InputStream.IsJBin was not called.")
		error (self, "Corrupted jbin")


function InputStream.StreamJbin (|int64| Remain=1G, |MessageRoot|)	
	if .Eat("#!") == 2				 // shebang
		.Find('\n')
	|| H = .str(4)
	if !h.IsJbin
	expect (h.IsJbin)  (Self, "Parsed data lacks jbin header.")

	._Object = nil
	|| Root = .NextMsgInfo|message|
	while --Remain > 0
		loop .NextMsginfo
	
	if .Data.WentBad and !.TryRecoverBadData
		Root = nil // be consistant with .parse!
	return Root
	

function string.ParseJbin (|int64| max=1G, |messageroot|)
	|| s = .stream
	|messageroot--| msg = s.StreamJbin(max)
	return msg


function string.Digest (|string|)
	if .IsJbin
		return self
	return .parse$.renderjbin


