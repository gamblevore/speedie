

datatype TerminalColor (int)
	constants
		|TerminalColor|
		Black = 30
		Red, Green, Yellow, Blue, Magenta, Cyan, White
	
	constants
		|TerminalColorString|
		// could these be replaced with numbers?
		Normal		= "\1b[0m"
		Bold		= "\1b[0;1m"
		Error		= "\1b[0;1;31m"
		Good		= "\1b[0;1;32m"
		Underline	= "\1b[0;1;32m" // these two are the same?
		Warn		= "\1b[0;1;33m"


// todo: add more stuff.
//ESC[1m	ESC[22m	set bold mode.
//ESC[2m	ESC[22m	set dim/faint mode.
//ESC[3m	ESC[23m	set italic mode.
//ESC[4m	ESC[24m	set underline mode.
//ESC[5m	ESC[25m	set blinking mode
//ESC[7m	ESC[27m	set inverse/reverse mode
//ESC[8m	ESC[28m	set hidden/invisible mode
//ESC[9m	ESC[29m	set strikethrough mode.
//ESC[38;2;{r};{g};{b}m	Set foreground color as RGB.
//ESC[48;2;{r};{g};{b}m	Set background color as RGB.


	render
		opt norefcounts
		fs <~ "\1b[${self|int|}m"
		
	operator plus (|terminalcolor| other, |string|)
		embedded
		opt norefcounts
		|| fs = FastString.shared
		|| nope = .Render(fs)
		nope = other.Render(Fs)
		return fs
	
	syntax cast (|string|)
		inlined
		return .Render
	

inline FastString.SyntaxAppend (|TerminalColor| Col)
	cpp_part AppendTermCol
	col.Render(self)


role TerminalColorString (string)
	operator plus (|terminalcolor| other, |string|)
		embedded
		opt norefcounts
		|| fs = FastString.shared
		fs <~ self
		|| nope = other.Render(Fs)
		return fs
	



target !minilib {

function TerminalColor.Colorise (|string| S, |string|)
	// handy trick of using high-bits on objects
	|int64| C = (self-Black)&7
	C = C<<60
	|| S2 = (s|int64|<<3)>>3
	return (S2|||C)|string|


inline string.TerminalColor (|terminalcolor|)
	return (self|int64| >> 60) + TerminalColor.black



struct TerminalDisplay
	visible false
	|[[string]]|		Screen
	|faststring|		fs
	|date|				LastDisplay
	visible true
	
	constants
		w = 80
		h = 35 // too many lines will break the clearscreen/reset function!
	
	inline Size (|ivec2|)
		return (w, h)
	
	module
		function New (|TerminalDisplay|)
			embedded
			rz.Screen = []
			rz.fs = FastString()
			for h
				|[string]| s
				s <~ (" ", w)
				rz.Screen <~ s
		
		function GetChar (|CodePoint|)
			cpp_wrapper JB_App__GetChar
	
	syntax access (|CodePoint|)
		inlined
		return TerminalDisplay.getchar
		
	
	syntax append (|string| text, |ivec2| V, |TerminalColor| Colors = 0)
		embedded
		|| x0 = v.x
		for c.codepoints in text
			if c == 10 or 13
				++v.y
				v.x = x0
			  elseif c == ' '
				++v.x
			  elseif v inrange .size  and  c != ' '
				if c == 127
					c = ' ' // lol
				|| row = .Screen[v.y]
					row[v.x] = colors.colorise(c)
				++v.x
	
	
	function DrawRect (|ivec4| Rect, |string| inside="", |terminalcolor| colors=0)
		embedded
		opt norefcounts
		
		|| r2 = rect + (1, 1, -2, -2)
		for s.rect in rect
			|| c = inside
			|| X = r2.x1x2 contains s.x
			|| Y = r2.y1y2 contains s.y
			if !x and !y
				c = "+"
			  elseif !x and y
				c = "|"
			  elseif !y and x
				c = "-"
			self <~ (c, s, colors)


	function Flat (|string|)
		embedded
		opt norefcounts
		|| PrevCol = 0
		for line in .Screen
			for (cell in line) (i)
				|| CCol = cell.terminalcolor
				if PrevCol != CCol
					PrevCol = CCol
					.fs <~ CCol
				.fs <~ cell
				line[i] = " "
			.fs <~ '\n'
		return .fs.GetResult


	function Display
		embedded
		|| now = date.now
		if .LastDisplay
			app.Sleep((.LastDisplay + 1s/60) - now)
		  else
			"\1b[2J"			// clear
		.LastDisplay = now
		"\1b[1;1H"				// reset
		print .flat
	
	
	function FrameText (|string| s, |ivec4| Frame, |terminalcolor| FrameCol=terminalcolor.white, |terminalcolor| TextCol=0)
		embedded
		|| p = frame.xy + 1
		for i.rect in frame ± 1
			|| row = .Screen[i.y]
				row[i.x] = " "
		for l.lines in s
			self <~ (l, p, textcol)
			++p.y
		.DrawRect(frame, FrameCol)
	
	inline Beep
		"\07" // bell character
}

