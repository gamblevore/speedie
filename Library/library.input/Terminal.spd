

datatype TerminalColor (int)
	constants
		|TerminalColor|
		Black = 0
		Red, Green, Yellow, Blue, Magenta, Cyan, White
		Bold		= 1<<4
		Dim			= 2<<4
		Italic		= 3<<4
		Underline	= 4<<4
		Blink		= 5<<4
		IDK			= 6<<4
		Inverse		= 7<<4
		
		Normal		= 0
		Good		= Bold + Green
		Warn		= Bold + Yellow
		Error		= Bold + Red
	
	constants
		|TerminalColorString|
		// could these be replaced with numbers?
		sNormal		= "\1b[0m"
		sBold		= "\1b[0;1m"
		sError		= "\1b[0;1;31m"
		sGood		= "\1b[0;1;32m"
		sUnderline	= "\1b[0;4;32m" // these two are the same?
		sWarn		= "\1b[0;1;33m"


	render (|string?| Info=nil)
		opt norefcounts
		|| Style = (self>>4)&15
		fs <~ "\1b["
		if style <= 8
			fs <~ style|int|
			fs <~ ";"
		|| Col = self|int|&7
			Col += 30		// color range from 30 (Black) to 37 (white)
		fs <~ Col
		fs <~ "m"
		fs <~ Info

	syntax cast (|string|)
		inlined
		return .Render
	

inline FastString.SyntaxAppend (|TerminalColor| Col)
	cpp_part AppendTermCol
	opt norefcounts
	|| nope = col.Render(self)


role TerminalColorString (string)
