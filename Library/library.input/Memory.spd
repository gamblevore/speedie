

/*
	Jeebox internals. By Theodore H. Smith...
*/

	// ByteLength:		The actual length in bytes allocated.
	// Count:			The number of items this memory allocation can store.
	// ItemSize:		The bytesize of each item.

class Memory
	linkage
		cpp_part Mem
		cpp_class MWrap
		pragma noearlyfree
	
	|uint|				ByteLength	// Can be shared with string now.
	|&byte|				_Addr		// to force types correctly via the addr() wrapper
	|uint|				Count		// I prefer Count than length because length sounds like a string. But the the items here have a real count. Like the length of a rope is it's length. But the COUNT of items is different than its length. 10 elephants has a longer length than 10 snails.
	|uint|				ItemSize
	|byte|				Allocator
	contains byte
	

	constructor (|int| ItemCount, |int| ItemSize, |?&byte| ptr, |byte| Allocator=DataObject.kfree)
		cpp_part ConstructorPtr
		if !ptr
			ptr = (&_MDummy)|&byte|
			ItemCount = 0
			Allocator = 0 // ooof
		
		.ItemSize = ItemSize
		.Count = itemcount
		.ByteLength = ItemCount * ItemSize
		.Allocator = Allocator
		._Addr = ptr
	
	
	autogen UseExternalPointer (|&nil| P, |int| ItemCount)
		embedded
		.Count = itemcount
		.ByteLength = ItemCount * .ItemSize
		if .Allocator == dataobject.kfree
			Memory.free(.addr)
		._Addr = P|&byte|
		.Allocator = 0
	
	setter Addr (|&...|)
		disabled
		
	inline Addr (|&...|)
		return ._Addr
	
	setter Allocator (|int|)
		disabled
	
	function CopyFrom (|&nil| Src, |int| Length, |int|)
		cpp_part CopyFromPtr
		Length = .ByteLength min Length
		if Length > 0
			memory.Copy(.Addr, Src, length)
		return Length

	inline CopyFrom (|string| Src, |int|)
		cpp_part CopyFromString
		return .CopyFrom(src.addr, src.length)
	
	inline CopyFrom (|memory| other, |int|)
		embedded
		return .CopyFrom(other.Addr, other.ByteLength)
		
	setter Count (|int|)
		inlined
		.ReSize(value)
	
	function Size (|uint|)
		disabled "Use .count"
	
	function Resize (|int| ItemCount, |bool|)
		if ItemCount == .Count
			return true
		require .Allocator == DataObject.kfree
		|| S = .itemsize|int|
		|| old = S * .Count
		|| New = S * ItemCount
		|| Mem = Memory.realloc(.Addr, New)
			._Addr = mem
			.Count = ItemCount
			.ByteLength = ItemCount * S
			if New > Old
				memory.Zero(mem+old, New-Old)
			return true
		error (self, "Can't allocate bytes: " + new)

	
	function Zero
		embedded
		zero(.Addr, .ByteLength)
	

	function DebugPrint
		embedded
		printline .dump
	
	
	inline String (|string|)
		return string.Copy(.Addr, .ByteLength)
	
	
	render Dump (|int| BytesOnRow=16, |int| TabsAfterBytes=4)
		opt norefcounts
		embedded
		|| p = .Addr
		|| p2 = p + .ByteLength
		|| i = 0
		|| com = 0
		fs <~ "dumping memory:\n"
		
		while (p < p2)
			|| c = p++[]
			fs.appendhex(c, 2)
			if (++i >= BytesOnRow)
				i = 0
				com = 0
				fs <~ "\n"
			  elseif ++com >= TabsAfterBytes
				com = 0
				fs <~ ", "

	
	destructor
		if (.Allocator == DataObject.kfree)
			Memory.free(.Addr)
		

	iterator
		|| FFFirst = .Addr
		|| Curr = FFFirst
		|| After = curr + .Count
		while (Curr < after)
			yield Curr[0] (curr - FFFirst)
			++Curr

	
	macro SyntaxAccess
		(_0.Addr|&...|)[_1]
	

	module
		|uint64[2]| _MDummy
		function Object (|int| Count, |int| ItemSize, |Memory|)
			visible
			description "Returns a memory of object size requested. Creates an error if fails."
			|| p = .zalloc(Count * ItemSize)
				return .new(Count, ItemSize, p)

		function Random (|int| n, |memory|)
			embedded
			opt norefcounts
			rz = byte[n]
			if rz
				random.temporal(rz)
		
		inline Zalloc (|int| count, |?&byte|)
			inlined
			return .realloc(nil, count) // why is this not inlined in the cpp??
										// more mysteries to solve!

		libinternal	_memset	(|&byte| p, |byte| B, |int| n):				cpp_wrapper memset
		function	Fill	(|&byte| p, |int| n, |byte| B):				._memset(p, b, n)
		function	Fill	(|&int| p, |int| n, |int| Pattern):			cpp_wrapper JB_FillInts
		function	Realloc	(|?&nil| b, |int| n, |?&byte|):				cpp_wrapper JB_Realloc
		function	Zero	(|&nil| addr, |int| n):						cpp_wrapper JB_memzero
		function	Compare	(|&nil| dest, |&nil| src, |int| N, |int|):	cpp_wrapper memcmp
		inline		Equals	(|&nil| dest, |&nil| src, |int| N, |bool|):	return .compare(dest, src, n) == 0
		function	Free	(|?&nil| b)
			cpp_wrapper JB_Free
			description "same as free() but also decreases the reported used-memory count."
				
		function	Copy	(|&nil| dest, |&nil| src, |int| N):			cpp_wrapper memcpy
		function	Swap	(|&nil| A, |&nil| B, |int| N):				cpp_wrapper JB_MemSwap

		autogen		Test		(|!&nil| p, |int| n, |int| Mode=0, |ErrorInt|): cpp_wrapper JB_TestMemory
		inline		Readable	(|!&nil| p, |int| n, |ErrorInt|):		return .Test(p|&nil|, n)
		inline		Writeable	(|!&nil| p, |int| n, |ErrorInt|):		return .Test(p|&nil|, n, 3)
		inline		TestObject	(|object!| p, |ErrorInt|):				return .Test(p|&nil|, -1)

		libinternal _Free (|?&nil| b):									cpp_wrapper free
	
		autogen Sort (|&nil| base, |uint64| Count, |uint64| width, |&nil| Comparer)
			cpp_wrapper JB_qsort

		autogen PermAlloc (|int64| Amount, |int64| AlignBits=0, |?&byte|)
			description "Returns non-freeable memory from your programs internal mmap'd space. Speedie allocates 4GB (only used by objects) by default, so its a lot to play with. Strings/arrays are allocated outside of that space.
			Aligns to at least 8K.
			
			AlignBits is used as the power of 2. For example: AlignBits 20 --> 1MB alignment.
			"
			cpp_wrapper JB_Mem__PermAlloc


