

/*
	Idea is to make sure your code works identical when porting from one system to another!
	Smashing all bugs!
*/

		
module FlowLog
	linkage: cpp_part Flow

	|InputStream?|			FlowIn
	|FastString?|			FlowOut
	|int|					_Enabled
	|uint|					FlowWhile
	|int|					LastCodePoint
	
	function Enabled (|bool|)
		visible
		return ._Enabled == 1
	
	inline Disabled (|bool|)
		visible
		return ._Enabled <= 0

	inline New (|bool|)
		return ._Enabled == 1

	inline Disable
		._Enabled -= 1

	inline Enable
		._Enabled += 1


	function Stop
		flow off, opt norefcounts
		
		require .Enabled
		self <~ "end-of-line"
		|| w = .FlowOut
			w.Flush
			.FlowOut = nil
		
		if .FlowIn!=nil
			if ._Enabled > 0
				"Flow: Occurred equally."
			.FlowIn = nil
		._Enabled = 0

	
	libinternal Test (|inputstream| Input, |int64| Found, |bool|)
		flow off
		
		|| Expected = input.hint
		if Expected == Found
			if Expected & 1
				.LastCodePoint = Expected
			return true
		
		._Enabled = -1
		.FlowIn = nil

		target __PROJECT_CAKE__
			cake.vm.Pause
			(found)
		  else
			print "Flow: Differed. Last Codepoint: "
			printline .LastCodePoint
			printline app.StackTrace
			target debug
				debugger
			  else
				app.crash
	
	
	syntax append (|int64| CodePoint)
		inlined
		.input(nil, CodePoint)


	syntax append (|string| Value)
		cpp_part AppendStr
		.input(value.hash>>1, 0)
	
	
	autogen Input (|int64| Hash, |int64| CodePoint)
		visible,  flow off,  opt norefcounts
		require .Enabled

		._Enabled = 0
		|| w = .FlowWhile
			.FlowWhile = 0

		target !__PROJECT_CAKE__
			|| out = .FlowOut
				if CodePoint > 0 // always odd
					out.AppendHInt(CodePoint)
				if w
					out.AppendHInt(w&~1)
				if Hash
					out.AppendHInt(Hash&~1)
		
		|| input = .FlowIn
			if CodePoint > 0
				.Test(input, CodePoint)
			if w
				.Test(input, w&~1)
			if Hash
				.Test(input, Hash&~1)
			
		._Enabled = 1
		
	
	syntax append (|[string]| Lines)
		embedded,  cpp_part InputStrings,  opt norefcounts,  flow off
		
		require .Enabled
		for s in lines
			.input(s.hash>>1, '\n')
				
	
	libinternal FlowPath (|string| name, |file|)
		return ("/tmp/logs/SpeedieFlow/" + name).file
		
		
	function StartGen (|string| name)
		flow off, opt norefcounts, embedded

		|| path = .FlowPath(name)
		if path.Size > 0
			// Copy to a new location, then use the new location as input.
			|| Copied = .FlowPath(name + date.now.withinday.Minutes)
			path.CopyTo(Copied)
			.FlowIn = Copied.InputStream
			path.close
		
		|| O = path.OutputStream
		.FlowOut = O
		._Enabled = (O!=nil)|int|

	
	function StartTest (|string| name)
		flow off,  opt norefcounts
		|| path = .FlowPath(name)
		|| I = path.InputStream
		.FlowIn = I
		._Enabled = (I!=nil)|int|


	inline TryStart (|string| name=–project, |bool|)
		flow off
		(name)
		target flow
			target cake
				.StartTest(name)
			  else
				.StartGen(name)
			return true



inline app.FlowLog
	FlowLog.FlowWhile += 2


/*
// for ternaries
// not so sure its a good idea just yet. kinda tricky

	// x = ((a)(b,c)).flowlog

// what about ASM or other types? only do it on a few?

	x = ((a)(b,c)).flowlog
*/


inline int.FlowLog (|int|)
	// bools/bytes go in here
	FlowLog <~ self
	return self


inline string.FlowLog (|string|)
	FlowLog <~ self
	return self


inline object.FlowLog (|object|)
	flowlog <~ .ObjectID|int|
	return self



