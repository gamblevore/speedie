

/*
	Idea is to make sure your code works identical when porting from one system to another!
	Smashing all bugs!
*/

		
module FlowLog
	linkage: cpp_part Flow

	|InputStream?|			FlowIn
	|FastString?|			FlowOut
	|int|					_Enabled
	|uint|					FlowWhile
	
	function Enabled (|bool|)
		visible
		return ._Enabled == 1
	
	inline Disabled (|bool|)
		visible
		return ._Enabled <= 0

	inline New (|bool|)
		return ._Enabled == 1

	inline DisabledIncr (|int| Value=1)
		._Enabled -= Value


	function Stop
		flow off, opt norefcounts
		
		require .Enabled
		self <~ "end-of-line"
		|| w = .FlowOut
			w.Flush
			.FlowOut = nil
		
		if .FlowIn!=nil
			if ._Enabled == 0
				"Flow: Occurred equally."
			.FlowIn = nil
		._Enabled = 0

	
	libinternal Fail (|string| Found)
		// Cake needs to break into the debugger here.  How?
		flow off
		
		._Enabled = -1
		.FlowIn = nil
		target __PROJECT_CAKE__
			cake.vm.Pause
			(found)
		  else
			"Flow: Differed\n"
			printline Found
			debugger
	
	
	syntax append (|int64| Value)
		inlined
		.input(nil, value)


	syntax append (|string| Value)
		cpp_part AppendStr
		inlined
		.input(value, -1)
	
	
	autogen Input (|string?| Str, |int64| Num)
		visible,  flow off,  opt norefcounts
		require .Enabled

		._Enabled = 0
		|| w = .FlowWhile
			.FlowWhile = 0

		target !__PROJECT_CAKE__
			|| out = .FlowOut
				if w
					out.AppendHInt(w)
				if str != nil
					out <~ str
				if num >= 0
					out.AppendHInt(num)
		
		  else
			|| input = .FlowIn
				if w
					|| v = input.HInt
					if v != w
						return .fail(w.render)
						
				if (str != nil) and !input.HasHeader(str)
					return .fail(str)
		
				if (num >= 0) and (input.hint != num)
					return .fail(num.render)
			
		._Enabled = 1
		
	
	syntax append (|[string]| Lines)
		embedded,  cpp_part InputStrings,  opt norefcounts,  flow off
		
		require .Enabled
		for s in lines
			.input(s, '\n')
				
	
	libinternal FlowPath (|string| name, |string|)
		return "/tmp/logs/SpeedieFlow/" + name
		
		
	function StartGen (|string| name)
		flow off,  opt norefcounts, embedded
		|| path = .FlowPath(name)
		|| O = path.OutputStream
		.FlowOut = O
		._Enabled = (O!=nil)|int|

	
	function StartTest (|string| name)
		flow off,  opt norefcounts
		|| path = .FlowPath(name)
		|| I = path.InputStream
		.FlowIn = I
		._Enabled = (I!=nil)|int|


	inline TryStart (|string| name=–project, |bool|)
		flow off
		(name)
		target flow
			target cake
				.StartTest(name)
			  else
				.StartGen(name)
			return true



inline app.FlowLog
	FlowLog.FlowWhile++


/*
// for ternaries
// not so sure its a good idea just yet. kinda tricky

	// x = ((a)(b,c)).flowlog

// what about ASM or other types? only do it on a few?

	x = ((a)(b,c)).flowlog
*/


inline int.FlowLog (|int|)
	// bools/bytes go in here
	FlowLog <~ self
	return self


inline string.FlowLog (|string|)
	FlowLog <~ self
	return self


inline object.FlowLog (|object|)
	flowlog <~ .ObjectID|int|
	return self



