

/*
	Idea is to make sure your code works identical when porting from one system to another!
	Smashing all bugs!
*/

		
module FlowLog
	linkage: cpp_part Flow

	|InputStream?|			CompareAgainst
	|faststring?|			FlowOut
	|int|					_Enabled
	
	function Enabled (|bool|)
		visible
		return ._Enabled == 1
	
	inline Disabled (|bool|)
		visible
		return ._Enabled <= 0

	inline New (|bool|)
		return ._Enabled == 1

	inline DisabledIncr (|int| value=1)
		._Enabled -= Value


	function Stop
		flow off, opt norefcounts
		
		._Enabled = 0
		|| w = .FlowOut
			w.Flush
			.FlowOut = nil
		
		if .CompareAgainst!=nil
			"Flow: Occurred equally."
			.CompareAgainst = nil

	
	libinternal Fail (|string| found, |string| expected)
		flow off
		
		._Enabled = -1
		|| fs = FastString()
		fs <~ "Expected "
		fs.AppendHexData(expected)
		fs <~ " but found "
		fs.AppendHexData(found)
		app.StackTrace(3, fs)
		printline fs
		.CompareAgainst = nil
		debugger
	
	
	syntax append (|byte| value)
		visible,  flow off,  opt norefcounts
		if ._Enabled == 1
			._Enabled = 0
			|| f = .flowout
				f <~ value
			  else
				|| a = .CompareAgainst!
				|| b = a.byte
				if b != value
					.fail(string.byte(value), string.byte(b))
			._Enabled = 1
	
	syntax append (|[string]| lines)
		cpp_part InputStrings, opt norefcounts, flow off
		
		if .Enabled
			for s in lines
				self <~ s
				self <~ '\n'

	syntax append (|string| value)
		cpp_part Input, visible, flow off

		require ._Enabled == 0
		._Enabled = 1
		|| f = .flowout
			f <~ value
		  else
			|| a = .CompareAgainst!
			|| b = a.str(value.length)
			if b != value
				.fail(value, b)
		._Enabled = 0
				

	function ForceStart (|string| name,  |bool|)
		flow off
		|string--| str = app["flowlog"]
		if !str
			"#!Use --flowlog or --flowlog=validate to activate FlowLog"
			return nil
		
		|| path = "/tmp/Speedie/FlowLog".child( name + ".txt" )
		if str ~= "validate"
			.CompareAgainst = path.InputStream
			._Enabled = 1
		  elseif str.yes
			.flowout = path.OutputStream
			._Enabled = 1
		  else
			error "#!Use --flowlog or --flowlog=validate to activate FlowLog"

		return FlowLog()


	inline Start (|string| name, |bool|)
		flow off
		(name)
		target flow
			return .ForceStart(name)



function uint64.FlowLog (|uint64|)
	embedded
	|| str = self|int64|.render
	FlowLog <~ str
	return self


function bool.FlowLog (|bool|)
	embedded
	|| str = .render
	FlowLog <~ str
	return self


function string.FlowLog (|string|)
	embedded
	FlowLog <~ self
	return self


function object.FlowLog (|object|)
	embedded
	.ObjectID|uint64|.FlowLog
	return self






