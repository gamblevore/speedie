

/*
	Idea is to make sure your code works identical when porting from one system to another!
	Smashing all bugs!
*/

		
module FlowLog
	linkage: cpp_part Flow

	|InputStream?|			CompareAgainst
	|FastString?|			FlowOut
	|int|					_Enabled
	|uint|					FlowWhile
	
	function Enabled (|bool|)
		visible
		return ._Enabled == 1
	
	inline Disabled (|bool|)
		visible
		return ._Enabled <= 0

	inline New (|bool|)
		return ._Enabled == 1

	inline DisabledIncr (|int| Value=1)
		._Enabled -= Value


	function Stop
		flow off, opt norefcounts
		
		require .Enabled
		self <~ "end-of-line"
		|| w = .FlowOut
			w.Flush
			.FlowOut = nil
		
		if .CompareAgainst!=nil
			if ._Enabled == 0
				"Flow: Occurred equally."
			.CompareAgainst = nil
		._Enabled = 0

	
	libinternal Fail (|string| Found)
		flow off
		
		._Enabled = -1
		.CompareAgainst = nil
		"Flow: Differed\n"
		printline app.StackTrace(3)
		debugger
	
	
	syntax append (|int64| Value)
		inlined
		.input(nil, value)


	syntax append (|string| Value)
		cpp_part AppendStr
		inlined
		.input(value, -1)
	
	
	autogen Input (|string?| Str, |int64| Num)
		visible,  flow off,  opt norefcounts
		require .Enabled

		._Enabled = 0

		|| w = .FlowWhile
			.FlowWhile = 0

		|| out = .FlowOut
			if w
				out.AppendHInt(w)
			if str != nil
				out <~ str
			if num >= 0
				out.AppendHInt(num)
		  else
			|| input = .CompareAgainst!
			
			if w
				|| v = input.HInt
				if v != w
					return .fail(w.render)
					
			if (str != nil) and !input.HasHeader(str)
				return .fail(str)

			if (num >= 0) and (input.hint != num)
				return .fail(num.render)
			
		._Enabled = 1
		
	
	syntax append (|[string]| Lines)
		embedded,  cpp_part InputStrings,  opt norefcounts,  flow off
		
		require .Enabled
		for s in lines
			.input(s, '\n')
				

	function ForceStart (|string| name, |bool|)
		flow off
		|string--| str = app["flowlog"]
		if !str
			"#!Use --flowlog or --flowlog=validate to activate FlowLog"
			return nil
		
		|| path = "/tmp/Speedie/FlowLog".child( name + ".txt" )
		if str ~= "validate"
			.CompareAgainst = path.InputStream
			._Enabled = 1
		  elseif str.yes
			.flowout = path.OutputStream
			._Enabled = 1
		  else
			error "#!Use --flowlog or --flowlog=validate to activate FlowLog"

		return FlowLog()


	inline Start (|string| name, |bool|)
		flow off
		(name)
		target flow
			return .ForceStart(name)


inline app.FlowLog
	FlowLog.FlowWhile++

/*
// for ternaries
// not so sure its a good idea just yet. kinda tricky

	// x = ((a)(b,c)).flowlog

// what about ASM or other types? only do it on a few?

	x = ((a)(b,c)).flowlog
*/


inline byte.FlowLog (|byte|)
	FlowLog <~ self
	return self


inline int.FlowLog (|int|)
	FlowLog <~ self
	return self


inline bool.FlowLog (|bool|)
	FlowLog <~ self|int|
	return self


inline string.FlowLog (|string|)
	FlowLog <~ self
	return self


inline object.FlowLog (|object|)
	flowlog <~ .ObjectID|int|
	return self






