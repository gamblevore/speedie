
target !minilib {

class SpdProcess (UnixProcess)
	linkage
		cpp_part Proc
	description "SpdProcesses are normal unix processes. But they were made by Speedie, allowing you to talk to them, via sending and receiving messages."
	
	contains SpdProcess
	|jbin|						Writer
	|?MicroProcess|				LibraryProcess		// To allow running a "process" that is actually just another library, compiled by speedie. To allow talking to a lib with messages.
	|int|						DeathLimit
	|bool|						AlreadyWarnedDied

	constructor	(|string| path, |pico| pico, |[string]| params=nil,  |ProcessMode| Mode=ProcessMode.StdErrCapture, |?MicroProcess| fn=nil)
		mode |= ProcessMode.MsgPassing
		super.constructor(path, mode, params, pico)
		.deathlimit = 12
		.LibraryProcess = fn
		.writer = FastString()

			
	destructor
		pico.destroy(.pico, "destructor")
			
	function CommsOpen (|bool|)
		if self
			return .pico.MessageError == 0
	

	libinternal ChildAlive (|bool|)
		if .LibraryProcess
			return .CommsOpen
		return .status.isrunning


	syntax append (|message| msg, |bool|)
		cpp_part Send
		opt norefcounts			
		if .status.NotStarted
			.start
		if .pico.MessageError == 0
			.writer.length = 0
			msg.RenderJbin(.writer)
			rz = .pico <~ .writer|string|
			.writer.length = 0


	syntax append (|faststring| fs)
		inlined
		self <~ fs|string|
		fs.Length = 0
	
	
	syntax append (|string| str, |bool|)
		cpp_Part SendStr
		if .status.NotStarted
			.start
		if .pico.MessageError == 0
			return .pico <~ str


	function Get (|float| T=0, |message|)
		// this should take a Date. seems easier?
		// pico could use dates internally... at least for this?
		// that, or we do the conversion in here.
		opt norefcounts
		if self
			if .status.NotStarted
				.start
			|| str = .pico.get(T)
				rz = str.parse
	

	inline LastSend (|date|)
		|| p = .pico
		return p.config.lastsend
	
	
	function TimeWaitingForReply (|date|)
		|| c = .pico.config
		|| last = c.lastsend
		if c.lastread < last
			return last.ago


	function CanActivate (|bool|)
		if !.Deathlimit or .Diedcount < .Deathlimit
			.alreadywarneddied = false
			return true
		if !.AlreadyWarnedDied
			.AlreadyWarnedDied = true
			error (.path, "Too many disconnections, blocking reconnection.")
	
	
	libinternal Kill
		disabled "Explain why"


	syntax expect (|string| err)
		cpp_part Fail
		if .CommsOpen
			printline err
			errorreceiver.NewError(nil, err, .path)
		.Disconnect(err)


	function Disconnect (|string| why = "")
		.pico.close(why.zeroterm)

	
	function SpawnAsChild (|bool|)
		|| s = .pico.MessageError
		if s == 255 // impossible?
		if s > 0
			require pico.replace(.pico)
		return .Start.successful


	function TimedOut (|date| Durr, |bool|)
		if (.TimeWaitingForReply > durr)
			error (self, "Child timed out: " + .pid)
			return true
	
		
	function ActivateChild (|bool|)
		if .CommsOpen and .Status.IsRunning
			return true
		.Kill(0)
		if .CanActivate
			expect (.path) (self, "Can't re-activate process without a path.")
			return .SpawnAsChild


	iterator
		while .pico.CanGet
			|| msg = .get(10.0)
			if !msg
				continue
			yield msg


	function app.Parent (|bool| Expect=false, |spdprocess?|)
		opt norefcounts
		if spdprocess.CheckedParent
			return spdprocess._parent
		spdprocess.CheckedParent = true

		|| comms = spdprocess._ForceParent
		if comms or pico.HasParentSocket
			if !comms
				comms = pico.new
			if comms
				if app.IsThreadedAsLib or comms.CompleteExec
					|| p = SpdProcess(comms.name, comms)
					SpdProcess._parent = p
					return p
				comms.Close("Parent lost connection")

		if expect
			error "Parent lost connection"


	module
		|bool|			CheckedParent
		|&pico|			_ForceParent
		|SpdProcess|	_Parent
				

		libinternal CreateArgs (|string| path, |[string]!| Args, |&cstring|)
			cpp_wrapper
		
		
		function Spawn (|string| app_path, |[string]| params=[], |ProcessMode| Mode=ProcessMode.CaptureAll, |string| Name, |SpdProcess|)
			require app_path.file.mustexist
			|| pico = pico.new(name)
				rz = SpdProcess(app_path, pico, params, Mode)
				if !rz.SpawnAsChild
					rz = nil


prototype MicroProcess (|&pico| Comms, |int64| Mode, |&cstring| args, |int|)
	linkage
		cpp_part MPC
	function Spawn (|string| ThreadName,  |[string]!| R = [],  |SpdProcess|)
		
		description `This is meant to run a "main-function" from a lib, as if it were a subprocess. Its usually a wrapper around main(). Just needed this to debug speedie from within Perry.`
		
		|| c_args = SpdProcess.CreateArgs("", r)
		// its the called-threads responsibility to free the std-args received.
		// (Look at Speedie_Main in Speedie.scproj for example)
		|| pico_fn = pico.new(threadname)
			|| proc = SpdProcess(threadname, pico_fn, r, self)
			if proc.pico.SpawnThread(self|picothreadfn|, 7, c_Args)
				return proc
		// free cos we never had a chance to free it.
		memory.free(c_args)


}


// too many "function spawn" things all over the place. 6! Need to reduce them somehow?

