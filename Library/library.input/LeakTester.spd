
/*
	Jeebox internals. By Theodore H. Smith...
*/


struct LeakTester
	linkage
		cpp_part		Lk

	|int|		MemUsedStart
	|string|	Name

	function Test
		if .MemUsedStart
			|int| NewAmount = app.objmemory
			|| Diff = NewAmount - .MemUsedStart
			if Diff > 0
				"Leaked $Diff bytes in ${.Name}. New Count $NewAmount."
			.MemUsedStart = 0
		app.LeakUnMarkMemory
	
	module
		function New (|string| name, |Leaktester|)
			rz.MemUsedStart = app.objmemory
			rz.Name = name
			app.LeakMarkMemory

		function FindLeak (|object| Obj, |array| dest)
			cpp_wrapper JB_FindLeakedObject
		
		function Count
			cpp_wrapper JB_Mem__ClassLeakCounter


	
libinternal object.FindReferences
	|| r = []
	leaktester.FindLeak(self, r)
	printline r
	debugger


libinternal object.MarkRefCount (|bool| Active=true)
	cpp_wrapper JB_MarkRefCount


libinternal object.RefCountMark (|int|)
	|| S = self|&int|
	return S[] & 1


