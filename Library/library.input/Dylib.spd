
/*
	Dylib plans:
	
	OK, So I have some really good plans for a new/better dylib system.
	
	OK firstly, should we keep the "can load a lib twice" thing? it could allow loading
	multiple same spd processes as libs? Maybe intercommunicate that way? IDK. Seems more
	dangerous than exec(). Speedie isn't designed for multi-threading, and I don't
	know any other libs that are designed to be loaded twice. So get rid of that feature?

	Now, what next? So we want to handle failiures. The question is "What to do, if a lib can't be loaded".
	
	It could be that the lib is optional... it doesn't need to be used. Like a video-encoding lib,
	and we just don't allow encoding of videos if it can't be loaded. So we should keep the
	"load lib as a struct-pointer" thing? Well... we can just check .DylibIsOpen on the lib.
	
	Anyhow, the question is what to do on fail. So... lets assume the lib was loaded,
	but a function can't be loaded. So we do this.
	

dylib Curl
	cpp_func xmlReadFile (|cstring| path, |?&nil| IDK, |int| Flags,  |?&xmlDocument|)
	
	syntax DylibFail (|string| Symbol, |?&nil|)
		// So lets say Symbol == "xmlReadFile", we can do a few things.
		// 1) Try to reload the lib, actually from within here. it should work!
		// 2) Return a replacement function, perhaps from your own code or from within another lib
		// 3) Return nil, to say "i failed"
		// the replacement func can be anything. It could return a default value. Or purposefully crash.
		
		// We should give then two useful functions, to return. App.Dummy and app.Crash.
		// also we can use app.Symbol("abc") which loads a symbol out of the app itself.
		
	
	Sounds nice huh! Returning nil... isn't the end. But it could be. If we manage to load at least one
	new function, it will try again. Perhaps that function was the one needed to help load the others?
	If no new functions are loaded, it will give up.
	
	So... if we are loading a global dylib struct, well it needs to be loaded on startup. So... the
	system must prevent code from continuing, if it can't be loaded. Thats what the dylibfail is for.
	
	So... if any fail on startup, the entire process will crash. With an error about which function
	can't be loaded, from what lib.
		
...

	What if the lib itself can't be loaded? Well... we can call DylibFail, with Symbol == "". They
	can then call .DyLibInit() from within dylib fail. The verification is not done from within
	.dylibinit() so its not a recursive function. The code would look like this:
	
dylib XML
	cpp_func xmlReadFile (|cstring| path, |?&nil| IDK, |int| Flags,  |?&xmlDocument|)
	
	syntax DylibFail (|string| Symbol, |?&nil|)
		if symbol == "xmlReadFile"
			return &app.Dummy

// or this
	
	syntax DylibFail (|string| Symbol, |?&nil|)
		if !symbol
			.DyLibInit("/usr/lib/Path2") // something like this
			// this might require the function-list to be loaded into an array... which
			// should definitely be possible... it would make it more generic, and nicer!
			// or at least a string, and split it during load.



	
... // autogenerated code

function DylibCheckSub (|int|)
	if !.DylibIsOpen
		.DylibFail("")
		if !.DylibIsOpen
			return -1
	
	|| n = .DylibCount // assume n > 0, compiler verified
	|| Got = 0
	|| Missed = 0
	for i in n
		if !.DylibFuncs[i]
			|| Found = .DylibFail(.DylibSymbols[i])
				Got = 1
				.DylibSymbols[i] = Found
			  else
				Missed = 1
	return Got - Missed



function DylibCheck	(|bool|)
	while
		|| Found = .DylibCheckSub
		if Found > 0
			return true
		if Found < 0
			app.crash("Library failed to load: libXML.so")


// more autogenerated code	
// assume the dylib was loaded during init or something.
main 
	require XML.DylibCheck

...

	
	Advantages:
	
	1) A global struct, without struct pointers, gives us get faster libfunc reads
	2) We can more safely fail... returning dummies or crash functions.
	3) We aren't limiting the user to any particular response.
	4) Its not an overly restrictive design. I just give functions!
	5) I'm returning to simpler code! EG Found > 0, instead of being horribly oofish.
	
	We should also be able to rename a lib. I don't want to do libxml.xmlReadFile
	maybe just XML.ReadFile
	

dylib libXML (XML)
	path `libxml`
	cpp_func xmlReadFile (|cstring| path, |?&nil| IDK, |int| Flags,  |?&xmlDocument|)
	

	
	

	
*/




struct DynamicLibrary
	linkage
		cpp_part dylib
		cpp_class JB_Dylib
		wrapper // Commenting out this causes speedie to not compile vaguely...
				// But why?
	|?&nil|		_handle
	
	
	flag_constants
		Lazy
		Now
		Local
		Global
		NoLoad
		Default = Now + Local
		NoDelete	= 0x80
	
	inline DylibIsOpen (|bool|)
		return ._handle != nil
	
	inline IsOpen (|bool|)
		// deprecate this. Is it autogenerated? if not just remove.
		return ._handle != nil
	
	syntax access (|string| S, |?&nil|)
		cpp_wrapper JB_dylib_Load
		
	function DyLibOpen (|string?| F, |int| Mode = dynamiclibrary.Default, |bool|)
		description "Opens a dylib. Will also close the existing library (if any)."
		cpp_wrapper JB_dylib_Open
	
	function DyLibClose
		cpp_wrapper JB_dylib_Close
	
	function DyLibError (|cstring|)
		cpp_wrapper JB_dylib_Error
	
	
	// dylib paths really suck. So hard to make something nice.
	
	libinternal LocaliseLib (|string| Path, |string|)
		target osx
			return path.addext("dylib")
		
		target linux
			return path.addext("so")
		
		target win
			return path.addext("dll")
		return path
	
	
	function DyLibInit (|string--| Path, |uint| Mode, |string| Funcs, |faststring| errors=nil, |bool|)
		target osx
			|| Bases = "~/Library
/usr/local/lib
/Library
/usr/lib
/System/Library
"

		  else // linux + windows...
			|| Bases = "~/lib
~/.local/lib
/usr/local/lib
/usr/lib
/lib
"

		|| local = .LocaliseLib(path)
		for full.lines in bases
			if full
				full = full.append("/", local)
			  else
				full = local
		
			rz = .DyLibOpen(full, mode)
			if rz
				|| Curr = &._handle + 1
				for fname.lines in Funcs
					|| Fn = .SyntaxAccess(fname)
					if !fn
						rz = false
						.DyLibClose
						exit
					Curr++[] = Fn
			if rz
				exit
			if errors
				errors <~ .dyliberror




