

/*
	Jeebox internals. By Theodore H. Smith...
*/



datatype byte
	default 0

	constants
		|Byte|
		max = 255
		min = 0
	
	render
		if (!fs_in)
			return string.byte(self)
		fs_in <~ self|Byte|
		return ""
	
	function LowerCase (|Byte|)
		if .isupper
			self += 32
		return self

	function UpperCase (|Byte|)
		if .islower
			self -= 32
		return self

	 operator in (|charset| c, |bool|)
		inlined
		return c[self]

	function IsHex (|bool|)
		return .IsInt  or  .in('a', 'f')  or  .in('A', 'F')

	inline IsInt (|bool|)
		return .In('0', '9')
		
	operator eq (|byte| b, |bool|)
		self = .lowercase
		b = b.lowercase
		return self == b
	inline IsLetter (|bool|)
		return self|codepoint|.isletter
	inline IsAlphaNum (|bool|)
		return self|codepoint|.isalphanum
	inline IsWhite (|bool|) // 8388627
		|| x = (self-9)|uint|
		|| White = x <= 1
		if x == 4
			White = true
		if x == 23
			White = true
		return White

	inline IsUpper (|bool|)
		return .in('A', 'Z')
	inline IsLower (|bool|)
		return .in('a', 'z')
	inline In (|byte| a, |byte| b, |bool|)
		return (self - a)|uint| <= (b-a)|uint|
	
	iterator
		|| i = 0
		while i < self
			yield i
			++i
	
										///// Tests /////
 // Missing a jbor?
	inline Failed2 (|bool|)
		visible
		rz = self == ' ' or '\n' or '\r'



datatype int8 // aka char
	default 0
	
	constants
		|int8|
		max = 127
		min = -128
	


datatype cstring
	size 8
	linkage: cpp_class _cstring
	function Length (|int|)
		cpp_wrapper strlen
	
	function Length (|int| Maximum, |int|)
		cpp_wrapper strnlen
	
	function Copy (|string|)
		|| n = .length
			return string.copy(self|&byte|, n)
	
	function PrintLine
		cpp_wrapper puts // hehe
	
	inline Print
		print self
	
	function String (|string|)
		disabled "Do you mean .Copy or .Wrap?"
	function Str (|string|)
		disabled "Do you mean .Copy or .Wrap?"
	
	inline Wrap (|string|)
		return string.new(self)
		
	function StrCmp (|cstring| other, |int|)
		cpp_wrapper strcmp
	
	function FileName (|cstring|)
		|| c = self|&byte|
		|| b = c
		
		while c[]
			if c++[] == '/'
				b = c
		return b|cstring|
	
	syntax cast (|&byte|)
		inlined
		return self|&byte|
	
	render
		if !fs_in
			return .copy
		fs_in <~ self
	
	iterator
		|| addr = self|&byte|
		while (|| c = addr++[])
			yield c
