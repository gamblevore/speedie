
/*
	Jeebox internals. By Theodore H. Smith...
*/


prototype fpMsgRender (|Message| self, |FastString| fs)
	libinternal // shouldn't be changed, ever. jeebox should render as jeebox.
prototype fpMsgExport (|Message| self, |FastString| fs)
		

datatype Syntax (Byte)
	default nil
	linkage
		cpp_Part Syx
		numeric false // disallow implicit (syntax <--> int) conversion

	inline Translateable (|bool|)
		if self <= @Thg and self >= @tmp
			return true

	inline IsString (|bool|)
		if self >= @sstr and self <= @str
			return true

// relies on me having cleverly ordered all my syntax :> to group them up.
	inline NoChildren (|bool|)
		return self >= @Cnj	and self <= @Bin

	inline IsRel (|bool|)
		return self >= @rel and self <= @yoda

	inline IsAdj (|bool|)
		return self >= @adj and self <= @badj

	inline IsList (|bool|)
		return self >= @bra and self <= @Arr

	inline Message.Translateable (|bool|)
		return .type.Translateable
			
	operator plus (|string| m, |message|)
		inlined
		opt norefcounts
		return .msg(m)
	
	operator plus (|int64| m, |message|)
		opt norefcounts
		inlined
		cpp_Part PlusNum
		return .msg(m.render)
		
	function Name (|string|)
		Opt NoRefCounts
		if self
			|| o = .obj
				return o.name
		return "child"
	
	function FullName (|string|)
		Opt NoRefCounts
		if self
			|| o = .obj
				return o.FullName
		return "child"
	
	inline Obj (|syntaxobj|)
		return Syntax.TypeList[self|byte|&63]
	
	
	inline Msg ( |string?| name=nil, |Message| )
		return Message( nil, self, name )
	
	inline message.Msg ( |syntax| fn, |string?| name=nil, |Message| )
		real self
		return Message( self, fn, name )
	
	
	// replace with int64.msg? seems better.
	function Msg ( |int64| name, |Message| )
		disabled "Use int64.msg instead"
	
	
	module
		|SyntaxObj[64]|				TypeList
		|{SyntaxObj}|				Types = dictionary.new
		
		inline New (|string| name, |message| where=nil, |syntax|)
			return .SyntaxAccess(name, where)

		syntax access (|string| name, |message| where=nil, |syntax|)
			visible
			cpp_part AccessName
			|| obj = .Types.valuelower(name)		#expect (where, "Unknown syntax: " + name)
			return obj.id
			
//		syntax access (|int| i, |message| where=nil, |SyntaxObj|)
//			embedded // never needed?
//			visible
//			if i|uint| < –count .TypeList
//				|| obj = .TypeList[i]		#expect (where, "Unknown syntax: " + i)
//				return obj
		
		function Join (|faststring| fs_in=nil, |string| Sep=", ", |string|)
			embedded // rarely needed
			opt norefcounts
			|| fs = FastString(fs_in)
			|| i = 0
			while ++i < –count .TypeList
				|| syx = .typelist[i]
					if i > 1
						fs <~ sep
					fs <~ syx.name
			return fs.GetResult(fs_in)
				
			
			
		libinternal StdNew (|fpMsgRender| Render, |string| Name, |String| LongName, |int| ID, |Syntax|)
			opt norefcounts
			expect (ID < –count .TypeList) ("Value out of range: " + id)
			|| result = Syntaxobj.new(Render, name, ID)
			.types[name] = result
			.TypeList[ID] = result
			if (LongName)
				.types[LongName] = result
				result.FullName = LongName
			  else
				result.FullName = Name
			return ID|syntax|



class SyntaxObj
	linkage
		cpp_part Fn
	visible			true

	|fpMsgRender|			RenderAddr // shouldn't change after creation
	|fpMsgExport|			ExportAddr
	|String|				Name
	|String|				FullName
	|Syntax|				ID

	constructor (|fpMsgRender| msg, |string| name, |int| ID)
		libinternal
		.RenderAddr = msg
		.Name		= Name
		.ID			= ID|syntax|
		.ExportAddr = Message.Dummy!
	
	
	render
		if !fs_in
			return .FullName.lowercase
		fs_in.appendlower(.FullName)
	


