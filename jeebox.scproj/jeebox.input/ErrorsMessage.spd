

extend_module ErrorReceiver
	inline NewHint (|Message| node=nil, |string?| Desc=nil, |string?| path=nil)
		.NewErrorSub(node, desc, path, ErrorSeverity.Hint)

	inline NewWarning (|Message| node=nil, |string?| Desc=nil, |string?| path=nil)
		.NewErrorSub(node, desc, path, ErrorSeverity.warning)
	
	inline NewProblem (|Message| node=nil, |string?| Desc=nil, |string?| path=nil)
		.NewErrorSub(node, desc, path, ErrorSeverity.problem)

	inline NewError (|Message| node=nil, |string?| Desc=nil, |string?| path=nil)
		.NewErrorSub(node, desc, path, ErrorSeverity.Error)

	inline NewCritical (|Message| node=nil, |string?| Desc=nil, |string?| path=nil)
		.NewErrorSub(node, desc, path, ErrorSeverity.Critical)

	autogen ExecuteError (|string| Path, |string| Desc, |ProcessMode| Mode)
		visible
		|errorreceiver--| Rec = StdErr
		|| Sev = rec.CanAddMore							#require
		
		if Mode isnt StdErrSpeedie						// its a speedie error! Lets try to parse!
			return .NewErrorSub(nil, desc, path, sev)
		
		|| Errs = desc.parse
		if !errs // oof. So we made an error while trying to make an error? that will be a pain to handle
			|error--| last = rec.LastError
				last.Severity = ErrorSeverity.Problem
			.newerror(nil, desc, path)
			return
		
		|message--| s = errs.first
		while s
			if (s == @tmp and "error") and rec.CanAddMore(sev)
				|error--| err = s.DecodeSpeedieError  
				rec <~ err
			s++


	
	autogen NewErrorSub (|Message| node, |string?| Desc, |string?| path, |errorseverity| sev)
		opt norefcounts
		|| Rec = StdErr
		if sev < ErrorSeverity.Critical // keep criticals...
			|| Lower = rec.LowerErrorsTo
				sev = lower|int| min sev
		if rec.CanAddMore(sev)
			if !desc
				desc = node.MiniName("Unexpected ")
			if path == nil
				path = ""
			rec <~ Error(node.FindNotInserted, desc, sev, path)



function message.DecodeSpeedieError (|error|)
	opt norefcounts
	rz = error(nil|message|)
	|| arg = .Last
	if arg == @arg
		rz.position = arg["pos"].int|int|
		rz.path	= arg["file"].value
		rz.severity = arg["severity"].int|errorseverity|
		rz.name	= arg[@str].name
	  else
		rz.name = .name
		rz.path = ""



function Message.OriginalFilePath (|string|)
	Opt NoRefCounts
	|| O = .memorylayer.obj
	if O isa String
		return O


function Message.OriginalParseData (|string|)
	Opt NoRefCounts
	if self
		|| D = .memorylayer.obj2
		if D isa string
			return D


extend_module Error
	function CantParseNum (|Message| Where, |string| num, |int| Pos, |bool| Overflow)
		visible							// for lib
		
/		|| fs = FastString()
		if Overflow
			fs <~ "Overflowing number"
		  else
			fs <~ "Invalid number (found '"
			fs.AppendRange(num, pos, pos+1)
			fs <~ "')"
		fs <~ " in: "
		fs <~ num.Preview(32)
		
		|string--| str = fs.GetResult
		if where and parser.running
			Parser.erroradd(str, pos + where.position )
		  else
			|error--| err = error(where, str)
			nil|errorreceiver| <~ err


